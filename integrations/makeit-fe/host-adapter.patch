+/**
+ * FE-owned product-meaning provider export (ADR 0118).
+ *
+ * The private standalone correctness toolkit must not vendor, shim or
+ * reimplement the product meaning core. Instead it loads exactly this narrow,
+ * versioned module from the explicit, validated `--app-root` during Diagnostic
+ * preflight. This file is the FE-owned product export surface: it republishes
+ * the four real functions of the single `normalizedMeaningCore` implementation
+ * under the contract the toolkit validates.
+ *
+ * It introduces no new meaning logic. `schemaVersion` and `profileId` are the
+ * closed contract identity the toolkit's provider contract declares, and match
+ * the core's own `NORMALIZED_MEANING_SCHEMA_VERSION` /
+ * `NORMALIZED_MEANING_PROFILE_ID` (`artwork-product-meaning-v1`).
+ *
+ * The relative `../virtualCanvasLayout` import in the core and the core's
+ * type-only store import keep this Node/`tsx`-loadable from an explicit app
+ * root with no application path alias. The `.mjs` specifier is intentional:
+ * the toolkit loader imports this entry as a plain file URL, and the `tsx`
+ * runtime compiles the relative `.ts` core it points at.
+ */
+import {
+  NORMALIZED_MEANING_PROFILE_ID,
+  NORMALIZED_MEANING_SCHEMA_VERSION,
+  canonicalizeNormalizedMeaning,
+  extractRawCrosswordSemanticPayload,
+  fingerprintNormalizedMeaning,
+  normalizeArtworkProductMeaning,
+} from './normalizedMeaningCore.ts';
+import { artworkVerificationHostCompatibility } from './hostCompatibility.ts';
+
+/**
+ * Closed contract schema version of the product-meaning provider (ADR 0118).
+ * Derived from the core so the toolkit contract identity and the product
+ * meaning can never drift apart.
+ */
+export const PRODUCT_MEANING_PROVIDER_SCHEMA_VERSION = NORMALIZED_MEANING_SCHEMA_VERSION;
+
+/** Stable profile identity the toolkit binds for `artwork-product-meaning-v1`. */
+export const PRODUCT_MEANING_PROVIDER_PROFILE_ID = NORMALIZED_MEANING_PROFILE_ID;
+
+/**
+ * The FE-owned provider the toolkit injects into the meaning-dependent
+ * executors. Every function is the real core implementation, passed through
+ * by reference — never a wrapper, adapter or fallback.
+ */
+export const productMeaningProvider = Object.freeze({
+  schemaVersion: PRODUCT_MEANING_PROVIDER_SCHEMA_VERSION,
+  profileId: PRODUCT_MEANING_PROVIDER_PROFILE_ID,
+  hostCompatibility: artworkVerificationHostCompatibility,
+  normalizeArtworkProductMeaning,
+  canonicalizeNormalizedMeaning,
+  fingerprintNormalizedMeaning,
+  extractRawCrosswordSemanticPayload,
+});
