+export type ArtworkVerificationMethod = (typeof ARTWORK_VERIFICATION_READ_ONLY_METHODS)[number];
+
+export type ArtworkVerificationKind =
+  | 'layout'
+  | 'text'
+  | 'image'
+  | 'vector'
+  | 'starmap'
+  | 'crossword'
+  | 'object';
+
+export interface ArtworkVerificationElement {
+  id: string;
+  kind: ArtworkVerificationKind;
+  type: SceneNodeType;
+  name: string | null;
+  parentId: string | null;
+  children: string[];
+  hidden: boolean;
+  locked: boolean;
+  mounted: boolean;
+  selected: boolean;
