@@ -0,0 +1,36 @@
+'use client';
+
+import { useEffect } from 'react';
+
+/**
+ * Mount the gated, one-shot setup seam for the verification runtime.
+ *
+ * The setup module is dynamically imported only inside the explicit
+ * non-production gate. This keeps every setup marker and mutable constructor
+ * unreachable from production output even when a hostile production build sets
+ * NEXT_PUBLIC_ARTWORK_VERIFICATION=true.
+ */
+export function useArtworkVerificationSeams(): void {
+  useEffect(() => {
+    if (
+      process.env.NODE_ENV === 'production' ||
+      process.env.NEXT_PUBLIC_ARTWORK_VERIFICATION !== 'true'
+    ) {
+      return;
+    }
+
+    let cancelled = false;
+    let cleanup: (() => void) | undefined;
+    void import('@/lib/artwork/verification/artworkSetupBoundary').then(
+      ({ installArtworkSetupBoundary }) => {
+        if (cancelled) return;
+        cleanup = installArtworkSetupBoundary();
+      },
+    );
+
+    return () => {
+      cancelled = true;
+      cleanup?.();
+    };
+  }, []);
+}
