+  if (extra.length > 0) {
+    return { ok: false, field: 'inputs', detail: `Unknown input keys: ${extra.join(', ')}.` };
+  }
+  return { ok: true, value: {} };
+}
+
+function buildNestedObjectNegativeFixture(_input: Record<string, never>): ArtworkEditorSnapshot {
+  return buildNestedObjectNegativeFixtureSnapshot();
+}
+
+const NESTED_OBJECT_NORMALIZATION_NEGATIVE_CONSTRUCTOR: ArtworkSetupConstructorDefinition = {
+  id: ARTWORK_SETUP_NEGATIVE_NORMALIZATION_CONSTRUCTOR_ID,
+  version: ARTWORK_SETUP_NEGATIVE_NORMALIZATION_CONSTRUCTOR_VERSION,
+  fixtureId: ARTWORK_SETUP_NEGATIVE_NORMALIZATION_FIXTURE_ID,
+  fixtureVersion: ARTWORK_SETUP_NEGATIVE_NORMALIZATION_FIXTURE_VERSION,
+  inputKeys: [],
+  validate:
+    validateNestedObjectNegativeInput as unknown as ArtworkSetupConstructorDefinition['validate'],
+  build: buildNestedObjectNegativeFixture as unknown as ArtworkSetupConstructorDefinition['build'],
+  certify: certifyNegativeNestedObjectNormalization,
+};
+
+const NESTED_OBJECT_CONSTRUCTOR: ArtworkSetupConstructorDefinition = {
+  id: 'artwork.nested-object.v2',
+  version: 2,
+  fixtureId: 'artwork.fixture.nested-object',
+  fixtureVersion: 2,
+  inputKeys: ['artworkWidth', 'artworkHeight', 'activeLayout', 'controlLayout'],
+  validate: validateNestedObjectInput as unknown as ArtworkSetupConstructorDefinition['validate'],
+  build: buildNestedObjectFixture as unknown as ArtworkSetupConstructorDefinition['build'],
+  certify: certifyNestedObjectNormalization,
+};
+
+const ARTWORK_SETUP_CONSTRUCTOR_REGISTRY: readonly ArtworkSetupConstructorDefinition[] = [
+  TWO_LAYOUT_TEXT_CONSTRUCTOR,
+  TWO_LAYOUT_TEXT_CONSTRUCTOR_V2,
+  TWO_LAYOUT_IMAGE_CONSTRUCTOR,
+  NESTED_OBJECT_CONSTRUCTOR,
+  NESTED_OBJECT_NORMALIZATION_NEGATIVE_CONSTRUCTOR,
+];
+
+/** Published registry projection: what a request may select, and nothing else. */
+export function listArtworkSetupConstructors(): ArtworkSetupConstructorDeclaration[] {
+  return ARTWORK_SETUP_CONSTRUCTOR_REGISTRY.map((entry) => ({
+    id: entry.id,
+    version: entry.version,
+    fixtureId: entry.fixtureId,
+    fixtureVersion: entry.fixtureVersion,
+  }));
+}
+
+function findArtworkSetupConstructor(id: string): ArtworkSetupConstructorDefinition | undefined {
+  return ARTWORK_SETUP_CONSTRUCTOR_REGISTRY.find((entry) => entry.id === id);
+}
+
+// ── Request and authorization validation ─────────────────────────────────────
+
+const MAX_SCOPE_VALUE_LENGTH = 128;
+const AUTHORIZATION_TOKEN_PATTERN = /^[0-9a-f]{64}$/;
+
+function validateScopeValue(value: unknown, field: string): ValidationResult<string> {
+  if (typeof value !== 'string' || value.length === 0 || value.length > MAX_SCOPE_VALUE_LENGTH) {
+    return {
+      ok: false,
+      field,
+      detail: `${field} must be a 1-${MAX_SCOPE_VALUE_LENGTH} character string.`,
+    };
+  }
+  return { ok: true, value };
+}
+
+function validateRequest(raw: unknown): ValidationResult<ArtworkSetupConstructRequest> {
+  if (!isPlainRecord(raw)) {
+    return { ok: false, field: 'request', detail: 'request must be an object.' };
+  }
+  const extra = unknownKeys(raw, ['constructorId', 'constructorVersion', 'scope', 'inputs']);
+  if (extra.length > 0) {
+    return { ok: false, field: 'request', detail: `Unknown request keys: ${extra.join(', ')}.` };
+  }
+  if (
+    typeof raw.constructorId !== 'string' ||
+    !/^[a-z0-9][a-z0-9.-]{0,63}$/.test(raw.constructorId)
+  ) {
+    return { ok: false, field: 'constructorId', detail: 'constructorId must be a versioned slug.' };
+  }
+  if (
+    typeof raw.constructorVersion !== 'number' ||
+    !Number.isInteger(raw.constructorVersion) ||
+    raw.constructorVersion < 1
+  ) {
+    return {
+      ok: false,
+      field: 'constructorVersion',
+      detail: 'constructorVersion must be a positive integer.',
+    };
+  }
+  if (!isPlainRecord(raw.scope)) {
+    return { ok: false, field: 'scope', detail: 'scope must be an object.' };
+  }
+  const scopeExtra = unknownKeys(raw.scope, ['runId', 'caseId']);
+  if (scopeExtra.length > 0) {
+    return { ok: false, field: 'scope', detail: `Unknown scope keys: ${scopeExtra.join(', ')}.` };
+  }
+  const runId = validateScopeValue(raw.scope.runId, 'scope.runId');
+  if (!runId.ok) return runId;
+  const caseId = validateScopeValue(raw.scope.caseId, 'scope.caseId');
+  if (!caseId.ok) return caseId;
+  if (!isPlainRecord(raw.inputs)) {
+    return { ok: false, field: 'inputs', detail: 'inputs must be an object.' };
+  }
+  return {
+    ok: true,
+    value: {
+      constructorId: raw.constructorId,
+      constructorVersion: raw.constructorVersion,
+      scope: { runId: runId.value, caseId: caseId.value },
+      inputs: raw.inputs,
+    },
+  };
+}
+
+function readAuthorizationCandidate(value: unknown): ArtworkSetupAuthorization | null {
+  if (!isPlainRecord(value)) return null;
+  if (typeof value.authorizationId !== 'string' || value.authorizationId.length === 0) return null;
+  if (value.authorizationId.length > MAX_SCOPE_VALUE_LENGTH) return null;
+  if (typeof value.token !== 'string' || !AUTHORIZATION_TOKEN_PATTERN.test(value.token))
+    return null;
+  if (!isPlainRecord(value.scope)) return null;
+  const runId = validateScopeValue(value.scope.runId, 'runId');
+  if (!runId.ok) return null;
+  const caseId = validateScopeValue(value.scope.caseId, 'caseId');
+  if (!caseId.ok) return null;
+  if (typeof value.origin !== 'string' || value.origin.length === 0) return null;
+  if (typeof value.documentId !== 'string' || value.documentId.length === 0) return null;
+  return {
+    authorizationId: value.authorizationId,
+    token: value.token,
+    scope: { runId: runId.value, caseId: caseId.value },
+    origin: value.origin,
+    documentId: value.documentId,
+  };
+}
+
+// ── Boundary ─────────────────────────────────────────────────────────────────
+
+const MAX_REFUSALS = 16;
+
+function nowIso(now: () => number): string {
+  return new Date(now()).toISOString();
+}
+
+/** Mutable one-shot lifecycle facts, owned by the browser-Document anchor. */
+export interface ArtworkSetupLifecycleSnapshot {
+  lifecycle: ArtworkSetupBoundaryState;
+  lifecycleTrace: ArtworkSetupBoundaryState[];
+  constructAttempted: boolean;
+  authorizationConsumed: boolean;
+  sealRecord: ArtworkSetupSealRecord | null;
+  refusals: ArtworkSetupRefusal[];
+}
+
+/**
+ * The browser-Document-scoped one-shot anchor: exactly one per browser Document,
+ * separate from the authorization broker slot and from the observation bridge's
+ * document-identity anchor. It holds the mutable lifecycle state and the one
+ * canonical frozen surface, and it never holds the raw capability — the broker
+ * slot does, and it is consumed and deleted on the first attempt.
+ *
+ * Every install in one Document returns this same `surface`, so a remount
+ * (including a React StrictMode install→cleanup→install) can neither reset
+ * `constructAttempted`, lifecycle, refusal history, or seal record, nor create a
+ * second callable capable of mutation. `installCount` is the ownership
+ * reference count; cleanup never erases the anchor itself.
+ */
+export interface ArtworkSetupDocumentAnchor {
+  readonly surface: ArtworkSetupSurface;
+  readonly state: ArtworkSetupLifecycleSnapshot;
+  installCount: number;
+}
+
+function createArtworkSetupDocumentAnchor(): ArtworkSetupDocumentAnchor {
+  const now = () => Date.now();
+  const state: ArtworkSetupLifecycleSnapshot = {
+    lifecycle: 'SETUP_OPEN',
+    lifecycleTrace: ['SETUP_OPEN'],
+    constructAttempted: false,
+    authorizationConsumed: false,
+    sealRecord: null,
+    refusals: [],
+  };
+
+  const brokerSlot = window as unknown as Record<symbol, unknown>;
+
+  function enterState(next: ArtworkSetupBoundaryState): void {
+    state.lifecycle = next;
+    if (state.lifecycleTrace[state.lifecycleTrace.length - 1] !== next) {
+      state.lifecycleTrace.push(next);
+    }
+  }
+
+  function refuse(
+    code: ArtworkSetupRefusalCode,
+    detail: string,
+    context: Record<string, string>,
+    mutationApplied: boolean,
+  ): ArtworkSetupRefusal {
+    const record: ArtworkSetupRefusal = {
+      ok: false,
+      outcome: 'refused',
+      code,
+      detail,
+      context,
+      mutationApplied,
+      authorizationConsumed: state.authorizationConsumed,
+      lifecycle: state.lifecycle,
+      at: nowIso(now),
+    };
+    state.refusals.push(record);
+    if (state.refusals.length > MAX_REFUSALS) state.refusals.shift();
+    return record;
+  }
+
+  function canConstruct(): boolean {
+    return state.lifecycle === 'SETUP_OPEN';
+  }
+
+  function construct(rawRequest: unknown): ArtworkSetupConstructResult {
+    if (!canConstruct()) {
+      return refuse(
+        'SETUP_ALREADY_SEALED',
+        'The one-shot setup boundary for this browser Document is already sealed.',
+        { lifecycle: state.lifecycle },
+        false,
+      );
+    }
+    // One-shot: this attempt ends the SETUP_OPEN phase for this Document,
+    // whatever its outcome, so no caller can retry until a contract passes.
+    state.constructAttempted = true;
+    // Any refusal ends the SETUP_OPEN phase, so the recorded refusal reports the
+    // post-attempt lifecycle rather than the phase it was attempted in.
+    const finish = (
+      code: ArtworkSetupRefusalCode,
+      detail: string,
+      context: Record<string, string>,
+      mutationApplied: boolean,
+    ): ArtworkSetupRefusal => {
+      enterState('SEALED');
+      return refuse(code, detail, context, mutationApplied);
+    };
+
+    // The authorization channel is one-shot with the construct attempt, not
+    // with successful request validation. Consume it before every other
+    // check so an early gate/route/request refusal cannot leave a raw
+    // capability pending in this realm.
+    const broker = brokerSlot[ARTWORK_SETUP_BROKER_KEY] as { take?: unknown } | null | undefined;
+    const take = broker?.take;
+    if (typeof take !== 'function') {
+      return finish(
+        'SETUP_AUTHORIZATION_MISSING',
+        'No setup authorization was delivered to this browser Document.',
+        {},
+        false,
+      );
+    }
+    let candidate: unknown;
+    try {
+      candidate = (take as () => unknown).call(broker);
+    } catch {
+      candidate = null;
+    }
+    const brokerCleared = Reflect.deleteProperty(brokerSlot, ARTWORK_SETUP_BROKER_KEY);
+    const authorization = readAuthorizationCandidate(candidate);
+    state.authorizationConsumed = authorization !== null;
+    if (!brokerCleared) {
+      return finish(
+        'SETUP_AUTHORIZATION_INVALID',
+        'The setup authorization channel could not be cleared safely.',
+        {},
+        false,
+      );
+    }
+    if (!authorization) {
+      return finish(
+        'SETUP_AUTHORIZATION_INVALID',
+        'The delivered setup authorization is malformed.',
+        {},
+        false,
+      );
+    }
+
+    if (!isArtworkSetupEnabled()) {
+      return finish('SETUP_GATE_DISABLED', 'The setup seam gate is not enabled.', {}, false);
+    }
+
+    const environment = observeEnvironment();
+    const address = resolveArtworkVerificationDocumentAddress();
+    if (environment.route !== ARTWORK_SETUP_ROUTE) {
+      return finish(
+        'SETUP_ROUTE_INVALID',
+        `The setup seam is available only on ${ARTWORK_SETUP_ROUTE}.`,
+        { route: environment.route },
+        false,
+      );
+    }
+
+    const parsed = validateRequest(rawRequest);
+    if (!parsed.ok) {
+      return finish('SETUP_REQUEST_INVALID', parsed.detail, { field: parsed.field }, false);
+    }
+    const request = parsed.value;
+
+    const dimension: ArtworkSetupScopeDimension | null =
+      request.scope.runId !== authorization.scope.runId
+        ? 'run'
+        : request.scope.caseId !== authorization.scope.caseId
+          ? 'case'
+          : authorization.documentId !== address.documentId
+            ? 'document'
+            : authorization.origin !== environment.origin
+              ? 'origin'
+              : null;
+    if (dimension !== null) {
+      return finish(
+        'SETUP_SCOPE_MISMATCH',
+        `Setup authorization does not cover the requested ${dimension} scope.`,
+        { dimension },
+        false,
+      );
+    }
+
+    const definition = findArtworkSetupConstructor(request.constructorId);
+    if (!definition) {
+      return finish(
+        'SETUP_CONSTRUCTOR_UNKNOWN',
+        `No setup constructor ${request.constructorId} is registered.`,
+        { constructorId: request.constructorId },
+        false,
+      );
+    }
+    if (definition.version !== request.constructorVersion) {
+      return finish(
+        'SETUP_CONSTRUCTOR_VERSION_MISMATCH',
+        `Setup constructor ${request.constructorId} is version ${definition.version}, not ${request.constructorVersion}.`,
+        {
+          constructorId: request.constructorId,
+          expectedVersion: String(definition.version),
+          requestedVersion: String(request.constructorVersion),
+        },
+        false,
+      );
+    }
+
+    const validatedInput = definition.validate(request.inputs);
+    if (!validatedInput.ok) {
+      return finish(
+        'SETUP_INPUT_INVALID',
+        validatedInput.detail,
+        { field: validatedInput.field, constructorId: definition.id },
+        false,
+      );
+    }
+
+    const snapshot = (() => {
+      try {
+        return definition.build(validatedInput.value);
+      } catch (error) {
+        if (error instanceof ArtworkObjectFactoryError) {
+          return {
+            refusal: {
+              field: error.field,
+              detail: error.message,
+              reason: error.reason,
+            },
+          };
+        }
+        throw error;
+      }
+    })();
+    if ('refusal' in snapshot) {
+      return finish(
+        'SETUP_INPUT_INVALID',
+        snapshot.refusal.detail,
+        {
+          field: snapshot.refusal.field,
+          constructorId: definition.id,
+          factoryReason: snapshot.refusal.reason,
+        },
+        false,
+      );
+    }
+    // The pre-hydration product-normalization certificate (ADR 0015 B4) runs
+    // before hydrate() on every constructor that declares it. A failure refuses
+    // with mutationApplied:false, launchAttempted may remain true, and no native
+    // pointer dispatch or store mutation is permitted.
+    const certification = definition.certify?.(snapshot);
+    if (certification && !certification.ok) {
+      const refused = finish(
+        'FIXTURE_NOT_NORMALIZED',
+        certification.detail,
+        { constructorId: definition.id, reason: certification.reason },
+        false,
+      );
+      // ADR 0016 R5/R7: a dedicated negative refusal publishes the closed
+      // pre-hydration projection. Only a negative-wrapper refusal that reached
+      // its evaluation carries evidence; every other certificate refusal keeps
+      // the existing shape.
+      if (certification.evidence) {
+        refused.normalizationRefusal = {
+          phase: 'pre-hydration',
+          code: 'FIXTURE_NOT_NORMALIZED',
+          reason: certification.reason,
+          constructorId: definition.id,
+          constructorVersion: definition.version,
+          fixtureId: definition.fixtureId,
+          fixtureVersion: definition.fixtureVersion,
+          ...certification.evidence,
+          mutationApplied: false,
+          authorizationConsumed: true,
+          lifecycle: 'SEALED',
+          sealCreated: false,
+          constructAttemptCount: 1,
+          hydrateCallCount: 0,
+          storeMutationCount: 0,
+        };
+      }
+      return refused;
+    }
+    const normalizationCertificate = certification?.ok ? certification.certificate : null;
+    const expectedContentFingerprint = fingerprintArtworkSetupValue(snapshot.layoutItems);
+    let hydrateFailure: string | null = null;
+    try {
+      hydrateBaseline(snapshot);
+    } catch (error) {
+      hydrateFailure = `Published store hydrate() rejected the fixture: ${(error as Error).message}`;
+    }
+    if (hydrateFailure === null) {
+      const applied = observeProductState();
+      if (fingerprintArtworkSetupValue(applied.layoutItems) !== expectedContentFingerprint) {
+        hydrateFailure =
+          'Constructed fixture content did not become the published store content state.';
+      } else if (applied.historyPastDepth !== 0 || applied.historyFutureDepth !== 0) {
+        hydrateFailure = 'Constructed fixture did not establish a clean history baseline.';
+      }
+    }
+    if (hydrateFailure !== null) {
+      enterState('SETUP_COMPLETE');
+      return finish(
+        'SETUP_HYDRATE_REJECTED',
+        hydrateFailure,
+        { constructorId: definition.id },
+        true,
+      );
+    }
+
+    const observed = observeProductState();
+    enterState('SETUP_COMPLETE');
+    const layoutCount = observed.rootIds.length;
+    const layerCount = observed.layoutItems.reduce(
+      (total, item) => total + (item.layers?.length ?? 0),
+      0,
+    );
+    const storeState = useArtworkEditorStore.getState();
+    const sealedRecord: ArtworkSetupSealRecord = Object.freeze({
+      schemaVersion: ARTWORK_SETUP_SEAL_SCHEMA_VERSION,
+      boundaryVersion: ARTWORK_SETUP_BOUNDARY_VERSION,
+      outcome: 'constructed' as const,
+      route: environment.route,
+      origin: environment.origin,
+      authorization: { id: authorization.authorizationId, consumed: true as const },
+      scope: { ...authorization.scope },
+      document: { documentId: address.documentId, documentEpoch: address.documentEpoch },
+      constructor: {
+        id: definition.id,
+        version: definition.version,
+        fixtureId: definition.fixtureId,
+        fixtureVersion: definition.fixtureVersion,
+      },
+      fingerprints: {
+        algorithm: ARTWORK_SETUP_FINGERPRINT_ALGORITHM,
+        content: expectedContentFingerprint,
+        layoutItems: fingerprintArtworkSetupValue(observed.layoutItems),
+      },
+      environmentFingerprint: fingerprintArtworkSetupValue(environment),
+      semanticPrecondition: {
+        layoutCount,
+        layerCount,
+        nodeCount: observed.nodeCount,
+        activeLayoutId: storeState.activeLayoutId,
+        selectedLayoutIds: [...storeState.selectedLayoutIds],
+      },
+      historyBaseline: {
+        pastDepth: observed.historyPastDepth,
+        futureDepth: observed.historyFutureDepth,
+        baselineClean: observed.historyPastDepth === 0 && observed.historyFutureDepth === 0,
+      },
+      normalizationCertificate,
+      mutationSummary: { constructCalls: 1 as const, hydrateCalls: 1 as const },
+      sealedAt: nowIso(now),
+      sealedAtEpochMs: now(),
+    });
+    state.sealRecord = sealedRecord;
+    enterState('SEALED');
+
+    return {
+      ok: true,
+      outcome: 'constructed',
+      lifecycle: 'SEALED',
+      sealRecord: sealedRecord,
+    };
+  }
+
+  const surface: ArtworkSetupSurface = Object.freeze({
+    version: ARTWORK_SETUP_BOUNDARY_VERSION,
+    globalName: ARTWORK_SETUP_GLOBAL_NAME,
+    status: (): ArtworkSetupStatusFacts => {
+      const environment = observeEnvironment();
+      const address = resolveArtworkVerificationDocumentAddress();
+      const observed = observeProductState();
+      const authorization = state.authorizationConsumed
+        ? 'consumed'
+        : brokerSlot[ARTWORK_SETUP_BROKER_KEY]
+          ? 'available'
+          : 'absent';
+      return {
+        boundaryVersion: ARTWORK_SETUP_BOUNDARY_VERSION,
+        sealSchemaVersion: ARTWORK_SETUP_SEAL_SCHEMA_VERSION,
+        globalName: ARTWORK_SETUP_GLOBAL_NAME,
+        route: environment.route,
+        routeAllowed: environment.route === ARTWORK_SETUP_ROUTE,
+        document: { documentId: address.documentId, documentEpoch: address.documentEpoch },
+        lifecycle: state.lifecycle,
+        lifecycleTrace: [...state.lifecycleTrace],
+        constructAttempted: state.constructAttempted,
+        sealed: state.lifecycle === 'SEALED',
+        authorization,
+        historyBaselineClean: observed.historyPastDepth === 0 && observed.historyFutureDepth === 0,
+        environment,
+        environmentFingerprint: fingerprintArtworkSetupValue(environment),
+      };
+    },
+    sealRecord: () => state.sealRecord,
+    refusals: () => state.refusals.map((entry) => ({ ...entry, context: { ...entry.context } })),
+    construct,
+  });
+
+  return { surface, state, installCount: 0 };
+}
+
+function resolveArtworkSetupDocumentAnchor(): ArtworkSetupDocumentAnchor {
+  const host = window as unknown as Record<symbol, unknown>;
+  const existing = host[ARTWORK_SETUP_ANCHOR_KEY] as ArtworkSetupDocumentAnchor | undefined;
+  if (existing) return existing;
+  const anchor = createArtworkSetupDocumentAnchor();
+  Object.defineProperty(host, ARTWORK_SETUP_ANCHOR_KEY, {
+    value: anchor,
+    enumerable: false,
+    configurable: true,
+    writable: true,
+  });
+  return anchor;
+}
+
+/**
+ * Installs the gated setup boundary on the current browser Document and returns
+ * the cleanup that releases exactly this installation.
+ *
+ * The lifecycle state and the canonical surface live on the Document anchor, so
+ * every install in one Document — the first mount, a StrictMode
+ * install→cleanup→install, or two concurrent installs — exposes the same
+ * one-shot boundary and the same single callable. Cleanup is reference-counted
+ * and identity-checked: it never deletes another live install's global, and it
+ * never erases the anchor, so a consumed/sealed Document stays consumed/sealed
+ * across unmount/remount. A reload or new Document gets a fresh anchor and,
+ * because the harness broker is not re-delivered, still has no authorization.
+ */
+export function installArtworkSetupBoundary(): () => void {
+  if (!isArtworkSetupEnabled()) return () => {};
+  if (liveRouteDocumentKey() !== ARTWORK_SETUP_ROUTE) return () => {};
+  if (typeof window === 'undefined') return () => {};
+
+  const anchor = resolveArtworkSetupDocumentAnchor();
+  anchor.installCount += 1;
+  window.__MAKEIT_ARTWORK_SETUP__ = anchor.surface;
+
+  let released = false;
+  return () => {
+    if (released) return;
+    released = true;
+    anchor.installCount = Math.max(0, anchor.installCount - 1);
+    if (anchor.installCount === 0 && window.__MAKEIT_ARTWORK_SETUP__ === anchor.surface) {
+      delete window.__MAKEIT_ARTWORK_SETUP__;
+    }
+  };
+}
