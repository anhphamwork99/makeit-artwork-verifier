+};
+
+describe('artworkVerificationBridge', () => {
+  afterEach(() => {
+    vi.unstubAllEnvs();
+  });
+
+  it('stays disabled in production even when the public flag is set', () => {
+    vi.stubEnv('NODE_ENV', 'production');
+    vi.stubEnv('NEXT_PUBLIC_ARTWORK_VERIFICATION', 'true');
+
+    expect(isArtworkVerificationEnabled()).toBe(false);
+  });
+
+  it('requires the explicit public flag outside production', () => {
+    vi.stubEnv('NODE_ENV', 'development');
+    vi.stubEnv('NEXT_PUBLIC_ARTWORK_VERIFICATION', 'false');
+    expect(isArtworkVerificationEnabled()).toBe(false);
+
+    vi.stubEnv('NEXT_PUBLIC_ARTWORK_VERIFICATION', 'true');
+    expect(isArtworkVerificationEnabled()).toBe(true);
+  });
+
+  it('resolves semantic filters independently of generated ids', () => {
+    const result = filterArtworkVerificationElements(
+      nodes,
+      new Set(['layout-1', 'text-1']),
