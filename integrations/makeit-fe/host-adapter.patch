+// ── Typed nested-object geometry v3 (bridge v6, ADR 0013 R4–R8) ──────────────
+
+/** R8 semantic-hit candidate order: center, then quarter points clockwise. */
+const NESTED_HIT_CANDIDATE_UVS = [
+  { label: 'center', u: 0.5, v: 0.5 },
+  { label: 'upper-right', u: 0.75, v: 0.25 },
+  { label: 'lower-right', u: 0.75, v: 0.75 },
+  { label: 'lower-left', u: 0.25, v: 0.75 },
+  { label: 'upper-left', u: 0.25, v: 0.25 },
+] as const;
+
+const NESTED_HIT_INSET_CSS_PX = 4;
+const NESTED_SELECTION_CHROME_NAME = 'artwork-chrome';
+const NESTED_TRANSFORM_CONTROL_PATTERN = /rotate|resize|transform|handle|handle-|_handle/i;
+
+function safeHitNodeClass(hit: Konva.Node | null): SafeHitNodeClass {
+  if (hit === null) return null;
+  const className = (() => {
+    try {
+      return hit.getClassName();
+    } catch {
+      return '';
+    }
+  })();
+  if (
+    className === 'Rect' ||
+    className === 'Circle' ||
+    className === 'Group' ||
+    className === 'Transformer'
+  ) {
+    return className;
+  }
+  return 'Other';
+}
+
+function safeNodeName(node: Konva.Node): string {
+  try {
+    return node.name() ?? '';
+  } catch {
+    return '';
+  }
+}
+
+function safeNodeClass(node: Konva.Node): string {
+  try {
+    return node.getClassName();
+  } catch {
+    return '';
+  }
+}
+
+function safeParent(node: Konva.Node): Konva.Node | null {
+  try {
+    return node.getParent();
+  } catch {
+    return null;
+  }
+}
+
+interface NestedHitAncestry {
+  selectionChrome: boolean;
+  transformChrome: boolean;
+  owned: boolean;
+}
+
+/**
+ * Walks the live hit ancestry up to the target, classifying static selection
+ * chrome (`artwork-chrome`), other transform-control chrome, and target
+ * ownership. The statically named `artwork-chrome` ancestor is checked exactly;
+ * the broad permissive name heuristic of the pre-repair code is gone.
+ */
+function classifyNestedHitAncestry(hit: Konva.Node, targetNode: Konva.Node): NestedHitAncestry {
+  let current: Konva.Node | null = hit;
+  let selectionChrome = false;
+  let transformChrome = false;
+  let owned = false;
+  while (current) {
+    if (current === targetNode) {
+      owned = true;
+      break;
+    }
+    const name = safeNodeName(current);
+    const className = safeNodeClass(current);
+    if (name === NESTED_SELECTION_CHROME_NAME) {
+      selectionChrome = true;
+    } else if (className === 'Transformer' || NESTED_TRANSFORM_CONTROL_PATTERN.test(name)) {
+      transformChrome = true;
+    }
+    const parent = safeParent(current);
+    if (parent === null) break;
+    if (parent === targetNode) {
+      owned = true;
+      break;
+    }
+    current = parent;
+  }
+  return { selectionChrome, transformChrome, owned };
+}
+
+interface NestedPostClassification {
+  classification: NestedPostHitClassification;
+  descriptor: SafeHitDescriptor;
+}
+
+/** Classification precedence exactly as ADR 0014 R6 requires. */
+function classifyNestedPostHit(
+  hit: Konva.Node | null,
+  targetNode: Konva.Node,
+): NestedPostClassification {
+  if (hit === null) {
+    return {
+      classification: 'no-hit',
+      descriptor: { nodeClass: null, chromeName: null, ownedByTarget: false },
+    };
+  }
+  const nodeClass = safeHitNodeClass(hit);
+  const ancestry = classifyNestedHitAncestry(hit, targetNode);
+  if (ancestry.selectionChrome) {
+    return {
+      classification: 'selection-chrome',
+      descriptor: { nodeClass, chromeName: 'artwork-chrome', ownedByTarget: ancestry.owned },
+    };
+  }
+  if (ancestry.transformChrome) {
+    return {
+      classification: 'transform-chrome',
+      descriptor: { nodeClass, chromeName: null, ownedByTarget: ancestry.owned },
+    };
+  }
+  if (ancestry.owned) {
+    return {
+      classification: hit === targetNode ? 'target' : 'owned-non-chrome-descendant',
+      descriptor: { nodeClass, chromeName: null, ownedByTarget: true },
+    };
+  }
+  return {
+    classification: 'foreign-listening-node',
+    descriptor: { nodeClass, chromeName: null, ownedByTarget: false },
+  };
+}
+
+interface NestedChainContext {
+  chain: readonly NestedObjectFrameFacts[];
+}
+
+type NestedChainResult =
+  | { ok: true; context: NestedChainContext }
+  | { ok: false; failure: NestedObjectGeometryFailure };
+
+function textFrameFacts(layer: ArtworkTextLayer, parentId: string): NestedObjectFrameFacts {
+  return {
+    id: layer.id,
+    kind: 'text',
+    parentId,
+    x: layer.xCoordinate,
+    y: layer.yCoordinate,
+    width: layer.width,
+    height: layer.height,
+    rotationDegrees: layer.rotation,
+    flipX: layer.transform.flipX,
+    flipY: layer.transform.flipY,
+  };
+}
+
+function objectFrameFacts(layer: ArtworkObjectLayer, parentId: string): NestedObjectFrameFacts {
+  return {
+    id: layer.id,
+    kind: 'object',
+    parentId,
+    x: layer.xCoordinate,
+    y: layer.yCoordinate,
+    width: layer.width,
+    height: layer.height,
+    rotationDegrees: layer.rotation,
+    flipX: layer.transform.flipX,
+    flipY: layer.transform.flipY,
+  };
+}
+
+/**
+ * Computes the actual-product-function normalization facts for the accepted
+ * active target subtree (ADR 0015 B4/B11). The proof runs the real
+ * `normalizeArtworkGroupFrames` on an independently cloned subtree with an
+ * empty skip set, so a non-fixed-point baseline/observation is recorded
+ * truthfully rather than repaired.
+ */
+function nestedNormalizationFacts(typed: {
+  targetId: string;
+  layoutId: string;
+}): NestedObjectNormalizationFacts {
+  const certificateVersion = 'makeit.nested-object-normalization-certificate.v1';
+  const emptyState: NestedObjectNormalizationFacts = {
+    certificateVersion,
+    fixedPoint: false,
+    referentiallyUnchanged: false,
+    subtreeFingerprint: '',
+  };
+  const state = useArtworkEditorStore.getState();
+  const layoutItem = state.layoutItems.find((item) => item.id === typed.layoutId);
+  if (!layoutItem) return emptyState;
+  const context = findArtworkLayerContext(
+    (layoutItem.layers ?? []).filter(isSelectableArtworkLayer),
+    typed.targetId,
+  );
+  if (!context) return emptyState;
+  const targetLayer = context.layer;
+  const input = [structuredClone(targetLayer)];
+  const inputFingerprint = fnv1a64Hex(JSON.stringify(input));
+  const normalized = normalizeArtworkGroupFrames(input, new Set<string>());
+  const normalizedFingerprint = fnv1a64Hex(JSON.stringify(normalized));
+  return {
+    certificateVersion,
+    fixedPoint: normalizedFingerprint === inputFingerprint,
+    referentiallyUnchanged: normalized === input,
+    subtreeFingerprint: inputFingerprint,
+  };
+}
+
+/**
+ * Resolves the exact Text → inner Object → outer Object → Layout chain for one
+ * pair-explicit request from canonical store state only. The witness is never
+ * guessed: it is the requested id, and the chain fails closed unless the
+ * requested target and Layout are exactly its ancestors.
+ */
+function findNestedObjectChainContext(typed: {
+  targetId: string;
+  witnessId: string;
+  layoutId: string;
+}): NestedChainResult {
+  const state = useArtworkEditorStore.getState();
+  const layoutItem = state.layoutItems.find((item) => item.id === typed.layoutId);
+  if (!layoutItem) {
+    return {
+      ok: false,
+      failure: {
+        code: 'GEOMETRY_CHAIN_INVALID',
+        reason: 'CHAIN_LAYOUT_UNRESOLVED',
+        detail: `The requested Layout "${typed.layoutId}" is not present in canonical state.`,
+      },
+    };
+  }
+  const context = findArtworkLayerContext(
+    (layoutItem.layers ?? []).filter(isSelectableArtworkLayer),
+    typed.witnessId,
+  );
+  if (!context || context.layer.id !== typed.witnessId || !isArtworkTextLayer(context.layer)) {
+    return {
+      ok: false,
+      failure: {
+        code: 'GEOMETRY_CHAIN_INVALID',
+        reason: 'CHAIN_WITNESS_UNRESOLVED',
+        detail: `The requested witness "${typed.witnessId}" is not a Text layer under "${typed.layoutId}".`,
+      },
+    };
+  }
+  const ancestors = context.ancestors;
+  if (ancestors.length !== 2) {
+    return {
+      ok: false,
+      failure: {
+        code: 'GEOMETRY_CHAIN_INVALID',
+        reason: 'CHAIN_SHAPE',
+        detail: 'The nested chain must be exactly Text → inner Object → outer Object → Layout.',
+      },
+    };
+  }
+  const outer = ancestors[0] as ArtworkObjectLayer;
+  const inner = ancestors[1] as ArtworkObjectLayer;
+  if (outer.id !== typed.targetId) {
+    return {
+      ok: false,
+      failure: {
+        code: 'GEOMETRY_CHAIN_ID_MISMATCH',
+        reason: 'CHAIN_ID_MISMATCH',
+        detail: `The witness chain root "${outer.id}" is not the requested target "${typed.targetId}".`,
+      },
+    };
+  }
+  const chain: NestedObjectFrameFacts[] = [textFrameFacts(context.layer, inner.id)];
+  for (let index = ancestors.length - 1; index >= 0; index -= 1) {
+    const ancestor = ancestors[index] as ArtworkObjectLayer;
+    const parentId = index === 0 ? typed.layoutId : (ancestors[index - 1] as ArtworkObjectLayer).id;
+    chain.push(objectFrameFacts(ancestor, parentId));
+  }
+  return { ok: true, context: { chain } };
+}
+
+interface NestedCandidatePoint {
+  candidate: NestedInteractionCandidate;
+  point: GeometryPoint;
+}
+
+type NestedCandidateResult =
+  | {
+      ok: true;
+      points: NestedCandidatePoint[];
+      cssRatios: { x: number; y: number };
+      containerRect: { left: number; top: number };
+    }
+  | { ok: false; failure: NestedObjectGeometryFailure };
+
+/**
+ * Derives the deterministic candidate points from the live convex target quad in
+ * the fixed R8 order. A candidate is eligible only when it is finite, inside the
+ * live convex quad, and at least exactly 4 CSS px from every edge. No AABB,
+ * canonical-only, previous, endpoint, screenshot, or guessed fallback exists.
+ */
+function nestedCandidatePoints(input: {
+  stage: Konva.Stage;
+  targetNode: Konva.Node;
+  layoutNode: Konva.Node;
+  targetFacts: NestedObjectFrameFacts;
+}): NestedCandidateResult {
+  const geometryInvalid = (reason: string, detail: string): NestedCandidateResult => ({
+    ok: false,
+    failure: { code: 'GEOMETRY_TRANSFORM_INVALID', reason, detail },
+  });
+  const targetLocalQuad: Quad = [
+    { x: 0, y: 0 },
+    { x: input.targetFacts.width, y: 0 },
+    { x: input.targetFacts.width, y: input.targetFacts.height },
+    { x: 0, y: input.targetFacts.height },
+  ];
+  const resolvedWrappers = resolveObjectWrapperChain({
+    targetNode: input.targetNode,
+    layoutNode: input.layoutNode,
+    targetPersistedFrame: {
+      x: input.targetFacts.x,
+      y: input.targetFacts.y,
+      width: input.targetFacts.width,
+      height: input.targetFacts.height,
+      rotationDegrees: input.targetFacts.rotationDegrees,
+      flipX: input.targetFacts.flipX,
+      flipY: input.targetFacts.flipY,
+    },
+  });
+  if (!resolvedWrappers.ok) {
+    return geometryInvalid(resolvedWrappers.failure.reason, resolvedWrappers.failure.detail);
+  }
+  const renderedTargetToLayout = resolvedWrappers.wrappers.completeObjectToLayout;
+  if (renderedTargetToLayout === null) {
+    return geometryInvalid(
+      'TARGET_TRANSFORM_INVALID',
+      'The live target-to-Layout transform is not finite.',
+    );
+  }
+  const layerNode = (() => {
+    try {
+      return input.layoutNode.getLayer();
+    } catch {
+      return null;
+    }
+  })();
+  const layoutToWorldScene =
+    layerNode === null ? null : readRelativeAffine(input.layoutNode, layerNode);
+  if (layoutToWorldScene === null) {
+    return geometryInvalid(
+      'LAYOUT_TO_WORLD_INVALID',
+      'The live Layout-to-scene transform is not finite.',
+    );
+  }
+  const stageMatrix = readStageViewMatrix(input.stage);
+  if (stageMatrix === null) {
+    return geometryInvalid('STAGE_TRANSFORM_INVALID', 'The live Stage transform is not finite.');
+  }
+  const measured = measureStageCssFacts(input.stage);
+  if (!measured.ok) {
+    return geometryInvalid(measured.failure.reason, measured.failure.detail);
+  }
+  const { cssRatios, containerRect } = measured.facts;
+  const worldSceneToStageViewportCss = multiplyAffine(
+    scaleAffine(1 / cssRatios.x, 1 / cssRatios.y),
+    stageMatrix,
+  );
+  const stageViewportToBrowserClientCss = translationAffine(containerRect.left, containerRect.top);
+  const targetBrowserMatrix = multiplyAffine(
+    stageViewportToBrowserClientCss,
+    multiplyAffine(
+      worldSceneToStageViewportCss,
+      multiplyAffine(layoutToWorldScene, renderedTargetToLayout),
+    ),
+  );
+  const quad = transformQuad(targetBrowserMatrix, targetLocalQuad);
+  if (!quad.every(isFinitePoint)) {
+    return geometryInvalid(
+      'TARGET_QUAD_NON_FINITE',
+      'The live target quad contains a non-finite point.',
+    );
+  }
+  const points: NestedCandidatePoint[] = [];
+  for (const candidate of NESTED_HIT_CANDIDATE_UVS) {
+    const point = bilinearPoint(quad, candidate.u, candidate.v);
+    if (!Number.isFinite(point.x) || !Number.isFinite(point.y)) continue;
+    if (!pointInConvexQuad(point, quad)) continue;
+    if (distanceToQuadEdges(point, quad) < NESTED_HIT_INSET_CSS_PX) continue;
+    points.push({ candidate: candidate.label, point });
+  }
+  if (points.length === 0) {
+    return {
+      ok: false,
+      failure: {
+        code: 'TARGET_QUAD_INTERACTION_POINT_INVALID',
+        reason: 'TARGET_QUAD_INTERACTION_POINT_INVALID',
+        detail:
+          'No finite candidate at least 4 CSS px inside the live convex target quad could be derived.',
+      },
+    };
+  }
+  return {
+    ok: true,
+    points,
+    cssRatios: { x: cssRatios.x, y: cssRatios.y },
+    containerRect: { left: containerRect.left, top: containerRect.top },
+  };
+}
+
+function nestedHitAt(
+  stage: Konva.Stage,
+  point: GeometryPoint,
+  cssRatios: { x: number; y: number },
+  containerRect: { left: number; top: number },
+): Konva.Node | null {
+  const stagePoint = {
+    x: (point.x - containerRect.left) * cssRatios.x,
+    y: (point.y - containerRect.top) * cssRatios.y,
+  };
+  if (!Number.isFinite(stagePoint.x) || !Number.isFinite(stagePoint.y)) return null;
+  try {
+    return stage.getIntersection(stagePoint) ?? null;
+  } catch {
+    return null;
+  }
+}
+
+type NestedPreActionResult =
+  | { ok: true; interaction: Omit<NestedObjectPreActionInteraction, 'interactionFingerprint'> }
+  | { ok: false; failure: NestedObjectGeometryFailure };
+
+/**
+ * Pre-action authorization (ADR 0014 R8A): search the fixed candidate order
+ * until one live `getIntersection` proves a chrome-free, target-owned hit. The
+ * accepted point is the only point the native action may dispatch from.
+ */
+function nestedPreActionInteraction(input: {
+  stage: Konva.Stage;
+  targetNode: Konva.Node;
+  layoutNode: Konva.Node;
+  targetFacts: NestedObjectFrameFacts;
+  targetId: string;
+}): NestedPreActionResult {
+  const derived = nestedCandidatePoints(input);
+  if (!derived.ok) return { ok: false, failure: derived.failure };
+  const rejected: string[] = [];
+  for (const { candidate, point } of derived.points) {
+    const hit = nestedHitAt(input.stage, point, derived.cssRatios, derived.containerRect);
+    if (hit === null) {
+      rejected.push(`${candidate}:none`);
+      continue;
+    }
+    const ancestry = classifyNestedHitAncestry(hit, input.targetNode);
+    if (ancestry.selectionChrome || ancestry.transformChrome) {
+      rejected.push(`${candidate}:chrome(${safeNodeClass(hit)})`);
+      continue;
+    }
+    if (!ancestry.owned) {
+      rejected.push(`${candidate}:foreign(${safeNodeClass(hit)})`);
+      continue;
+    }
+    return {
+      ok: true,
+      interaction: {
+        phase: 'pre-action',
+        purpose: 'authorize-native-action',
+        authority: 'action',
+        status: 'authorized',
+        targetId: input.targetId,
+        space: 'browser-client-css',
+        candidate,
+        point,
+        safetyInsetCssPx: 4,
+        source: 'live-konva-hit-v1',
+        hitClassification: hit === input.targetNode ? 'target' : 'owned-non-chrome-descendant',
+      },
+    };
+  }
+  return {
+    ok: false,
+    failure: {
+      code: 'HIT_POINT_UNAVAILABLE',
+      reason: 'HIT_POINT_UNAVAILABLE',
+      detail: `No chrome-free target-owned hit could be authorized at least 4 CSS px from every live target edge (${rejected.join(', ')}).`,
+    },
+  };
+}
+
+type NestedPostActionResult =
+  | { ok: true; interaction: Omit<NestedObjectPostActionInteraction, 'interactionFingerprint'> }
+  | { ok: false; failure: NestedObjectGeometryFailure };
+
+/**
+ * Post-action observation (ADR 0014 R8B): select the first geometrically
+ * eligible candidate, perform exactly one `getIntersection` probe, and record
+ * the truthful classification with `authority:'none'`. Later candidates are
+ * never searched to manufacture a clearer result.
+ */
+function nestedPostActionInteraction(input: {
+  stage: Konva.Stage;
+  targetNode: Konva.Node;
+  layoutNode: Konva.Node;
+  targetFacts: NestedObjectFrameFacts;
+  targetId: string;
+}): NestedPostActionResult {
+  const derived = nestedCandidatePoints(input);
+  if (!derived.ok) return { ok: false, failure: derived.failure };
+  const first = derived.points[0] as NestedCandidatePoint;
+  const hit = nestedHitAt(input.stage, first.point, derived.cssRatios, derived.containerRect);
+  const classified = classifyNestedPostHit(hit, input.targetNode);
+  const obstructed =
+    classified.classification === 'selection-chrome' ||
+    classified.classification === 'transform-chrome' ||
+    classified.classification === 'foreign-listening-node' ||
+    classified.classification === 'no-hit';
+  return {
+    ok: true,
+    interaction: {
+      phase: 'post-action',
+      purpose: 'observe-authoritative-geometry',
+      authority: 'none',
+      status: obstructed ? 'obstructed' : 'clear',
+      targetId: input.targetId,
+      space: 'browser-client-css',
+      candidate: first.candidate,
+      point: first.point,
+      safetyInsetCssPx: 4,
+      source: 'live-konva-hit-v1',
+      hitClassification: classified.classification,
+      obstructionCode: obstructed ? 'POST_ACTION_HIT_OBSTRUCTED' : null,
+      safeHitDescriptor: classified.descriptor,
+    },
+  };
+}
+
+function nestedFailureGeometry(
+  stage: Konva.Stage,
+  generation: number,
+  observation: ArtworkVerificationObservationCursor,
+  id: string,
+  failure: NestedObjectGeometryFailure,
+): ArtworkVerificationGeometry {
+  return {
+    observation,
+    id,
+    konvaId: id,
+    mounted: false,
+    reason: 'culled-or-not-rendered',
+    renderer: {
+      bridgeGeneration: generation,
+      stageFingerprint: stageRendererFingerprint(stage),
+      targetFingerprint: `geometry-v3-unavailable:${failure.code}`,
+      target: null,
+    },
+    geometryV3Failure: failure,
+  };
+}
+
+/**
+ * Pair-explicit geometry-v3 read. Parses the typed request, resolves the exact
+ * canonical chain and mounted nodes, constructs the R8 hit point, and projects
+ * the typed record. Every failure is returned as a structured, non-mutating
+ * `geometryV3Failure` rather than a guessed or partial record.
+ */
+function geometryRequest(
+  stage: Konva.Stage,
+  generation: number,
+  request: ArtworkGeometryRequest,
+  observation: ArtworkVerificationObservationCursor,
+): ArtworkVerificationGeometry {
+  if (typeof request === 'string') return geometry(stage, generation, request, observation);
+  const parsed = validateNestedObjectGeometryRequest(request);
+  if (!parsed.ok) {
+    const candidateId =
+      typeof (request as { targetId?: unknown }).targetId === 'string'
+        ? (request as { targetId: string }).targetId
+        : '';
+    return nestedFailureGeometry(stage, generation, observation, candidateId, parsed.failure);
+  }
+  const typed = parsed.typed;
+  const resolved = findNestedObjectChainContext(typed);
+  if (!resolved.ok) {
+    return nestedFailureGeometry(stage, generation, observation, typed.targetId, resolved.failure);
+  }
+  const targetNode = konvaNodeById(stage, typed.targetId);
+  const witnessNode = konvaNodeById(stage, typed.witnessId);
+  const layoutNode = konvaNodeById(stage, `layout-${typed.layoutId}`);
+  if (targetNode === null || witnessNode === null || layoutNode === null) {
+    return nestedFailureGeometry(stage, generation, observation, typed.targetId, {
+      code: 'GEOMETRY_CHAIN_INVALID',
+      reason: 'CHAIN_NODE_UNMOUNTED',
+      detail: 'The target, witness, or Layout renderer node is not mounted on the live Stage.',
+    });
+  }
+  const chain = resolved.context.chain;
+  const targetFacts = chain[chain.length - 1] as NestedObjectFrameFacts;
+  const interaction =
+    typed.interaction.phase === 'pre-action'
+      ? nestedPreActionInteraction({
+          stage,
+          targetNode,
+          layoutNode,
+          targetFacts,
+          targetId: typed.targetId,
+        })
+      : nestedPostActionInteraction({
+          stage,
+          targetNode,
+          layoutNode,
+          targetFacts,
+          targetId: typed.targetId,
+        });
+  if (!interaction.ok) {
+    return nestedFailureGeometry(
+      stage,
+      generation,
+      observation,
+      typed.targetId,
+      interaction.failure,
+    );
+  }
+  const state = useArtworkEditorStore.getState();
+  const projected = projectNestedObjectGeometryV3({
+    bridgeGeneration: generation,
+    targetId: typed.targetId,
+    witnessId: typed.witnessId,
+    layoutId: typed.layoutId,
+    chain,
+    stage,
+    targetNode,
+    witnessNode,
+    layoutNode,
+    camera: state.camera,
+    normalization: nestedNormalizationFacts({ targetId: typed.targetId, layoutId: typed.layoutId }),
+    interaction: interaction.interaction,
+  });
+  if (!projected.ok) {
+    return nestedFailureGeometry(stage, generation, observation, typed.targetId, projected.failure);
+  }
+  // Publish the generic read (rects, viewportRect, renderer provenance) with the
+  // geometry-v3 record merged in. Only the pre-action authorization record may
+  // expose an action point; a post-action record never publishes one, so no
+  // generic AABB-derived hit point can be mistaken for an observation point.
+  const base = geometry(stage, generation, typed.targetId, observation);
+  if (typed.interaction.phase === 'pre-action') {
+    return {
+      ...base,
+      hitPoint: projected.record.interaction.point,
+      geometryV3: projected.record,
+    };
+  }
+  const { hitPoint: _omittedPostHitPoint, ...postBase } = base;
+  return {
+    ...postBase,
+    geometryV3: projected.record,
+  };
+}
+
+function findKonvaImageNode(node: Konva.Node): Konva.Image | null {
+  if (node.getClassName() === 'Image') return node as Konva.Image;
+  const container = node as Konva.Container;
+  if (typeof container.find !== 'function') return null;
+  const [imageNode] = container.find<Konva.Image>(
+    (candidate: Konva.Node) => candidate.getClassName() === 'Image',
+  );
+  return imageNode ?? null;
+}
+
+// ── Raster identity and canonical upload authority (bridge v5) ───────────────
+
+/**
+ * Monotonic, never-serialized object identity. Every live raster node, Konva
+ * Image, and backing canvas gets one stable id per browser Document so a
+ * renderer fingerprint can prove the exact canvas object did not change, even
+ * when the frame geometry and Stage transform are unchanged (supervisor R5).
+ */
+const objectIdentityIds = new WeakMap<object, number>();
+let objectIdentityCounter = 0;
+
+function objectIdentity(value: object): number {
+  const existing = objectIdentityIds.get(value);
+  if (existing !== undefined) return existing;
+  objectIdentityCounter += 1;
+  objectIdentityIds.set(value, objectIdentityCounter);
+  return objectIdentityCounter;
+}
+
+interface LiveRasterNodes {
+  all: Konva.Image[];
+  canvasBacked: Konva.Image[];
+}
+
+function isCanvasDrawable(value: unknown): value is HTMLCanvasElement {
+  if (typeof HTMLCanvasElement !== 'undefined' && value instanceof HTMLCanvasElement) return true;
+  return (
+    typeof value === 'object' &&
+    value !== null &&
+    typeof (value as { getContext?: unknown }).getContext === 'function' &&
+    typeof (value as { width?: unknown }).width === 'number'
+  );
+}
+
+/** Live Konva Image descendants of a target, plus those whose drawable is a canvas. */
+function collectRasterNodes(node: Konva.Node): LiveRasterNodes {
+  const all: Konva.Image[] = [];
+  if (node.getClassName() === 'Image') all.push(node as Konva.Image);
+  const container = node as Konva.Container;
+  if (typeof container.find === 'function') {
+    all.push(
+      ...container.find<Konva.Image>(
+        (candidate: Konva.Node) => candidate.getClassName() === 'Image',
+      ),
+    );
+  }
+  const canvasBacked = all.filter((candidate) => {
+    try {
+      return isCanvasDrawable(candidate.image());
+    } catch {
+      return false;
+    }
+  });
+  return { all, canvasBacked };
+}
+
+interface CanonicalLayerFacts {
+  exists: boolean;
+  placeholder: boolean;
+  testedWithImage: boolean;
+  src: string | null;
+}
+
+/** Reads the canonical layer facts (config flags, source) read-only. */
+function readCanonicalLayerFacts(id: string): CanonicalLayerFacts {
+  const state = useArtworkEditorStore.getState();
+  for (const item of state.layoutItems) {
+    for (const layer of item.layers ?? []) {
+      if (!('id' in layer) || (layer as { id?: unknown }).id !== id) continue;
+      const record = layer as { src?: unknown; config?: unknown };
+      const config = (record.config ?? {}) as Record<string, unknown>;
+      const src =
+        typeof record.src === 'string' && record.src.length > 0
+          ? record.src
+          : typeof config.src === 'string' && config.src.length > 0
+            ? config.src
+            : null;
+      return {
+        exists: true,
+        placeholder: config.placeholder === true,
+        testedWithImage: config.testedWithImage === true,
+        src,
+      };
+    }
+  }
+  return { exists: false, placeholder: false, testedWithImage: false, src: null };
+}
+
+/** Opaque live-raster identity used by the renderer fingerprint bracket. */
+function rasterIdentityFacts(node: Konva.Node): string {
+  const { all, canvasBacked } = collectRasterNodes(node);
+  const primary = canvasBacked[0] ?? all[0] ?? null;
+  let canvasIdentity: number | null = null;
+  if (canvasBacked[0]) {
+    try {
+      const drawable = canvasBacked[0].image();
+      if (typeof drawable === 'object' && drawable !== null)
+        canvasIdentity = objectIdentity(drawable);
+    } catch {
+      canvasIdentity = null;
+    }
+  }
+  return JSON.stringify({
+    target: objectIdentity(node),
+    imageNode: primary === null ? null : objectIdentity(primary),
+    canvas: canvasIdentity,
+    all: all.length,
+    canvasBacked: canvasBacked.length,
+  });
+}
+
+function safeNumber(read: () => number): number | null {
+  try {
+    const value = read();
+    return typeof value === 'number' && Number.isFinite(value) ? value : null;
+  } catch {
+    return null;
+  }
+}
+
+function safeBoolean(read: () => boolean): boolean {
+  try {
+    return read() === true;
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Typed live node-transform provenance for one resolved target. Every field is
+ * read defensively; any unreadable identity or non-finite position yields
+ * `null` so the Oracle reports unusable renderer provenance instead of falling
+ * back to an AABB rect (R11).
+ */
+function targetTransformProvenance(
+  node: Konva.Node,
+): ArtworkVerificationRendererTargetProvenance | null {
+  const id = (() => {
+    try {
+      return node.id();
+    } catch {
+      return null;
+    }
+  })();
+  const nodeClass = (() => {
+    try {
+      return node.getClassName();
+    } catch {
+      return null;
+    }
+  })();
+  const x = safeNumber(() => node.x());
+  const y = safeNumber(() => node.y());
+  if (id === null || nodeClass === null || x === null || y === null) return null;
+  return { id, nodeClass, x, y };
+}
+
+/**
+ * Deterministic, serializable fingerprint of the renderer representation the
+ * Oracle consumes for one target: Stage transform plus the live client rect and
+ * node transform. Read-only; never mutates the Stage or node.
+ */
+function stageRendererFingerprint(stage: Konva.Stage): string {
+  return JSON.stringify({
+    x: safeNumber(() => stage.x()),
+    y: safeNumber(() => stage.y()),
+    scaleX: safeNumber(() => stage.scaleX()),
+    scaleY: safeNumber(() => stage.scaleY()),
+    rotation: safeNumber(() => stage.rotation()),
+  });
+}
+
+function targetRendererFingerprint(stage: Konva.Stage, node: Konva.Node): string {
+  const rect = (() => {
+    try {
+      return node.getClientRect({ relativeTo: stage });
+    } catch {
+      return null;
+    }
+  })();
+  return JSON.stringify({
+    id: (() => {
+      try {
+        return node.id();
+      } catch {
+        return null;
+      }
+    })(),
+    x: safeNumber(() => node.x()),
+    y: safeNumber(() => node.y()),
+    scaleX: safeNumber(() => node.scaleX()),
+    scaleY: safeNumber(() => node.scaleY()),
+    rotation: safeNumber(() => node.rotation()),
+    skewX: safeNumber(() => node.skewX()),
+    skewY: safeNumber(() => node.skewY()),
+    visible: safeBoolean(() => node.isVisible()),
+    listening: safeBoolean(() => node.isListening()),
+    clientRect: rect ? { x: rect.x, y: rect.y, width: rect.width, height: rect.height } : null,
+    // Live raster-node identity is part of the target's renderer fingerprint so
+    // a replacement that reuses the frame/root transform is still a change
+    // (supervisor R5). It is an opaque equality fact, never parsed.
+    raster: rasterIdentityFacts(node),
+  });
+}
+
+/**
+ * Computes the nested representation fingerprint for one explicit pair, or
+ * `null` when the pair cannot be projected read-only. Used only for the
+ * target-aware idle equality demanded by R9; it never guesses a witness.
+ */
+function nestedRepresentationFingerprint(
+  stage: Konva.Stage,
+  generation: number,
+  typed: { targetId: string; witnessId: string; layoutId: string },
+): string | null {
+  const resolved = findNestedObjectChainContext(typed);
+  if (!resolved.ok) return null;
+  const targetNode = konvaNodeById(stage, typed.targetId);
+  const witnessNode = konvaNodeById(stage, typed.witnessId);
+  const layoutNode = konvaNodeById(stage, `layout-${typed.layoutId}`);
+  if (targetNode === null || witnessNode === null || layoutNode === null) return null;
+  const state = useArtworkEditorStore.getState();
+  return computeNestedRepresentationFingerprintGeometryOnly({
+    bridgeGeneration: generation,
+    targetId: typed.targetId,
+    witnessId: typed.witnessId,
+    layoutId: typed.layoutId,
+    chain: resolved.context.chain,
+    stage,
+    targetNode,
+    witnessNode,
+    layoutNode,
+    camera: state.camera,
+    normalization: nestedNormalizationFacts({ targetId: typed.targetId, layoutId: typed.layoutId }),
+  });
+}
+
+function rendererFingerprint(
+  stage: Konva.Stage,
+  generation: number,
+  targetIds: readonly string[],
+  nested?: { targetId: string; witnessId: string; layoutId: string },
+): ArtworkVerificationRendererFingerprint {
+  const state = useArtworkEditorStore.getState();
+  const nodes = layoutItemsToNodes(state.layoutItems).nodes;
+  const nestedFingerprint =
+    nested === undefined ? null : nestedRepresentationFingerprint(stage, generation, nested);
+  const targets = targetIds.map<ArtworkVerificationTargetRendererFacts>((id) => {
+    const sceneNode = nodes[id];
+    if (!sceneNode) {
+      return { id, fingerprint: 'unresolved', mounted: false, visible: false, listening: false };
+    }
+    const node = findKonvaNode(stage, sceneNode);
+    if (!node) {
+      return { id, fingerprint: 'unmounted', mounted: false, visible: false, listening: false };
+    }
+    // For the circle-warped Text representation the stable target identity is
+    // the typed geometry envelope fingerprint, so idle/G0/G1 equality covers
+    // identities, matrices, measured CSS ratios, ordered browser-client points,
+    // representation kind, and the warp/representation fingerprints.
+    const envelope = warpedEnvelopeFingerprint(stage, generation, id);
+    const nestedPair =
+      nestedFingerprint !== null &&
+      nested !== undefined &&
+      (id === nested.targetId || id === nested.witnessId);
+    return {
+      id,
+      fingerprint: nestedPair
+        ? `geometry-v3:${nestedFingerprint as string}`
+        : envelope === null
+          ? targetRendererFingerprint(stage, node)
+          : `geometry-v2:${envelope}`,
+      mounted: true,
+      visible: safeBoolean(() => node.isVisible()),
+      listening: safeBoolean(() => node.isListening()),
+    };
+  });
+  return {
+    bridgeGeneration: generation,
+    stageFingerprint: stageRendererFingerprint(stage),
+    targets,
+  };
+}
+
+/**
+ * Resolves the current document/currentness identity from the live browser
+ * Document and the current route address, adding the bridge contract version.
+ */
+export function resolveArtworkVerificationDocumentIdentity(): ArtworkVerificationDocumentIdentity {
+  const address = resolveArtworkVerificationDocumentAddress();
+  return {
+    documentId: address.documentId,
+    documentEpoch: address.documentEpoch,
+    bridgeVersion: BRIDGE_VERSION,
+  };
+}
+
+/**
+ * Read undo/redo depth without touching history. Missing stacks are treated as
+ * empty so a store without history never reports phantom entries.
+ */
+export function readArtworkVerificationHistoryDepth(history: {
+  past?: readonly unknown[];
+  future?: readonly unknown[];
+}): ArtworkVerificationHistoryFacts {
+  const pastDepth = Array.isArray(history.past) ? history.past.length : 0;
+  const futureDepth = Array.isArray(history.future) ? history.future.length : 0;
+  return { pastDepth, futureDepth, baselineClean: pastDepth === 0 && futureDepth === 0 };
+}
+
+function measureRasterSource(source: ArtworkVerificationRasterSource | null): {
+  width: number | null;
+  height: number | null;
+} {
+  if (!source) return { width: null, height: null };
+  const width =
+    typeof source.naturalWidth === 'number'
+      ? source.naturalWidth
+      : typeof source.videoWidth === 'number'
+        ? source.videoWidth
+        : typeof source.width === 'number'
+          ? source.width
+          : null;
+  const height =
+    typeof source.naturalHeight === 'number'
+      ? source.naturalHeight
+      : typeof source.videoHeight === 'number'
+        ? source.videoHeight
+        : typeof source.height === 'number'
+          ? source.height
+          : null;
+  return { width, height };
+}
+
+/**
+ * Classify whether a live raster source currently has decoded, non-empty
+ * pixels. `pending` means the source is absent or still loading; `failed`
+ * means the renderer produced an empty surface; `ready` means it can draw.
+ */
+export function classifyArtworkVerificationRaster(
+  source: ArtworkVerificationRasterSource | null,
+): ArtworkVerificationRasterStatus {
+  if (!source) return 'pending';
+  if (source.complete === false) return 'pending';
+  const { width, height } = measureRasterSource(source);
+  if (width === null || height === null) return 'pending';
+  if (width <= 0 || height <= 0) return 'failed';
+  return 'ready';
+}
+
+/**
+ * Reports the authoritative content derived from `layoutItems` next to the
+ * existing flattened `nodes`/`rootIds` mirror. Neither input is mutated: a stale
+ * mirror stays stale and visible instead of being repaired (specification 17).
+ */
+export function readArtworkVerificationScenegraphFacts(
+  layoutItems: readonly ArtworkLayoutItem[],
+  mirror: { nodes?: Record<string, SceneNode>; rootIds?: readonly string[] },
+): ArtworkVerificationScenegraphFacts {
+  const content = layoutItemsToNodes(layoutItems);
+  const scenegraphNodes = mirror.nodes ?? {};
+  const scenegraphRootIds = [...(mirror.rootIds ?? [])];
+  const scenegraphInSync =
+    JSON.stringify({ nodes: content.nodes, rootIds: content.rootIds }) ===
+    JSON.stringify({ nodes: scenegraphNodes, rootIds: scenegraphRootIds });
+  return {
+    contentNodes: content.nodes,
+    contentRootIds: content.rootIds,
+    scenegraphNodes,
+    scenegraphRootIds,
+    scenegraphInSync,
+  };
+}
+
+export function isArtworkVerificationEnabled(): boolean {
+  return (
+    process.env.NODE_ENV !== 'production' && process.env.NEXT_PUBLIC_ARTWORK_VERIFICATION === 'true'
+  );
+}
+
+export function filterArtworkVerificationElements(
+  nodes: Record<string, SceneNode>,
+  mountedIds: ReadonlySet<string>,
+  selectedLayoutIds: readonly string[],
+  selectedIds: readonly string[],
+  selector: ArtworkVerificationSelector = {},
+): ArtworkVerificationElement[] {
+  const selected = new Set([...selectedLayoutIds, ...selectedIds]);
+
+  return Object.values(nodes)
+    .map<ArtworkVerificationElement>((node) => ({
+      id: node.id,
+      kind: kindFromType(node.type),
+      type: node.type,
+      name: node.name ?? null,
+      parentId: node.parentId,
+      children: [...node.children],
+      hidden: Boolean(node.hidden),
+      locked: Boolean(node.locked),
+      mounted: mountedIds.has(node.id),
+      selected: selected.has(node.id),
+    }))
+    .filter((element) => {
+      if (selector.id !== undefined && element.id !== selector.id) return false;
+      if (selector.kind !== undefined && element.kind !== selector.kind) return false;
+      if (selector.name !== undefined && element.name !== selector.name) return false;
+      if (selector.parentId !== undefined && element.parentId !== selector.parentId) return false;
+      if (selector.mounted !== undefined && element.mounted !== selector.mounted) return false;
+      if (selector.selected !== undefined && element.selected !== selector.selected) return false;
+      return true;
+    });
+}
+
+function isHitInsideNode(hit: Konva.Node | null, expected: Konva.Node): boolean {
+  let current = hit;
+  while (current) {
+    if (current === expected) return true;
+    current = current.getParent();
+  }
+  return false;
+}
+
+function findHitPoint(
+  stage: Konva.Stage,
+  node: Konva.Node,
+  stageRect: ArtworkVerificationRect,
+  containerRect: DOMRect,
+): ArtworkVerificationPoint | undefined {
+  const fractions = [0.5, 0.25, 0.75, 0.1, 0.9];
+
+  for (const yFraction of fractions) {
+    for (const xFraction of fractions) {
+      const stagePoint = {
+        x: stageRect.x + stageRect.width * xFraction,
+        y: stageRect.y + stageRect.height * yFraction,
+      };
+      const hit = stage.getIntersection(stagePoint);
+      if (isHitInsideNode(hit, node)) {
+        return {
+          x: containerRect.left + stagePoint.x,
+          y: containerRect.top + stagePoint.y,
+        };
+      }
+    }
+  }
+
+  return undefined;
+}
+
+function readCursor(generation: number): ArtworkVerificationObservationCursor {
+  const facts = readArtworkVerificationSignalCursor(generation);
+  return {
+    schemaVersion: ARTWORK_VERIFICATION_CURSOR_SCHEMA_VERSION,
+    documentId: facts.documentId,
+    documentEpoch: facts.documentEpoch,
+    bridgeVersion: BRIDGE_VERSION,
+    bridgeGeneration: facts.bridgeGeneration,
+    revision: facts.revision,
+  };
+}
+
+function cursorFromFacts(
+  facts: ArtworkVerificationSignalCursorFacts,
+): ArtworkVerificationObservationCursor {
+  return {
+    schemaVersion: ARTWORK_VERIFICATION_CURSOR_SCHEMA_VERSION,
+    documentId: facts.documentId,
+    documentEpoch: facts.documentEpoch,
+    bridgeVersion: BRIDGE_VERSION,
+    bridgeGeneration: facts.bridgeGeneration,
+    revision: facts.revision,
+  };
+}
+
+function snapshot(observation: ArtworkVerificationObservationCursor): ArtworkVerificationSnapshot {
+  const state = useArtworkEditorStore.getState();
+  const scenegraph = readArtworkVerificationScenegraphFacts(state.layoutItems, {
+    nodes: state.nodes,
+    rootIds: state.rootIds,
+  });
+  return structuredClone({
+    version: BRIDGE_VERSION,
+    observation,
+    document: {
+      documentId: observation.documentId,
+      documentEpoch: observation.documentEpoch,
+      bridgeVersion: observation.bridgeVersion,
+    },
+    route: window.location.pathname,
+    layoutItems: state.layoutItems,
+    rootIds: scenegraph.contentRootIds,
+    scenegraphRootIds: scenegraph.scenegraphRootIds,
+    contentNodes: scenegraph.contentNodes,
+    scenegraphNodes: scenegraph.scenegraphNodes,
+    scenegraphInSync: scenegraph.scenegraphInSync,
+    activeLayoutId: state.activeLayoutId,
+    selectedLayoutIds: state.selectedLayoutIds,
+    selectedLayerIds: state.selectedLayers.map((layer) => layer.id),
+    primarySelectedLayerId: state.primarySelectedLayerId,
+    optimisticSelectedLayerId: state.optimisticSelectedLayerId,
+    camera: state.camera,
+    isPanning: state.isPanning,
+    canUndo: state.canUndo,
+    canRedo: state.canRedo,
+    history: readArtworkVerificationHistoryDepth(state),
+  });
+}
+
+function geometry(
+  stage: Konva.Stage,
+  generation: number,
+  id: string,
+  observation: ArtworkVerificationObservationCursor,
+): ArtworkVerificationGeometry {
+  const state = useArtworkEditorStore.getState();
+  const sceneNode = layoutItemsToNodes(state.layoutItems).nodes[id];
+  if (!sceneNode) {
+    throw new Error(`Artwork verification element not found: ${id}`);
+  }
+
+  const konvaId = konvaIdForNode(sceneNode);
+  const node = findKonvaNode(stage, sceneNode);
+  if (!node) {
+    return {
+      observation,
+      id,
+      konvaId,
+      mounted: false,
+      reason: 'culled-or-not-rendered',
+      renderer: {
+        bridgeGeneration: generation,
+        stageFingerprint: stageRendererFingerprint(stage),
+        targetFingerprint: 'unmounted',
+        target: null,
+      },
+    };
+  }
+
+  const scene = node.getClientRect({ relativeTo: stage });
+  const scaleX = stage.scaleX();
+  const scaleY = stage.scaleY();
+  const stageRect = {
+    x: stage.x() + scene.x * scaleX,
+    y: stage.y() + scene.y * scaleY,
+    width: scene.width * Math.abs(scaleX),
+    height: scene.height * Math.abs(scaleY),
+  };
+  const containerRect = stage.container().getBoundingClientRect();
+  const viewportRect = {
+    x: containerRect.left + stageRect.x,
+    y: containerRect.top + stageRect.y,
+    width: stageRect.width,
+    height: stageRect.height,
+  };
+
+  // Typed geometry schema v2 is published only for the circle-warped Text
+  // representation. Every other target keeps the ordinary (5-A) contract.
+  let geometryV2: ArtworkVerificationGeometryV2 | undefined;
+  let hitPoint = findHitPoint(stage, node, stageRect, containerRect);
+  const warped = projectWarpedTarget(stage, generation, id);
+  if (warped !== null && warped.record !== null) {
+    geometryV2 = warped.record;
+    const measured = measureStageCssFacts(stage);
+    if (measured.ok) {
+      const resolved = findWarpedHitPoint({
+        stage,
+        targetNode: node,
+        browserClientQuad: warped.record.representation.browserClientCss,
+        cssRatios: measured.facts.cssRatios,
+        containerRect: {
+          left: measured.facts.containerRect.left,
+          top: measured.facts.containerRect.top,
+        },
+      });
+      if ('failure' in resolved) {
+        hitPoint = undefined;
+      } else {
+        hitPoint = resolved;
+      }
+    } else {
+      hitPoint = undefined;
+    }
+  }
+
+  return {
+    observation,
+    id,
+    konvaId,
+    mounted: true,
+    sceneRect: {
+      x: scene.x,
+      y: scene.y,
+      width: scene.width,
+      height: scene.height,
+    },
+    stageRect,
+    viewportRect,
+    hitPoint,
+    visible: node.isVisible(),
+    listening: node.isListening(),
+    renderer: {
+      bridgeGeneration: generation,
+      stageFingerprint: stageRendererFingerprint(stage),
+      targetFingerprint: targetRendererFingerprint(stage, node),
+      target: targetTransformProvenance(node),
+    },
+    ...(geometryV2 === undefined ? {} : { geometryV2 }),
+  };
+}
+
+interface RasterRecordOverrides {
+  observation?: ArtworkVerificationObservationCursor;
+  mounted: boolean;
+  status: ArtworkVerificationRasterV2Status;
+  reason?: ArtworkVerificationRasterV2Reason | ArtworkVerificationRasterV3Reason;
+  source?: ArtworkVerificationRasterSourceV2 | null;
+  rendered?: ArtworkVerificationRasterRenderedV2 | null;
+  capture?: ArtworkImageRasterV3['capture'];
+  rasterFingerprint?: string;
+  generic?: {
+    nodeType: string | null;
+    drawnWidth: number | null;
+    drawnHeight: number | null;
+    sourceWidth: number | null;
+    sourceHeight: number | null;
+  };
+}
+
+/**
+ * Accepted Image arm builder (ADR 0017 R11). The accepted v2 Image authority is
+ * preserved field-for-field; schema 3 and the explicit `image-source-v2`
+ * authority discriminant are the only changes.
+ */
+function imageRasterRecord(
+  stage: Konva.Stage,
+  generation: number,
+  started: ArtworkVerificationObservationCursor,
+  id: string,
+  kind: ArtworkVerificationKind,
+  node: Konva.Node | null,
+  overrides: RasterRecordOverrides,
+): ArtworkImageRasterV3 {
+  const observation = overrides.observation ?? started;
+  return {
+    rasterSchemaVersion: ARTWORK_VERIFICATION_RASTER_SCHEMA_VERSION,
+    authorityKind: 'image-source-v2',
+    observation,
+    id,
+    kind,
+    mounted: overrides.mounted,
+    status: overrides.status,
+    ...(overrides.reason === undefined ? {} : { reason: overrides.reason }),
+    source: overrides.source ?? null,
+    rendered: overrides.rendered ?? null,
+    renderer: {
+      bridgeGeneration: generation,
+      stageFingerprint: stageRendererFingerprint(stage),
+      targetFingerprint: node === null ? 'unmounted' : targetRendererFingerprint(stage, node),
+      target: node === null ? null : targetTransformProvenance(node),
+    },
+    capture: overrides.capture ?? {
+      started,
+      completed: started,
+      sourceStable: true,
+      rendererStable: true,
+    },
+    rasterFingerprint: overrides.rasterFingerprint ?? 'raster-unavailable',
+    ...(overrides.generic === undefined ? {} : overrides.generic),
+  };
+}
+
+interface GeneratedVectorRecordOverrides {
+  observation?: ArtworkVerificationObservationCursor;
+  mounted: boolean;
+  status: ArtworkVerificationRasterV2Status;
+  reason?: ArtworkVerificationRasterV2Reason | ArtworkVerificationRasterV3Reason;
+  capture: ArtworkGeneratedVectorRasterCaptureV3;
+  region?: ArtworkGeneratedVectorRasterRegionV3 | null;
+  rendered?: ArtworkGeneratedVectorRasterRenderedV3 | null;
+  rasterFingerprint?: string;
+}
+
+/** Generated-vector projection arm builder (ADR 0017 R12). */
+function generatedVectorRasterRecord(
+  stage: Konva.Stage,
+  generation: number,
+  id: string,
+  node: Konva.Node | null,
+  overrides: GeneratedVectorRecordOverrides,
+): ArtworkGeneratedVectorRasterV3 {
+  return {
+    rasterSchemaVersion: ARTWORK_VERIFICATION_RASTER_SCHEMA_VERSION,
+    authorityKind: 'generated-vector-projection-v1',
+    observation: overrides.observation ?? overrides.capture.started,
+    id,
+    kind: 'crossword',
+    mounted: overrides.mounted,
+    status: overrides.status,
+    ...(overrides.reason === undefined ? {} : { reason: overrides.reason }),
+    capture: overrides.capture,
+    region: overrides.region ?? null,
+    rendered: overrides.rendered ?? null,
+    renderer: {
+      bridgeGeneration: generation,
+      stageFingerprint: stageRendererFingerprint(stage),
+      targetFingerprint: node === null ? 'unmounted' : targetRendererFingerprint(stage, node),
+      target: node === null ? null : targetTransformProvenance(node),
+    },
+    rasterFingerprint: overrides.rasterFingerprint ?? 'raster-unavailable',
+  };
+}
+
+interface GeneratedVectorBounds {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+}
+
+/** Reads the mounted target's finite client bounds, or `null` when unusable. */
+function readGeneratedVectorBounds(node: Konva.Node): GeneratedVectorBounds | null {
+  let rect: { x: number; y: number; width: number; height: number } | null = null;
+  try {
+    rect = node.getClientRect();
+  } catch {
+    return null;
+  }
+  if (rect === null) return null;
+  const { x, y, width, height } = rect;
+  if (
+    ![x, y, width, height].every((value) => typeof value === 'number' && Number.isFinite(value))
+  ) {
+    return null;
+  }
+  if (width <= 0 || height <= 0) return null;
+  return { x, y, width, height };
+}
+
+/** Releases an owned transient projection canvas; never throws. */
+function releaseProjectionCanvas(canvas: HTMLCanvasElement | null): void {
+  if (canvas === null) return;
+  try {
+    canvas.width = 0;
+    canvas.height = 0;
+  } catch {
+    // A hostile/exotic canvas may reject dimension writes; the reference is
+    // still dropped when this function returns.
+  }
+}
+
+/**
+ * Read-only generated-vector projection acquisition (ADR 0017 R12).
+ *
+ * The authority is a bounded projection of the exact mounted live Konva target
+ * through its own representation (`konva-mounted-node-to-canvas-v1`) into an
+ * owned transient canvas at DPR 1. It is never a screenshot of the composited
+ * viewport, never an AABB-only assertion, never a reconstructed product-data
+ * render, and never a hidden duplicate renderer. The transient canvas is
+ * released on success, failure, and torn exits; only the RGBA digest, counts and
+ * dimensions are retained.
+ */
+async function generatedVectorRasterEvidence(
+  stage: Konva.Stage,
+  generation: number,
+  id: string,
+  node: Konva.Node | null,
+): Promise<ArtworkGeneratedVectorRasterV3> {
+  const started = readCursor(generation);
+
+  if (node === null) {
+    return generatedVectorRasterRecord(stage, generation, id, null, {
+      mounted: false,
+      status: 'pending',
+      reason: 'culled-or-not-rendered',
+      capture: {
+        method: ARTWORK_VERIFICATION_MOUNTED_NODE_PROJECTION_METHOD,
+        started,
+        completed: started,
+        rendererStable: true,
+        boundsStable: true,
+      },
+    });
+  }
+
+  const startBounds = readGeneratedVectorBounds(node);
+  const visible = safeBoolean(() => node.isVisible());
+  if (!visible) {
+    return generatedVectorRasterRecord(stage, generation, id, node, {
+      mounted: true,
+      status: 'failed',
+      reason: 'target-not-visible',
+      capture: {
+        method: ARTWORK_VERIFICATION_MOUNTED_NODE_PROJECTION_METHOD,
+        started,
+        completed: started,
+        rendererStable: true,
+        boundsStable: true,
+      },
+    });
+  }
+  if (startBounds === null) {
+    return generatedVectorRasterRecord(stage, generation, id, node, {
+      mounted: true,
+      status: 'failed',
+      reason: 'bounds-unusable',
+      capture: {
+        method: ARTWORK_VERIFICATION_MOUNTED_NODE_PROJECTION_METHOD,
+        started,
+        completed: started,
+        rendererStable: true,
+        boundsStable: true,
+      },
+    });
+  }
+
+  // The region publishes the exact mounted target bounds in stage-viewport CSS
+  // pixels (ADR 0017 R12/R14): the projection rasterizes the same bounds at the
+  // explicit `ARTWORK_VERIFICATION_GENERATED_VECTOR_PROJECTION_PIXEL_RATIO`, and
+  // the integer backing dimensions stay in `rendered`. Reporting the
+  // unquantized CSS bounds here is what lets the Oracle require edge/point
+  // agreement with the live target geometry within `RENDER_TRANSFORM_CSS`
+  // (0.25 CSS px) instead of accepting floor/ceil quantization drift.
+  const region: ArtworkGeneratedVectorRasterRegionV3 = {
+    coordinateSpace: ARTWORK_VERIFICATION_GENERATED_VECTOR_COORDINATE_SPACE,
+    x: startBounds.x,
+    y: startBounds.y,
+    width: startBounds.width,
+    height: startBounds.height,
+    backingScaleX: ARTWORK_VERIFICATION_GENERATED_VECTOR_PROJECTION_PIXEL_RATIO,
+    backingScaleY: ARTWORK_VERIFICATION_GENERATED_VECTOR_PROJECTION_PIXEL_RATIO,
+  };
+  // The exact projection quantization (ADR 0017 R12) is derived from the same
+  // region the record publishes: crop origin `floor(x), floor(y)` and integer
+  // backing `ceil(width × scaleX) × ceil(height × scaleY)`.
+  const quantization = generatedVectorProjectionQuantization(region);
+  const x = quantization.originX;
+  const y = quantization.originY;
+  const requestedWidth = quantization.backingWidth;
+  const requestedHeight = quantization.backingHeight;
+
+  let canvas: HTMLCanvasElement | null = null;
+  let rendered: ArtworkGeneratedVectorRasterRenderedV3;
+  try {
+    canvas = node.toCanvas({
+      x,
+      y,
+      width: requestedWidth,
+      height: requestedHeight,
+      pixelRatio: ARTWORK_VERIFICATION_GENERATED_VECTOR_PROJECTION_PIXEL_RATIO,
+    });
+    const backingWidth = canvas.width;
+    const backingHeight = canvas.height;
+    // Fail closed on any canvas whose backing does not equal the exact
+    // quantization of the region it claims to have projected. A record can
+    // therefore never publish a region/backing pair that disagrees.
+    if (
+      !Number.isSafeInteger(backingWidth) ||
+      !Number.isSafeInteger(backingHeight) ||
+      backingWidth <= 0 ||
+      backingHeight <= 0 ||
+      backingWidth !== quantization.backingWidth ||
+      backingHeight !== quantization.backingHeight
+    ) {
+      throw new Error(
+        'The mounted-node projection canvas backing does not match the exact region quantization.',
+      );
+    }
+    const context = canvas.getContext('2d');
+    if (!context) throw new Error('The mounted-node projection canvas exposes no 2D context.');
+    const rgba = context.getImageData(0, 0, backingWidth, backingHeight).data;
+    const rgbaByteLength = rgba.byteLength;
+    const rgbaSha256 = await sha256Hex(rgba);
+    const nonTransparentPixelCount = countNonTransparentPixels(rgba);
+    rendered = {
+      backingWidth,
+      backingHeight,
+      rgbaByteLength,
+      rgbaSha256,
+      nonTransparentPixelCount,
+    };
+  } catch {
+    return generatedVectorRasterRecord(stage, generation, id, node, {
+      mounted: true,
+      status: 'failed',
+      reason: 'projection-unreadable',
+      capture: {
+        method: ARTWORK_VERIFICATION_MOUNTED_NODE_PROJECTION_METHOD,
+        started,
+        completed: readCursor(generation),
+        rendererStable: false,
+        boundsStable: false,
+      },
+    });
+  } finally {
+    releaseProjectionCanvas(canvas);
+  }
+
+  // ── End bracket (R0/R1): every retained reference must agree. ────────────
+  const completed = readCursor(generation);
+  const endSceneNode = layoutItemsToNodes(useArtworkEditorStore.getState().layoutItems).nodes[id];
+  const endNode = endSceneNode ? findKonvaNode(stage, endSceneNode) : null;
+  const endBounds = endNode === null ? null : readGeneratedVectorBounds(endNode);
+  const observationStable =
+    completed.documentId === started.documentId &&
+    completed.documentEpoch === started.documentEpoch &&
+    completed.bridgeVersion === started.bridgeVersion &&
+    completed.bridgeGeneration === started.bridgeGeneration &&
+    completed.revision === started.revision;
+  const rendererStable =
+    endNode !== null &&
+    endNode === node &&
+    targetRendererFingerprint(stage, endNode) === targetRendererFingerprint(stage, node);
+  const boundsStable =
+    endBounds !== null &&
+    endBounds.x === startBounds.x &&
+    endBounds.y === startBounds.y &&
+    endBounds.width === startBounds.width &&
+    endBounds.height === startBounds.height;
+  const capture: ArtworkGeneratedVectorRasterCaptureV3 = {
+    method: ARTWORK_VERIFICATION_MOUNTED_NODE_PROJECTION_METHOD,
+    started,
+    completed,
+    rendererStable,
+    boundsStable,
+  };
+  const rasterFingerprint = buildGeneratedVectorRasterFingerprint({
+    id,
+    rgbaSha256: rendered.rgbaSha256,
+    targetNodeIdentity: objectIdentity(node),
+    backingWidth: rendered.backingWidth,
+    backingHeight: rendered.backingHeight,
+    originX: x,
+    originY: y,
+    regionWidth: region.width,
+    regionHeight: region.height,
+    backingScaleX: region.backingScaleX,
+    backingScaleY: region.backingScaleY,
+  });
+
+  if (!observationStable || !rendererStable || !boundsStable) {
+    return generatedVectorRasterRecord(stage, generation, id, node, {
+      observation: completed,
+      mounted: true,
+      status: 'torn',
+      reason: observationStable ? 'renderer-changed' : 'observation-changed',
+      capture,
+      region,
+      rendered,
+      rasterFingerprint,
+    });
+  }
+
+  if (rendered.nonTransparentPixelCount <= 0) {
+    return generatedVectorRasterRecord(stage, generation, id, node, {
+      observation: completed,
+      mounted: true,
+      status: 'failed',
+      reason: 'empty-raster-source',
+      capture,
+      region,
+      rendered,
+      rasterFingerprint,
+    });
+  }
+
+  return generatedVectorRasterRecord(stage, generation, id, node, {
+    observation: completed,
+    mounted: true,
+    status: 'ready',
+    capture,
+    region,
+    rendered,
+    rasterFingerprint,
+  });
+}
+
+/**
+ * Read-only raster authority acquisition (bridge v7 / ADR 0017 R11–R12).
+ *
+ * - a Crossword target routes to the generated-vector projection arm;
+ * - an empty placeholder is `not-applicable` before any node is considered;
+ * - an upload authority requires exactly one live canvas-backed Konva Image;
+ * - the current blob source is fetched and SHA-256 hashed in the page;
+ * - the exact canvas attached to the live Konva Image is read via `getImageData`;
+ * - start/end source, node, canvas, cursor and renderer facts must agree or the
+ *   record is `torn`;
+ * - every `ImageBitmap` is closed in `finally`; nothing is stored or mutated.
+ */
+async function rasterEvidenceV3(
+  stage: Konva.Stage,
+  generation: number,
+  id: string,
+): Promise<ArtworkVerificationRasterV3> {
+  const started = readCursor(generation);
+  const state = useArtworkEditorStore.getState();
+  const sceneNode = layoutItemsToNodes(state.layoutItems).nodes[id];
+  if (!sceneNode) {
+    throw new Error(`Artwork verification element not found: ${id}`);
+  }
+
+  const kind = kindFromType(sceneNode.type);
+  const node = findKonvaNode(stage, sceneNode);
+  if (kind === 'crossword') {
+    return generatedVectorRasterEvidence(stage, generation, id, node);
+  }
+  if (!node) {
+    return imageRasterRecord(stage, generation, started, id, kind, null, {
+      mounted: false,
+      status: 'pending',
+      reason: 'culled-or-not-rendered',
+    });
+  }
+
+  const facts = readCanonicalLayerFacts(id);
+  const isUploadAuthority = kind === 'image' && facts.exists && facts.placeholder;
+
+  if (!isUploadAuthority) {
+    // Generic readiness projection for non-upload image-like elements.
+    const imageNode = findKonvaImageNode(node);
+    if (!imageNode) {
+      return imageRasterRecord(stage, generation, started, id, kind, node, {
+        mounted: true,
+        status: 'not-applicable',
+        reason: 'no-raster-node',
+        generic: {
+          nodeType: node.getClassName(),
+          drawnWidth: null,
+          drawnHeight: null,
+          sourceWidth: null,
+          sourceHeight: null,
+        },
+      });
+    }
+    const source = (imageNode.image() ?? null) as ArtworkVerificationRasterSource | null;
+    const { width, height } = measureRasterSource(source);
+    const status = classifyArtworkVerificationRaster(source);
+    return imageRasterRecord(stage, generation, started, id, kind, node, {
+      mounted: true,
+      status,
+      ...(status === 'failed' ? { reason: 'empty-raster-source' as const } : {}),
+      generic: {
+        nodeType: imageNode.getClassName(),
+        drawnWidth: safeNumber(() => imageNode.width()),
+        drawnHeight: safeNumber(() => imageNode.height()),
+        sourceWidth: width,
+        sourceHeight: height,
+      },
+    });
+  }
+
+  const enumeration = collectRasterNodes(node);
+  const decision = classifyCanonicalImageAuthority({
+    placeholder: facts.placeholder,
+    testedWithImage: facts.testedWithImage,
+    hasSource: facts.src !== null,
+    blobScheme: isBlobSchemeSource(facts.src),
+    rasterNodeCount: enumeration.all.length,
+    canvasBackedNodeCount: enumeration.canvasBacked.length,
+  });
+  if (!decision.acquire) {
+    return imageRasterRecord(stage, generation, started, id, kind, node, {
+      mounted: true,
+      status: decision.status,
+      ...(decision.reason === null ? {} : { reason: decision.reason }),
+    });
+  }
+
+  const imageNode = enumeration.canvasBacked[0] as Konva.Image;
+  const canvas = imageNode.image() as HTMLCanvasElement;
+  const sourceUrl = facts.src as string;
+
+  let bytes: ArrayBuffer;
+  let mimeType: string;
+  try {
+    const response = await fetch(sourceUrl);
+    if (!response.ok) throw new Error(`Blob source responded ${response.status}.`);
+    mimeType = response.headers.get('content-type') ?? 'application/octet-stream';
+    bytes = await response.arrayBuffer();
+  } catch {
+    return imageRasterRecord(stage, generation, started, id, kind, node, {
+      mounted: true,
+      status: 'failed',
+      reason: 'source-unreadable',
+    });
+  }
+
+  const sha256 = await sha256Hex(bytes);
+
+  let bitmap: ImageBitmap;
+  try {
+    bitmap = await createImageBitmap(new Blob([bytes], { type: mimeType }));
+  } catch {
+    return imageRasterRecord(stage, generation, started, id, kind, node, {
+      mounted: true,
+      status: 'failed',
+      reason: 'source-unreadable',
+    });
+  }
+
+  try {
+    const decodedWidth = bitmap.width;
+    const decodedHeight = bitmap.height;
+    const backingWidth = canvas.width;
+    const backingHeight = canvas.height;
+
+    const sourceFingerprint = buildRasterSourceFingerprint({
+      sha256,
+      byteLength: bytes.byteLength,
+      mimeType,
+      decodedWidth,
+      decodedHeight,
+    });
+    const source: ArtworkVerificationRasterSourceV2 = {
+      scheme: 'blob',
+      mimeType,
+      byteLength: bytes.byteLength,
+      sha256,
+      decodedWidth,
+      decodedHeight,
+      sourceFingerprint,
+    };
+
+    let rgba: Uint8ClampedArray;
+    try {
+      const context = canvas.getContext('2d');
+      if (!context) throw new Error('The live raster canvas exposes no 2D context.');
+      rgba = context.getImageData(0, 0, backingWidth, backingHeight).data;
+    } catch {
+      return imageRasterRecord(stage, generation, started, id, kind, node, {
+        mounted: true,
+        status: 'failed',
+        reason: 'canvas-tainted',
+        source,
+      });
+    }
+
+    const rgbaByteLength = rgba.byteLength;
+    const rgbaSha256 = await sha256Hex(rgba);
+    const nonTransparentPixelCount = countNonTransparentPixels(rgba);
+    const probes = sampleRasterProbes({ rgba, width: backingWidth, height: backingHeight });
+    const drawnWidth = safeNumber(() => imageNode.width()) ?? 0;
+    const drawnHeight = safeNumber(() => imageNode.height()) ?? 0;
+
+    const rasterFingerprint = buildRasterFingerprint({
+      id,
+      sourceFingerprint,
+      rgbaSha256,
+      targetNodeIdentity: objectIdentity(node),
+      imageNodeIdentity: objectIdentity(imageNode),
+      canvasIdentity: objectIdentity(canvas),
+      backingWidth,
+      backingHeight,
+      drawnWidth,
+      drawnHeight,
+    });
+
+    const rendered: ArtworkVerificationRasterRenderedV2 = {
+      nodeClass: 'Image',
+      drawnWidth,
+      drawnHeight,
+      backingWidth,
+      backingHeight,
+      rgbaByteLength,
+      rgbaSha256,
+      nonTransparentPixelCount,
+      probes,
+    };
+
+    // ── End bracket (supervisor R4): every retained reference must agree. ────
+    const completed = readCursor(generation);
+    const endFacts = readCanonicalLayerFacts(id);
+    const endSceneNode = layoutItemsToNodes(useArtworkEditorStore.getState().layoutItems).nodes[id];
+    const endNode = endSceneNode ? findKonvaNode(stage, endSceneNode) : null;
+    const endEnumeration = endNode ? collectRasterNodes(endNode) : { all: [], canvasBacked: [] };
+    const endImageNode = endEnumeration.canvasBacked[0] ?? endEnumeration.all[0] ?? null;
+    let endDrawable: unknown = null;
+    try {
+      endDrawable = endImageNode ? endImageNode.image() : null;
+    } catch {
+      endDrawable = null;
+    }
+
+    const observationStable =
+      completed.documentId === started.documentId &&
+      completed.documentEpoch === started.documentEpoch &&
+      completed.bridgeVersion === started.bridgeVersion &&
+      completed.bridgeGeneration === started.bridgeGeneration &&
+      completed.revision === started.revision;
+    const sourceStable = endFacts.src === sourceUrl;
+    const nodeStable =
+      endNode === node &&
+      endImageNode === imageNode &&
+      endDrawable !== null &&
+      endDrawable === canvas;
+    const rendererStable =
+      endNode !== null &&
+      targetRendererFingerprint(stage, endNode) === targetRendererFingerprint(stage, node);
+
+    const capture = {
+      started,
+      completed,
+      sourceStable: sourceStable && nodeStable,
+      rendererStable,
+    };
+
+    if (!observationStable || !sourceStable || !nodeStable || !rendererStable) {
+      return imageRasterRecord(stage, generation, started, id, kind, node, {
+        observation: completed,
+        mounted: true,
+        status: 'torn',
+        reason: 'observation-changed',
+        source,
+        rendered,
+        capture,
+        rasterFingerprint,
+      });
+    }
+
+    if (
+      decodedWidth <= 0 ||
+      decodedHeight <= 0 ||
+      backingWidth <= 0 ||
+      backingHeight <= 0 ||
+      nonTransparentPixelCount <= 0
+    ) {
+      return imageRasterRecord(stage, generation, started, id, kind, node, {
+        observation: completed,
+        mounted: true,
+        status: 'failed',
+        reason: 'empty-raster-source',
+        source,
+        rendered,
+        capture,
+        rasterFingerprint,
+      });
+    }
+
+    return imageRasterRecord(stage, generation, started, id, kind, node, {
+      observation: completed,
+      mounted: true,
+      status: 'ready',
+      source,
+      rendered,
+      capture,
+      rasterFingerprint,
+    });
+  } finally {
+    bitmap.close();
+  }
+}
+
+function doctor(stage: Konva.Stage, generation: number): ArtworkVerificationDoctor {
+  const observation = readCursor(generation);
+  const current = snapshot(observation);
+  const nodes = Object.values(current.contentNodes);
+  return {
+    enabled: true,
+    version: BRIDGE_VERSION,
+    observation,
+    methods: [...ARTWORK_VERIFICATION_READ_ONLY_METHODS],
+    route: current.route,
+    document: current.document,
+    stage: {
+      mounted: true,
+      width: stage.width(),
+      height: stage.height(),
+      layerNames: stage.getLayers().map((layer) => layer.name()),
+    },
+    state: {
+      rootCount: current.rootIds.length,
+      scenegraphRootCount: current.scenegraphRootIds.length,
+      nodeCount: nodes.length,
+      layoutCount: nodes.filter((node) => node.type === 'FRAME').length,
+      layerCount: nodes.filter((node) => node.type !== 'FRAME').length,
+      scenegraphInSync: current.scenegraphInSync,
+    },
+    readiness: {
+      fonts: 'fonts' in document ? document.fonts.status : 'unsupported',
+      gestureActive: canvasGestureState.active,
+      isPanning: current.isPanning,
+      optimisticSelection: current.optimisticSelectedLayerId !== null,
+    },
+  };
+}
+
+function elements(
+  stage: Konva.Stage,
+  generation: number,
+  selector: ArtworkVerificationSelector = {},
+): ArtworkVerificationElementsResult {
+  const observation = readCursor(generation);
+  const current = snapshot(observation);
+  const mountedIds = new Set(
+    Object.values(current.contentNodes)
+      .filter((node) => findKonvaNode(stage, node) !== null)
+      .map((node) => node.id),
+  );
+  return {
+    observation,
+    elements: filterArtworkVerificationElements(
+      current.contentNodes,
+      mountedIds,
+      current.selectedLayoutIds,
+      current.selectedLayerIds,
+      selector,
+    ),
+  };
+}
+
+function nextAnimationFrame(): Promise<void> {
+  return new Promise((resolve) => requestAnimationFrame(() => resolve()));
+}
+
+/**
+ * Target-aware renderer quiescence (supervisor R6). When `targets` is supplied,
+ * a stable frame requires unchanged observation revision/document/generation,
+ * inactive gesture/panning, every relevant target mounted/visible/listening, and
+ * an unchanged deterministic renderer fingerprint for the relevant geometry. A
+ * no-target call remains available for Doctor/precondition diagnostics but
+ * cannot establish post-action geometry quiescence.
+ */
+async function waitForIdle(
+  stage: Konva.Stage,
+  generation: number,
+  options: {
+    timeoutMs?: number;
+    stableFrames?: number;
+    targets?: readonly string[];
+    nested?: { targetId: string; witnessId: string; layoutId: string };
+  } = {},
+): Promise<ArtworkVerificationIdleResult> {
+  const timeoutMs = options.timeoutMs ?? DEFAULT_IDLE_TIMEOUT_MS;
+  const requiredStableFrames = options.stableFrames ?? 3;
+  const targetIds = [...(options.targets ?? [])];
+  const nested = options.nested;
+  const startedAt = performance.now();
+
+  if ('fonts' in document) {
+    await Promise.race([
+      document.fonts.ready,
+      new Promise<never>((_, reject) =>
+        setTimeout(
+          () => reject(new Error('Artwork verification timed out waiting for fonts.')),
+          timeoutMs,
+        ),
+      ),
+    ]);
+  }
+
+  let previousObservation = '';
+  let previousRenderer = '';
+  let stableFrames = 0;
+
+  while (performance.now() - startedAt <= timeoutMs) {
+    await nextAnimationFrame();
+    const observation = readCursor(generation);
+    const state = useArtworkEditorStore.getState();
+    const renderer = rendererFingerprint(stage, generation, targetIds, nested);
+    // The nested witness is deliberately rendered through a non-listening group
+    // (ADR 0013 R1): readiness requires it mounted and visible, but only the
+    // drag target must be listening.
+    const targetsReady =
+      targetIds.length === 0 ||
+      renderer.targets.every(
+        (target) =>
+          target.mounted &&
+          target.visible &&
+          (target.listening || (nested !== undefined && target.id === nested.witnessId)),
+      );
+    const observationKey = `${observation.documentId}:${observation.documentEpoch}:${observation.bridgeGeneration}:${observation.revision}`;
+    const rendererKey = JSON.stringify(renderer);
+    const canBeIdle = !canvasGestureState.active && !state.isPanning;
+
+    if (
+      canBeIdle &&
+      targetsReady &&
+      observationKey === previousObservation &&
+      rendererKey === previousRenderer
+    ) {
+      stableFrames += 1;
+    } else {
+      stableFrames = 1;
+    }
+
+    if (stableFrames >= requiredStableFrames) {
+      return {
+        idle: true,
+        waitedMs: Math.round(performance.now() - startedAt),
+        stableFrames,
+        observation,
+        snapshot: snapshot(observation),
+        renderer,
+      };
+    }
+
+    previousObservation = observationKey;
+    previousRenderer = rendererKey;
+  }
+
+  throw new Error(
+    `Artwork verification did not become idle within ${timeoutMs}ms ` +
+      `(stableFrames=${stableFrames}, gesture=${canvasGestureState.active}, ` +
+      `panning=${useArtworkEditorStore.getState().isPanning}).`,
+  );
+}
+
+function validateCursorRecord(cursor: ArtworkVerificationObservationCursor): void {
+  if (cursor === null || typeof cursor !== 'object') {
+    throw new ArtworkVerificationBridgeContractError(
+      'CURSOR_INVALID',
+      'waitForChange requires a cursor object.',
+    );
+  }
+  if (cursor.schemaVersion !== ARTWORK_VERIFICATION_CURSOR_SCHEMA_VERSION) {
+    throw new ArtworkVerificationBridgeContractError(
+      'CURSOR_SCHEMA_MISMATCH',
+      `Unsupported observation cursor schema ${String(cursor.schemaVersion)}.`,
+    );
+  }
+  if (typeof cursor.documentId !== 'string' || cursor.documentId.length === 0) {
+    throw new ArtworkVerificationBridgeContractError(
+      'CURSOR_INVALID',
+      'Cursor documentId is invalid.',
+    );
+  }
+  if (!Number.isSafeInteger(cursor.documentEpoch) || cursor.documentEpoch < 1) {
+    throw new ArtworkVerificationBridgeContractError(
+      'CURSOR_INVALID',
+      'Cursor documentEpoch is invalid.',
+    );
+  }
+  if (cursor.bridgeVersion !== BRIDGE_VERSION) {
+    throw new ArtworkVerificationBridgeContractError(
+      'CURSOR_BRIDGE_VERSION_MISMATCH',
+      `Cursor bridge version ${String(cursor.bridgeVersion)} does not match ${BRIDGE_VERSION}.`,
+    );
+  }
+  if (!Number.isSafeInteger(cursor.bridgeGeneration) || cursor.bridgeGeneration < 1) {
+    throw new ArtworkVerificationBridgeContractError(
+      'CURSOR_INVALID',
+      'Cursor bridgeGeneration is invalid.',
+    );
+  }
+  if (!Number.isSafeInteger(cursor.revision) || cursor.revision < 0) {
+    throw new ArtworkVerificationBridgeContractError(
+      'CURSOR_INVALID',
+      'Cursor revision is invalid.',
+    );
+  }
+}
+
+function validateWaitForChangeOptions(options: ArtworkVerificationWaitForChangeOptions): void {
+  if (options === null || typeof options !== 'object') {
+    throw new ArtworkVerificationBridgeContractError(
+      'WAIT_OPTIONS_INVALID',
+      'waitForChange requires { after, timeoutMs }.',
+    );
+  }
+  if (
+    !Number.isInteger(options.timeoutMs) ||
+    !Number.isFinite(options.timeoutMs) ||
+    options.timeoutMs < 0 ||
+    options.timeoutMs > MAX_WAIT_TIMEOUT_MS
+  ) {
+    throw new ArtworkVerificationBridgeContractError(
+      'WAIT_TIMEOUT_INVALID',
+      `waitForChange timeoutMs must be an integer in 0..${MAX_WAIT_TIMEOUT_MS}.`,
+    );
+  }
+}
+
+async function waitForChange(
+  generation: number,
+  options: ArtworkVerificationWaitForChangeOptions,
+): Promise<ArtworkVerificationWaitForChangeResult> {
+  const startedAt = performance.now();
+  validateWaitForChangeOptions(options);
+  validateCursorRecord(options.after);
+  const waited = () => Math.round(performance.now() - startedAt);
+
+  if (options.after.bridgeGeneration !== generation) {
+    return {
+      status: 'invalidated',
+      reason: 'bridge-generation-mismatch',
+      cursor: null,
+      waitedMs: waited(),
+    };
+  }
+
+  let wake: ArtworkVerificationSignalWake;
+  try {
+    wake = await waitForArtworkVerificationChange({
+      generation,
+      after: {
+        documentId: options.after.documentId,
+        documentEpoch: options.after.documentEpoch,
+        bridgeGeneration: options.after.bridgeGeneration,
+        revision: options.after.revision,
+      },
+      timeoutMs: options.timeoutMs,
+    });
+  } catch (error) {
+    if (error instanceof ArtworkVerificationSignalError) {
+      return { status: 'invalidated', reason: error.reason, cursor: null, waitedMs: waited() };
+    }
+    throw error;
+  }
+
+  if (wake.kind === 'invalidated') {
+    return { status: 'invalidated', reason: wake.reason, cursor: null, waitedMs: waited() };
+  }
+  const cursor = cursorFromFacts(wake.cursor);
+  if (wake.kind === 'timeout') {
+    return { status: 'timeout', cursor, waitedMs: waited() };
+  }
+  return { status: 'changed', cursor, wakeSource: wake.wakeSource, waitedMs: waited() };
+}
+
+export function installArtworkVerificationBridge(stage: Konva.Stage): () => void {
+  if (!isArtworkVerificationEnabled()) return () => {};
+
+  const generation = beginArtworkVerificationSignalGeneration();
+
+  const bridge: ArtworkVerificationBridge = {
+    version: BRIDGE_VERSION,
+    doctor: (): ArtworkVerificationDoctor => doctor(stage, generation),
+    snapshot: (): ArtworkVerificationSnapshot => snapshot(readCursor(generation)),
+    elements: (selector): ArtworkVerificationElementsResult =>
+      elements(stage, generation, selector),
+    geometry: (request): ArtworkVerificationGeometry =>
+      geometryRequest(stage, generation, request, readCursor(generation)),
+    raster: (id): Promise<ArtworkVerificationRasterV3> => rasterEvidenceV3(stage, generation, id),
+    cursor: (): ArtworkVerificationObservationCursor => readCursor(generation),
+    waitForChange: (options): Promise<ArtworkVerificationWaitForChangeResult> =>
+      waitForChange(generation, options),
+    waitForIdle: (options): Promise<ArtworkVerificationIdleResult> =>
+      waitForIdle(stage, generation, options),
+  };
+
+  // The published surface is frozen: no later code can add or replace an
+  // observation method, so the read-only allowlist cannot drift at runtime.
+  Object.freeze(bridge);
+
+  window.__MAKEIT_ARTWORK_VERIFICATION__ = bridge;
+
+  let cleaned = false;
+  return () => {
+    if (cleaned) return;
+    cleaned = true;
+    endArtworkVerificationSignalGeneration(generation);
+    if (window.__MAKEIT_ARTWORK_VERIFICATION__ === bridge) {
+      delete window.__MAKEIT_ARTWORK_VERIFICATION__;
+    }
+  };
+}
