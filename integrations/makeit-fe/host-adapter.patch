+import assert from 'node:assert/strict';
+import { mkdtempSync, mkdirSync, realpathSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { afterEach, test } from 'node:test';
+
+import {
+  artworkEvidenceRootFor,
+  prepareArtworkEvidenceRoot,
+  prepareArtworkVerificationWorkspace,
+} from './verify-artwork-paths.mjs';
+
+const temporaryRoots = [];
+
+afterEach(() => {
+  for (const root of temporaryRoots.splice(0)) {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+function temporaryRepo() {
+  const root = realpathSync(mkdtempSync(join(tmpdir(), 'makeit-artwork-evidence-root-')));
+  temporaryRoots.push(root);
+  return root;
+}
+
+test('places FE runtime evidence outside the skill and toolkit source trees', () => {
+  const repoRoot = temporaryRepo();
+
+  assert.equal(
+    artworkEvidenceRootFor(repoRoot),
+    join(repoRoot, 'artwork-editor-verification', 'evidence'),
+  );
+});
+
+test('provisions the canonical FE-owned evidence base', () => {
+  const repoRoot = temporaryRepo();
+
+  assert.equal(
+    prepareArtworkEvidenceRoot(repoRoot),
+    join(repoRoot, 'artwork-editor-verification', 'evidence'),
+  );
+});
+
+test('scaffolds the complete application-owned verifier workspace idempotently', () => {
+  const repoRoot = temporaryRepo();
+
+  const first = prepareArtworkVerificationWorkspace(repoRoot);
+  const second = prepareArtworkVerificationWorkspace(repoRoot);
+
+  assert.deepEqual(second, first);
+  assert.equal(first.runsRoot, join(repoRoot, 'artwork-editor-verification', 'evidence', 'runs'));
+  assert.equal(
+    first.suitesRoot,
+    join(repoRoot, 'artwork-editor-verification', 'evidence', 'suites'),
+  );
+  assert.equal(first.reportsRoot, join(repoRoot, 'artwork-editor-verification', 'reports'));
+  assert.equal(first.requestsRoot, join(repoRoot, 'artwork-editor-verification', 'requests'));
+});
+
+test('refuses a symlinked verification directory', () => {
+  const repoRoot = temporaryRepo();
+  const externalRoot = temporaryRepo();
+  symlinkSync(externalRoot, join(repoRoot, 'artwork-editor-verification'));
+
+  assert.throws(() => prepareArtworkEvidenceRoot(repoRoot), /must contain only real directories/);
+});
+
+test('refuses a non-directory evidence path', () => {
+  const repoRoot = temporaryRepo();
+  mkdirSync(join(repoRoot, 'artwork-editor-verification'));
+  writeFileSync(join(repoRoot, 'artwork-editor-verification', 'evidence'), 'not a directory');
+
+  assert.throws(() => prepareArtworkEvidenceRoot(repoRoot), /must contain only real directories/);
+});
