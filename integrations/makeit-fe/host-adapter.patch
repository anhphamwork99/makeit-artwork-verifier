diff --git a/scripts/artwork-verification-gap.mjs b/scripts/artwork-verification-gap.mjs
new file mode 100644
index 00000000..18e4a35d
--- /dev/null
+++ b/scripts/artwork-verification-gap.mjs
@@ -0,0 +1,235 @@
+#!/usr/bin/env node
+
+import { lstatSync, mkdirSync, readFileSync, realpathSync, writeFileSync } from 'node:fs';
+import { basename, dirname, isAbsolute, join, relative, resolve, sep } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+import { prepareArtworkVerificationWorkspace } from './verify-artwork-paths.mjs';
+
+const repoRoot = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const SOURCE_KINDS = new Set(['file', 'inline-json', 'natural-language', 'url']);
+const BLOCKER_KINDS = new Set([
+  'AMBIGUOUS_REQUEST',
+  'CASE_SCHEMA_UNSUPPORTED',
+  'CAPABILITY_UNSUPPORTED',
+  'CORRECTNESS_ROUTE_MISSING',
+  'FIXTURE_MISSING',
+  'ORACLE_MISSING',
+  'SCENARIO_UNSUPPORTED',
+  'SUBJECT_UNSUPPORTED',
+  'WORKFLOW_MISSING',
+]);
+const MAX_GAP_INPUT_BYTES = 1024 * 1024;
+
+function requiredText(value, field) {
+  if (typeof value !== 'string' || value.trim().length === 0) {
+    throw new Error(`${field} must be a non-empty string.`);
+  }
+  return value.trim();
+}
+
+export function sanitizeSourceReference(kind, reference) {
+  if (reference === null || reference === undefined || reference === '') return null;
+  const text = requiredText(reference, 'source.reference');
+  if (kind !== 'url') return text;
+  const url = new URL(text);
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password) {
+    throw new Error('source.reference must be a safe HTTP(S) URL without credentials.');
+  }
+  return `${url.origin}${url.pathname}`;
+}
+
+export function validateGapRequest(value) {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    throw new Error('gap request must be an object.');
+  }
+  if (value.schemaVersion !== 1) throw new Error('schemaVersion must be 1.');
+  if (!value.source || !SOURCE_KINDS.has(value.source.kind)) {
+    throw new Error('source.kind is unsupported.');
+  }
+  const blockers = value.blockers;
+  if (!Array.isArray(blockers) || blockers.length === 0) {
+    throw new Error('blockers must contain at least one verification gap.');
+  }
+  return {
+    schemaVersion: 1,
+    source: {
+      kind: value.source.kind,
+      reference: sanitizeSourceReference(value.source.kind, value.source.reference),
+    },
+    requestedBehavior: {
+      title: requiredText(value.requestedBehavior?.title, 'requestedBehavior.title'),
+      summary: requiredText(value.requestedBehavior?.summary, 'requestedBehavior.summary'),
+      steps: Array.isArray(value.requestedBehavior?.steps)
+        ? value.requestedBehavior.steps.map((step, index) =>
+            requiredText(step, `requestedBehavior.steps[${index}]`),
+          )
+        : [],
+      expectations: Array.isArray(value.requestedBehavior?.expectations)
+        ? value.requestedBehavior.expectations.map((expectation, index) =>
+            requiredText(expectation, `requestedBehavior.expectations[${index}]`),
+          )
+        : [],
+    },
+    attemptedMapping: {
+      subjectId: value.attemptedMapping?.subjectId ?? null,
+      capability: value.attemptedMapping?.capability ?? null,
+      scenario: value.attemptedMapping?.scenario ?? null,
+      variant: value.attemptedMapping?.variant ?? null,
+    },
+    blockers: blockers.map((blocker, index) => {
+      if (!blocker || !BLOCKER_KINDS.has(blocker.kind)) {
+        throw new Error(`blockers[${index}].kind is unsupported.`);
+      }
+      return {
+        kind: blocker.kind,
+        detail: requiredText(blocker.detail, `blockers[${index}].detail`),
+      };
+    }),
+    recommendation: 'maintain-verification-skills',
+    recommendationProject: {
+      repository: 'anhphamwork99/makeit-artwork-verifier',
+      path: '.planning/maintain-verification-skills/PROJECT.md',
+    },
+  };
+}
+
+function list(items, empty) {
+  if (items.length === 0) return `- ${empty}`;
+  return items.map((item) => `- ${item}`).join('\n');
+}
+
+export function buildGapReport(gap, gapFileName) {
+  const mapping = Object.entries(gap.attemptedMapping)
+    .filter(([, value]) => value)
+    .map(([key, value]) => `${key}: \`${value}\``);
+  return `# Verification gap — chưa thể chạy test case
+
+## Kết luận
+
+Test case đã được phân tích nhưng verifier hiện chưa có đủ contract để chạy một
+browser verification đáng tin cậy. Không có product bug hoặc PASS nào được kết luận.
+
+## Nhu cầu cần kiểm tra
+
+- Tên: ${gap.requestedBehavior.title}
+- Mô tả: ${gap.requestedBehavior.summary}
+- Nguồn: \`${gap.source.kind}\`${gap.source.reference ? ` — ${gap.source.reference}` : ''}
+
+## Các bước người dùng
+
+${list(gap.requestedBehavior.steps, 'Chưa xác định được bước thao tác cụ thể.')}
+
+## Kỳ vọng
+
+${list(gap.requestedBehavior.expectations, 'Chưa xác định được expectation cụ thể.')}
+
+## Mapping đã thử
+
+${list(mapping, 'Chưa map được vào Subject/Capability/Scenario hiện có.')}
+
+## Phần verifier còn thiếu
+
+${list(
+  gap.blockers.map((blocker) => `\`${blocker.kind}\` — ${blocker.detail}`),
+  'Không có blocker được ghi nhận.',
+)}
+
+## Bước tiếp theo
+
+Chuyển report này vào Project Home
+\`anhphamwork99/makeit-artwork-verifier:.planning/maintain-verification-skills/PROJECT.md\`
+để bổ sung hoặc điều chỉnh Subject, Capability, Workflow, Fixture, Oracle, Case
+Request và skill contract cần thiết. Chỉ chạy lại test case sau khi static
+planning PASS.
+
+## Artifact
+
+- Structured gap: [${gapFileName}](./${gapFileName})
+`;
+}
+
+export function writeGapBundle({ reportsRoot, reportId, gap }) {
+  const bundleRoot = join(reportsRoot, reportId);
+  mkdirSync(bundleRoot, { recursive: false, mode: 0o700 });
+  const gapPath = join(bundleRoot, 'verification-gap.json');
+  const reportPath = join(bundleRoot, 'report.md');
+  writeFileSync(gapPath, `${JSON.stringify(gap, null, 2)}\n`, { mode: 0o600 });
+  writeFileSync(reportPath, buildGapReport(gap, basename(gapPath)), { mode: 0o600 });
+  return { bundleRoot, gapPath, reportPath };
+}
+
+export function readGapInput(input, requestsRoot) {
+  const canonicalRoot = realpathSync(requestsRoot);
+  const candidate = isAbsolute(input) ? resolve(input) : resolve(repoRoot, input);
+  const canonicalInput = realpathSync(candidate);
+  const relativePath = relative(canonicalRoot, canonicalInput);
+  if (
+    relativePath === '' ||
+    relativePath === '..' ||
+    relativePath.startsWith(`..${sep}`) ||
+    isAbsolute(relativePath)
+  ) {
+    throw new Error('gap input must be a file under artwork-editor-verification/requests/.');
+  }
+  const stat = lstatSync(canonicalInput);
+  if (!stat.isFile() || stat.isSymbolicLink() || stat.size > MAX_GAP_INPUT_BYTES) {
+    throw new Error('gap input must be a bounded regular file.');
+  }
+  return JSON.parse(readFileSync(canonicalInput, 'utf8'));
+}
+
+function usage(message) {
+  process.stderr.write(`${message}\n`);
+  process.stderr.write('Usage: pnpm verify:artwork:gap --input <gap.json>\n');
+  process.exit(64);
+}
+
+function isDirectRun() {
+  return process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url);
+}
+
+if (isDirectRun()) {
+  const args = process.argv.slice(2);
+  if (args.length !== 2 || args[0] !== '--input' || !args[1]) {
+    usage('Provide exactly one normalized verification-gap input file.');
+  }
+  try {
+    const workspace = prepareArtworkVerificationWorkspace(repoRoot);
+    const gap = validateGapRequest(readGapInput(args[1], workspace.requestsRoot));
+    const timestamp = new Date().toISOString().replace(/[-:.]/g, '');
+    const reportId = `${timestamp}-verification-gap-${process.pid}`;
+    const bundle = writeGapBundle({
+      reportsRoot: workspace.reportsRoot,
+      reportId,
+      gap,
+    });
+    process.stdout.write(
+      `${JSON.stringify(
+        {
+          status: 'VERIFICATION_GAP',
+          reportPath: bundle.reportPath,
+          gapPath: bundle.gapPath,
+          detail:
+            'The requested behavior is not safely executable by the current verifier. No browser run was started.',
+        },
+        null,
+        2,
+      )}\n`,
+    );
+    process.exitCode = 2;
+  } catch (error) {
+    process.stdout.write(
+      `${JSON.stringify(
+        {
+          status: 'USAGE',
+          reportPath: null,
+          detail: error instanceof Error ? error.message : String(error),
+        },
+        null,
+        2,
+      )}\n`,
+    );
+    process.exitCode = 64;
+  }
+}
