+      expect(pointInConvexQuad(aabbCenter, rotated)).toBe(true);
+      expect(pointInConvexQuad(aabbInteriorOutsideQuad, rotated)).toBe(false);
+      expect(quadArea(rotated)).toBeCloseTo(quadArea(UNIT_QUAD), 9);
+    });
