+/**
+ * Seam-only raster evidence helper (WP5 Slice 5-C bridge v5).
+ *
+ * This module owns the closed, versioned raster-authority vocabulary the read-only
+ * bridge publishes through `raster(id)`:
+ *
+ *  - raster schema v2 identity and the manifest-neutral `rgba-probes-v1` probe set;
+ *  - the exact probe-to-backing-pixel sampling math;
+ *  - canonical Image-semantics classification (empty placeholder vs upload raster);
+ *  - byte/pixel hashing and one-way equality fingerprints.
+ *
+ * It is deliberately product-independent: it knows probe positions and the
+ * sampling algorithm only. It never knows resource ids, manifests, expected
+ * colors, expected outcomes, or the URL/bytes of any fixture. It performs no
+ * store, history, React, Konva, canvas, or product mutation.
+ */
+
+import { fnv1a64Hex } from '@/lib/artwork/verification/geometryProjection';
+
+/**
+ * Raster record schema this helper builds (bridge v7 / ADR 0017 R11).
+ *
+ * Slice 5-E moves the live schema to v3 as a closed union: the accepted Image
+ * arm (`image-source-v2`) and the new bounded generated-vector projection arm
+ * (`generated-vector-projection-v1`). Schema v2 remains readable as durable
+ * legacy evidence but is never published live.
+ */
+export const ARTWORK_VERIFICATION_RASTER_SCHEMA_VERSION = 3;
+
+/** Durable legacy raster schema (v2, bridge v5). Read-only, never republished. */
+export const ARTWORK_VERIFICATION_RASTER_LEGACY_SCHEMA_VERSION = 2;
+
+/**
+ * Seam-unique live raster schema discriminant (ADR 0017 R11). Only this module
+ * declares it, so a production chunk containing it proves a reachable seam.
+ */
+export const ARTWORK_VERIFICATION_RASTER_DISCRIMINANT_MARKER =
+  'makeit.artwork-verification.raster.v3';
+
+/** Closed authority-kind discriminant for the raster v3 union (ADR 0017 R11). */
+export const ARTWORK_VERIFICATION_RASTER_AUTHORITY_KINDS = [
+  'image-source-v2',
+  'generated-vector-projection-v1',
+] as const;
+export type ArtworkVerificationRasterAuthorityKind =
+  (typeof ARTWORK_VERIFICATION_RASTER_AUTHORITY_KINDS)[number];
+
+/**
+ * The mounted-node projection method the generated-vector arm publishes
+ * (ADR 0017 R12). Seam-unique so the production scan can prove absence.
+ */
+export const ARTWORK_VERIFICATION_MOUNTED_NODE_PROJECTION_METHOD =
+  'konva-mounted-node-to-canvas-v1';
+
+/** Coordinate space of a generated-vector projection region (ADR 0017 R12). */
+export const ARTWORK_VERIFICATION_GENERATED_VECTOR_COORDINATE_SPACE = 'stage-viewport-css';
+
+/** Versioned, manifest-neutral probe set identifier. */
+export const ARTWORK_VERIFICATION_PROBE_SET_ID = 'rgba-probes-v1';
+
+export interface ArtworkVerificationProbeRational {
+  numerator: number;
+  denominator: number;
+}
+
+export interface ArtworkVerificationProbeDefinition {
+  id: string;
+  x: ArtworkVerificationProbeRational;
+  y: ArtworkVerificationProbeRational;
+}
+
+/**
+ * The one closed probe set the bridge owns (supervisor R3). Four normalized
+ * rationals chosen to sit inside uniform colour regions of the two checked-in
+ * fixtures; the bridge knows the positions but no expected channel values.
+ */
+export const ARTWORK_VERIFICATION_RASTER_PROBES: readonly ArtworkVerificationProbeDefinition[] =
+  Object.freeze([
+    {
+      id: 'upper-left',
+      x: { numerator: 1, denominator: 16 },
+      y: { numerator: 1, denominator: 12 },
+    },
+    {
+      id: 'upper-right',
+      x: { numerator: 11, denominator: 16 },
+      y: { numerator: 1, denominator: 12 },
+    },
+    { id: 'lower-left', x: { numerator: 1, denominator: 16 }, y: { numerator: 3, denominator: 4 } },
+    {
+      id: 'lower-right',
+      x: { numerator: 11, denominator: 16 },
+      y: { numerator: 3, denominator: 4 },
+    },
+  ]);
+
+export type ArtworkVerificationRasterV2Status =
+  | 'not-applicable'
+  | 'pending'
+  | 'ready'
+  | 'failed'
+  | 'torn';
+
+export type ArtworkVerificationRasterV2Reason =
+  | 'culled-or-not-rendered'
+  | 'no-raster-node'
+  | 'empty-raster-source'
+  | 'source-unreadable'
+  | 'canvas-tainted'
+  | 'observation-changed'
+  | 'renderer-changed'
+  | 'ambiguous-raster-node'
+  | 'non-canvas-raster-source';
+
+export interface ArtworkVerificationRasterProbeResult {
+  probeSetId: string;
+  probeId: string;
+  x: ArtworkVerificationProbeRational;
+  y: ArtworkVerificationProbeRational;
+  backingX: number;
+  backingY: number;
+  rgba: readonly [number, number, number, number];
+}
+
+export interface ArtworkVerificationRasterSourceV2 {
+  scheme: 'blob';
+  mimeType: string;
+  byteLength: number;
+  sha256: string;
+  decodedWidth: number;
+  decodedHeight: number;
+  sourceFingerprint: string;
+}
+
+export interface ArtworkVerificationRasterRenderedV2 {
+  nodeClass: 'Image';
+  drawnWidth: number;
+  drawnHeight: number;
+  backingWidth: number;
+  backingHeight: number;
+  rgbaByteLength: number;
+  rgbaSha256: string;
+  nonTransparentPixelCount: number;
+  probes: readonly ArtworkVerificationRasterProbeResult[];
+}
+
+/** Structural observation cursor published by every bridge payload. */
+export interface ArtworkVerificationRasterObservationView {
+  schemaVersion: number;
+  documentId: string;
+  documentEpoch: number;
+  bridgeVersion: number;
+  bridgeGeneration: number;
+  revision: number;
+}
+
+/** Structural typed renderer provenance published by the bridge. */
+export interface ArtworkVerificationRasterRendererView {
+  bridgeGeneration: number;
+  stageFingerprint: string;
+  targetFingerprint: string;
+  target: { id: string; nodeClass: string; x: number; y: number } | null;
+}
+
+export interface ArtworkVerificationRasterCaptureV2 {
+  started: ArtworkVerificationRasterObservationView;
+  completed: ArtworkVerificationRasterObservationView;
+  sourceStable: boolean;
+  rendererStable: boolean;
+}
+
+/**
+ * Durable legacy raster authority record (raster schema v2, bridge v5). It is
+ * never published live by bridge v7: schema-v2 records remain explicitly
+ * readable as immutable legacy evidence, while every live read resolves to the
+ * schema-v3 closed union below. The generic readiness fields are retained so
+ * non-upload image-like elements and Doctor reflection keep their accepted
+ * projection.
+ */
+export interface ArtworkVerificationRasterV2 {
+  rasterSchemaVersion: 2;
+  observation: ArtworkVerificationRasterObservationView;
+  id: string;
+  kind: string;
+  mounted: boolean;
+  status: ArtworkVerificationRasterV2Status;
+  reason?: ArtworkVerificationRasterV2Reason;
+  source: ArtworkVerificationRasterSourceV2 | null;
+  rendered: ArtworkVerificationRasterRenderedV2 | null;
+  renderer: ArtworkVerificationRasterRendererView;
+  capture: ArtworkVerificationRasterCaptureV2;
+  rasterFingerprint: string;
+  nodeType?: string | null;
+  drawnWidth?: number | null;
+  drawnHeight?: number | null;
+  sourceWidth?: number | null;
+  sourceHeight?: number | null;
+}
+
+/**
+ * Accepted Image arm of the raster v3 union (ADR 0017 R11). It is the accepted
+ * v2 Image authority — source bytes, bitmap closure, RGBA pixels, probes,
+ * currentness and failure semantics — carried under schema 3 with the explicit
+ * `image-source-v2` authority discriminant. This is semantic compatibility, not
+ * byte identity: the schema number and the union discriminant necessarily
+ * change.
+ */
+export interface ArtworkImageRasterV3 {
+  rasterSchemaVersion: 3;
+  authorityKind: 'image-source-v2';
+  observation: ArtworkVerificationRasterObservationView;
+  id: string;
+  kind: string;
+  mounted: boolean;
+  status: ArtworkVerificationRasterV2Status;
+  reason?: ArtworkVerificationRasterV2Reason | ArtworkVerificationRasterV3Reason;
+  source: ArtworkVerificationRasterSourceV2 | null;
+  rendered: ArtworkVerificationRasterRenderedV2 | null;
+  renderer: ArtworkVerificationRasterRendererView;
+  capture: ArtworkVerificationRasterCaptureV2;
+  rasterFingerprint: string;
+  nodeType?: string | null;
+  drawnWidth?: number | null;
+  drawnHeight?: number | null;
+  sourceWidth?: number | null;
+  sourceHeight?: number | null;
+}
+
+/** Additional v3 reasons that only the generated-vector arm can report. */
+export type ArtworkVerificationRasterV3Reason =
+  | 'target-not-visible'
