+export { ARTWORK_VERIFICATION_BRIDGE_VERSION };
+
+/**
+ * Closed read-only method vocabulary. The installed bridge exposes exactly these
+ * callables and nothing else, so no observation path can reach a mutating
+ * product action, and no framework subscription escapes the seam.
