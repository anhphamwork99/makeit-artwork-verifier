+
+interface FakeTransform {
+  copy(): FakeTransform;
+  invert(): FakeTransform;
+  multiply(other: FakeTransform): FakeTransform;
+  getMatrix(): number[];
+}
+
+function fakeTransform(initial: readonly number[]): FakeTransform {
+  let m = [...initial];
+  const api: FakeTransform = {
+    copy: () => fakeTransform([...m]),
+    invert: () => {
+      const [a, b, c, d, e, f] = m as [number, number, number, number, number, number];
+      const det = a * d - b * c;
+      m = [d / det, -b / det, -c / det, a / det, (c * f - d * e) / det, (b * e - a * f) / det];
+      return api;
+    },
+    multiply: (other) => {
+      const [A, B, C, D, E, F] = other.getMatrix() as [
+        number,
+        number,
+        number,
+        number,
+        number,
+        number,
+      ];
+      const [a, b, c, d, e, f] = m as [number, number, number, number, number, number];
+      m = [
+        a * A + c * B,
+        b * A + d * B,
+        a * C + c * D,
+        b * C + d * D,
+        a * E + c * F + e,
+        b * E + d * F + f,
+      ];
+      return api;
+    },
+    getMatrix: () => [...m],
+  };
+  return api;
+}
+
+function translation(tx: number, ty: number): FakeTransform {
+  return fakeTransform([1, 0, 0, 1, tx, ty]);
+}
+
+interface FakeNode {
+  id(): string;
+  name(): string;
+  getClassName(): string;
+  getTransform(): FakeTransform;
+  getAbsoluteTransform(top?: FakeNode): FakeTransform;
+  __absolute(): FakeTransform;
+  getParent(): FakeNode | null;
+  getLayer(): FakeNode | null;
+  isVisible(): boolean;
+  isListening(): boolean;
+}
+
+function fakeNode(options: {
+  id: string;
+  absolute: FakeTransform;
+  layer?: FakeNode | null;
+  className?: string;
+  name?: string;
+}): FakeNode {
+  const absoluteOf = (top?: FakeNode): FakeTransform => {
+    if (!top) return options.absolute.copy();
+    return options.absolute.copy().multiply(top.__absolute().copy().invert());
+  };
+  const root: FakeNode = {
+    id: () => 'world-scene',
+    name: () => '',
+    getClassName: () => 'Layer',
+    getTransform: () => fakeTransform([1, 0, 0, 1, 0, 0]),
+    getAbsoluteTransform: () => fakeTransform([1, 0, 0, 1, 0, 0]),
+    __absolute: () => fakeTransform([1, 0, 0, 1, 0, 0]),
+    getParent: () => null,
+    getLayer: () => null,
+    isVisible: () => true,
+    isListening: () => true,
+  };
+  const node: FakeNode = {
