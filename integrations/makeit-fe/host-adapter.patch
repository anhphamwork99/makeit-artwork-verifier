+    type: 'FRAME',
+    parentId: null,
+    children: ['text-1'],
+    name: 'Layout #1',
+    xCoordinate: 0,
+    yCoordinate: 0,
+    width: 500,
+    height: 500,
+    zCoordinate: 1,
+    rotation: 0,
+    background: {
+      mode: 'transparent',
