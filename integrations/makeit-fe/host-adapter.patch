+      input.id,
+      input.rgbaSha256,
+      String(input.targetNodeIdentity),
+      String(input.backingWidth),
+      String(input.backingHeight),
+      String(input.originX),
+      String(input.originY),
+      String(input.regionWidth),
+      String(input.regionHeight),
