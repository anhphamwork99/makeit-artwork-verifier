+
+describe('generic affine projection', () => {
+  it('composes affine maps as outer ∘ inner', () => {
+    const composed = multiplyAffine(translationAffine(5, 7), scaleAffine(2, 3));
+    expect(applyAffine(composed, { x: 1, y: 1 })).toEqual({ x: 7, y: 10 });
+    // The reverse order differs, proving the operator is not commutative.
+    const reversed = multiplyAffine(scaleAffine(2, 3), translationAffine(5, 7));
+    expect(applyAffine(reversed, { x: 1, y: 1 })).toEqual({ x: 12, y: 24 });
+  });
+
+  it('preserves translation, ±rotation, nonuniform scale, reflection, skew, and offset', () => {
+    const matrix: Affine2D = { a: 1.3, b: 0.2, c: -0.4, d: -0.9, e: 17, f: -23 };
+    const rotate = rotationAffine(0.3);
+    const composed = multiplyAffine(rotate, matrix);
+    // Composition semantics: outer ∘ inner applies inner first, then outer.
+    const point = { x: 0.7, y: -1.1 };
+    const viaComposition = applyAffine(composed, point);
+    const viaSequence = applyAffine(rotate, applyAffine(matrix, point));
+    expect(viaComposition.x).toBeCloseTo(viaSequence.x, 12);
+    expect(viaComposition.y).toBeCloseTo(viaSequence.y, 12);
+    for (const coefficient of ['a', 'b', 'c', 'd', 'e', 'f'] as const) {
+      expect(Number.isFinite(composed[coefficient])).toBe(true);
+    }
+    // Reflection and 180° rotation compose to the identity.
+    const reflectedTwice = multiplyAffine(scaleAffine(-1, 1), scaleAffine(-1, 1));
+    expect(reflectedTwice).toEqual({ a: 1, b: 0, c: 0, d: 1, e: 0, f: 0 });
+    expect(determinantAffine(scaleAffine(-1, 1))).toBe(-1);
+    expect(determinantParity(scaleAffine(-1, 1))).toBe(-1);
+    // A skew matrix keeps a finite nonzero skew magnitude through composition.
+    const skewed: Affine2D = { a: 1, b: 0, c: 0.35, d: 1, e: 0, f: 0 };
+    const skewedComposed = multiplyAffine(rotationAffine(0.2), skewed);
+    expect(skewedComposed.c).toBeCloseTo(Math.cos(0.2) * 0.35 - Math.sin(0.2), 12);
+    expect(determinantAffine(skewed)).toBeCloseTo(1, 12);
+    expect(determinantParity(rotationAffine(0.7))).toBe(1);
+  });
+
+  it('inverts finite affine maps and rejects singular ones', () => {
+    const matrix = multiplyAffine(translationAffine(11, -4), scaleAffine(2, 5));
+    const inverse = invertAffine(matrix);
+    expect(inverse).not.toBeNull();
+    if (inverse === null) return;
+    const roundTrip = multiplyAffine(inverse, matrix);
+    expect(roundTrip.a).toBeCloseTo(1, 12);
+    expect(roundTrip.d).toBeCloseTo(1, 12);
+    expect(roundTrip.e).toBeCloseTo(0, 12);
+    expect(roundTrip.f).toBeCloseTo(0, 12);
+
+    expect(invertAffine(scaleAffine(0, 1))).toBeNull();
+    expect(invertAffine(scaleAffine(1, 0))).toBeNull();
+    expect(invertAffine({ a: Number.NaN, b: 0, c: 0, d: 1, e: 0, f: 0 })).toBeNull();
+  });
