+export const ARTWORK_VERIFICATION_READ_ONLY_METHODS = [
+  'doctor',
+  'snapshot',
+  'elements',
+  'geometry',
+  'raster',
+  'cursor',
+  'waitForChange',
+  'waitForIdle',
