+    for (const layer of shadowLayers) {
+      expect(project(layer).representation.warpFingerprint).toBe(
+        base.representation.warpFingerprint,
+      );
+    }
+  });
+
+  it('treats a blur-only change as helper-neutral geometry', () => {
+    const a = withShadow('drop', { offset: 18, angle: 45, blur: 10 });
+    const b = withShadow('drop', { offset: 18, angle: 45, blur: 90 });
