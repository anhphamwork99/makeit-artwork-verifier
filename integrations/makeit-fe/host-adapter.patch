+        ...createDefaultCircleWarpPayload(DEFAULT_CIRCLE_WARP_RADIUS),
+        verticalAlign: 'top',
+      },
+    };
+    return layer;
+  }
+
+  function withShadow(
+    style: 'drop' | 'block' | 'line' | 'outline',
