+      ['drop shadow', withShadow('drop', { offset: 18, angle: 45 })],
+      ['block shadow', withShadow('block', { outlineWidth: 6 })],
+      ['outline shadow', withShadow('outline', { outlineWidth: 6 })],
+      ['top alignment + shadow', topAligned(withShadow('drop', { offset: 18, angle: 45 }))],
