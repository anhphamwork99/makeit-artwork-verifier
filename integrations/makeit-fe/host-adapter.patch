@@ -0,0 +1,52 @@
+/**
+ * Product-owned Artwork response normalization adapter (WP5 Slice 5-F; ADR 0021
+ * N1–N3).
+ *
+ * This is the sole response adapter. It composes the Node-importable semantic
+ * core with the real product response restorer (`artworkResponseToSnapshot`) so
+ * that a DTO's normalized meaning is produced by the same product code that
+ * restores an editor document. It owns no projection, canonicalization, hashing,
+ * ordering, raw-Crossword, or persistence-repair logic.
+ *
+ * It is intentionally NOT raw-Node importable: it owns the real browser/product
+ * restorer dependency. That limitation is explicit — the designated Node
+ * interface is `normalizedMeaningCore.ts`, and the CLI must import that core
+ * directly. Browser-aware consumers use the `normalizedMeaning.ts` facade.
+ */
+
+import type { ArtworkResponseDto } from '@/lib/api/types.gen';
+import { artworkResponseToSnapshot } from '@/lib/artwork/artworkSerialization';
+import {
+  NormalizedMeaningUnusableError,
+  normalizeArtworkProductMeaning,
+  type NormalizedArtworkMeaningV1,
+} from './normalizedMeaningCore';
+
+/** Private refusal plumbing: always throws the one core-owned error class. */
+function unusable(detail: string): never {
+  throw new NormalizedMeaningUnusableError(detail);
+}
+
+/**
+ * Normalize an `ArtworkResponseDto` into the same closed v1 product meaning by
+ * running the real product response restorer (`artworkResponseToSnapshot`) and
+ * projecting the restored snapshot. Receiving the outer
+ * `{ data, message, timestamp }` envelope is a refusal, never a silent unwrap.
+ */
+export function normalizeArtworkResponseMeaning(
+  dto: ArtworkResponseDto,
+): NormalizedArtworkMeaningV1 {
+  if (dto === null || typeof dto !== 'object') {
+    unusable('Artwork response DTO is not an object.');
+  }
+  const record = dto as unknown as Record<string, unknown>;
+  if (!Array.isArray(record.layouts)) {
+    if ('data' in record) {
+      unusable(
+        'normalizeArtworkResponseMeaning received the outer response envelope, not ArtworkResponseDto.',
+      );
+    }
+    unusable('Artwork response DTO exposes no layouts array.');
+  }
+  return normalizeArtworkProductMeaning(artworkResponseToSnapshot(dto));
+}
