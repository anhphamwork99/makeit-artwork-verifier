index 00000000..0ecf41fb
--- /dev/null
+++ b/src/lib/artwork/verification/normalizedMeaningCore.ts
@@ -0,0 +1,439 @@
+/**
+ * Product-owned normalized Artwork meaning — Node-importable semantic core
+ * (WP5 Slice 5-F; ADR 0019 R5–R7, ADR 0021 N1–N5/N7).
+ *
+ * This module answers one question with a closed, deterministic projection:
+ * *what does the seller's Artwork mean?* — independent of volatile client/server
+ * identity, transport envelopes, raw persistence encoding, and editor/runtime
+ * metadata.
+ *
+ * It is pure and deliberately Node-importable. Its only product runtime
+ * dependency is the import-free virtual-canvas constant leaf; its store
+ * dependency is a syntactically type-only import of the canonical snapshot type.
+ * It never imports the editor store singleton, the serializer/restorer, the
+ * observation bridge, the setup boundary, React, the router, a network client,
+ * or outcome logic.
+ *
+ * Response normalization lives in the sibling `normalizedMeaningResponse.ts`
+ * adapter, which composes this core with the real product restorer. Browser-aware
+ * consumers keep importing the `normalizedMeaning.ts` compatibility facade.
+ */
+
+// Relative, alias-free specifier so the Node/`tsx` product-meaning provider
+// export (ADR 0118) loads this core from an explicit app root without an
+// application path alias. Same module; no semantic change.
+import { CANVAS_LAYOUT_ID } from '../layoutDefaults';
+import type { ArtworkEditorSnapshot } from '@/stores/artworkEditorStore';
+
+/** Schema of the closed normalized projection. */
+export const NORMALIZED_MEANING_SCHEMA_VERSION = 1;
+
+/** Stable profile identity of the normalized projection. */
+export const NORMALIZED_MEANING_PROFILE_ID = 'artwork-product-meaning-v1';
+
+/** Diagnostic code carried by every refusal from this module. */
+export const NORMALIZED_MEANING_UNUSABLE_CODE = 'NORMALIZED_MEANING_UNUSABLE';
+
+/**
+ * Raised when the input cannot be given an unambiguous product meaning: cyclic
+ * or non-plain values, non-finite numbers, or a semantic image source that only
+ * exists as a transient browser blob. Refusal is deliberate — coercing such a
+ * value would let two different artworks collapse onto one normalized meaning.
+ */
+export class NormalizedMeaningUnusableError extends Error {
+  readonly code = NORMALIZED_MEANING_UNUSABLE_CODE;
+
+  constructor(detail: string) {
+    super(detail);
+    this.name = 'NormalizedMeaningUnusableError';
+  }
+}
+
+export interface NormalizedArtworkMeaningV1 {
+  schemaVersion: typeof NORMALIZED_MEANING_SCHEMA_VERSION;
+  profileId: typeof NORMALIZED_MEANING_PROFILE_ID;
+  layouts: NormalizedLayoutMeaningV1[];
+}
+
+export interface NormalizedLayoutMeaningV1 {
+  [key: string]: unknown; // design-allow-arbitrary: TypeScript index signature, not a Tailwind class.
+  layers: NormalizedLayerMeaningV1[];
+}
+
+export interface NormalizedLayerMeaningV1 {
+  [key: string]: unknown; // design-allow-arbitrary: TypeScript index signature, not a Tailwind class.
+}
+
+/** Bounded raw Crossword semantics extracted from an un-normalized payload/DTO. */
+export interface RawCrosswordSemanticPayloadV1 {
+  /** True: the extracted layer carried the persisted Crossword marker. */
+  marker: boolean;
+  generationSeed: number;
+  words: string[];
+  layout: Record<string, unknown>;
+}
+
+// ── Binding exclusion list (ADR 0019 R6 / design 4.3) ────────────────────────
+//
+// The following keys never participate in normalized equality. They are not
+// deleted from raw evidence; they simply cannot make normalized equality pass or
+// fail.
+//
+//   1. Editor-only structure: the virtual canvas Layout (`isCanvas`, id
+//      `__canvas__`), selection/camera/panel state, and history stacks.
+//   2. Volatile identity: Layout/layer/client/renderer/scenegraph ids and
+//      server-assigned database ids.
+//   3. Server identity and metadata: owner, timestamps, API envelope fields.
+//   4. Raw persistence representation: the complete raw layer `config` blob.
+//   5. Transient/runtime metadata: asset/file URLs, decode caches, and other
+//      transport artifacts.
+/**
+ * Keys dropped at every depth. `id` is retained only under a Star Map element
+ * list, where the id is a stable semantic role (e.g. `moon`) rather than a
+ * volatile record identity.
+ */
+const DROPPED_KEYS: ReadonlySet<string> = new Set([
+  'id',
+  'serverId',
+  'assetId',
+  'backgroundLayerId',
+  'ownerType',
+  'ownerId',
+  'createdAt',
+  'updatedAt',
+  'config',
+  'nodes',
+  'rootIds',
+  'activeLayoutId',
+  'selectedLayoutIds',
+  'isCanvas',
+  // Presentation/transport artifacts, not seller meaning.
+  'fileUrl',
+  'thumbnailDataUrl',
+  'editKnots',
+  'clientId',
+]);
+
+/** Keys whose string value must never be a transient browser blob URL. */
+const SOURCE_KEYS: ReadonlySet<string> = new Set([
+  'src',
+  'imageSrc',
+  'placeholderSrc',
+  'originalSrc',
+]);
+
+/** Semantic image flags lifted out of the raw `config` blob (ADR 0019 R6). */
+const IMAGE_CONFIG_FLAGS = ['placeholder', 'dynamic', 'allowUpload'] as const;
+
+function unusable(detail: string): never {
+  throw new NormalizedMeaningUnusableError(detail);
+}
+
+function formatPath(path: readonly string[]): string {
+  return path.length === 0 ? '<root>' : path.join('.');
+}
+
+function isPlainObject(value: object): boolean {
+  const prototype = Object.getPrototypeOf(value) as object | null;
+  return prototype === Object.prototype || prototype === null;
+}
+
+function dropKey(key: string, path: readonly string[]): boolean {
+  // The editor-only `Adjust Handle Mode` flag is not product meaning; the
+  // resting geometry it wraps is.
+  if (key === 'mode' && path.includes('warp')) return true;
+  if (!DROPPED_KEYS.has(key)) return false;
+  // Star Map element ids name a celestial role, not a volatile record.
+  if (key === 'id' && path.includes('starMap')) return false;
+  return true;
+}
+
+function projectValue(value: unknown, path: readonly string[], seen: Set<object>): unknown {
+  if (value === undefined) return undefined;
+  if (value === null) return null;
+  switch (typeof value) {
+    case 'boolean':
+      return value;
+    case 'number':
+      if (!Number.isFinite(value)) {
+        unusable(`Non-finite number at ${formatPath(path)}.`);
+      }
+      return Object.is(value, -0) ? 0 : value;
+    case 'string':
+      if (SOURCE_KEYS.has(path[path.length - 1] ?? '') && value.startsWith('blob:')) {
+        unusable(
+          `Transient blob source at ${formatPath(path)}; product meaning cannot depend on a browser object URL.`,
+        );
+      }
+      return value;
+    case 'object': {
+      const asObject = value as object;
+      if (seen.has(asObject)) {
+        unusable(`Cyclic value at ${formatPath(path)}.`);
+      }
+      seen.add(asObject);
+      try {
+        if (Array.isArray(value)) {
+          return value
+            .map((entry, index) => projectValue(entry, [...path, String(index)], seen))
+            .filter((entry) => entry !== undefined);
+        }
+        if (!isPlainObject(asObject)) {
+          unusable(`Non-plain object at ${formatPath(path)}.`);
+        }
+        const record = asObject as Record<string, unknown>;
+        const projected: Record<string, unknown> = {};
+        for (const key of Object.keys(record).sort()) {
+          if (dropKey(key, path)) continue;
+          const child = projectValue(record[key], [...path, key], seen);
+          if (child === undefined) continue;
+          projected[key] = child;
+        }
+        return projected;
+      } finally {
+        seen.delete(asObject);
+      }
+    }
+    default:
+      return unusable(`Unsupported ${typeof value} value at ${formatPath(path)}.`);
+  }
+}
+
+function readConfig(layer: unknown): Record<string, unknown> | null {
+  if (layer === null || typeof layer !== 'object') return null;
+  const config = (layer as { config?: unknown }).config;
+  if (config === null || typeof config !== 'object' || Array.isArray(config)) return null;
+  return config as Record<string, unknown>;
+}
+
+/**
+ * Project one layer. Image layers additionally lift their typed semantic flags
+ * and their seller-visible name out of the raw `config` blob, because the
+ * product treats `config.name` as the image layer's name (the persistence
+ * mapping and the response normalizer both read it there) while the top-level
+ * `name` field can hold a stale creation default.
+ */
+function projectLayer(layer: unknown, path: readonly string[]): NormalizedLayerMeaningV1 {
+  const projected = projectValue(layer, path, new Set()) as NormalizedLayerMeaningV1;
+  // Layer visibility/lock are semantic for every kind. They are emitted as
+  // explicit booleans so an absent value and a `false` value agree; the product
+  // persistence mapping only round-trips them for synthetic background layers,
+  // and a real `true` must still be visible to the Oracle.
+  projected.hidden = (layer as { hidden?: unknown } | null)?.hidden === true;
+  projected.locked = (layer as { locked?: unknown } | null)?.locked === true;
+  if (projected.type !== 'IMAGE') return projected;
+
+  const config = readConfig(layer);
+  for (const flag of IMAGE_CONFIG_FLAGS) {
+    projected[flag] = config?.[flag] === true;
+  }
+  const configName = config?.name;
+  const topLevelName = projected.name;
+  projected.name =
+    typeof configName === 'string'
+      ? configName
+      : typeof topLevelName === 'string'
+        ? topLevelName
+        : null;
+  return projected;
+}
+
+/** Deterministic canonical serialization used for tie-breaks and fingerprints. */
+export function canonicalizeNormalizedMeaning(value: unknown): string {
+  if (value === null) return 'null';
+  switch (typeof value) {
+    case 'boolean':
+      return value ? 'true' : 'false';
+    case 'number': {
+      if (!Number.isFinite(value)) unusable('Non-finite number in normalized meaning.');
+      return Object.is(value, -0) ? '0' : String(value);
+    }
+    case 'string':
+      return JSON.stringify(value);
+    case 'object': {
+      if (Array.isArray(value)) {
+        return `[${value.map(canonicalizeNormalizedMeaning).join(',')}]`;
+      }
+      const record = value as Record<string, unknown>;
+      const entries = Object.keys(record)
+        .sort()
+        .map((key) => `${JSON.stringify(key)}:${canonicalizeNormalizedMeaning(record[key])}`);
+      return `{${entries.join(',')}}`;
+    }
+    default:
+      return unusable(`Unsupported ${typeof value} value in normalized meaning.`);
+  }
+}
+
+function compareCanonical(a: unknown, b: unknown): number {
+  const left = canonicalizeNormalizedMeaning(a);
+  const right = canonicalizeNormalizedMeaning(b);
+  return left < right ? -1 : left > right ? 1 : 0;
+}
+
+function numericField(value: unknown, key: string): number {
+  const field = (value as Record<string, unknown> | null)?.[key];
+  return typeof field === 'number' && Number.isFinite(field) ? field : Number.NaN;
+}
+
+function stringField(value: unknown, key: string): string {
+  const field = (value as Record<string, unknown> | null)?.[key];
+  return typeof field === 'string' ? field : '';
+}
+
+/**
+ * Sibling ordering (design 4.2): normalized `zCoordinate` first, then the
+ * semantic kind and name, then canonical semantic bytes. Volatile ids never
+ * break a tie because they are not part of the projected value.
+ */
+function compareSiblings(a: unknown, b: unknown): number {
+  const zA = numericField(a, 'zCoordinate');
+  const zB = numericField(b, 'zCoordinate');
+  if (zA !== zB) {
+    if (Number.isNaN(zA)) return 1;
+    if (Number.isNaN(zB)) return -1;
+    return zA - zB;
+  }
+  const typeA = stringField(a, 'type');
+  const typeB = stringField(b, 'type');
+  if (typeA !== typeB) return typeA < typeB ? -1 : 1;
+  const nameA = stringField(a, 'name');
+  const nameB = stringField(b, 'name');
+  if (nameA !== nameB) return nameA < nameB ? -1 : 1;
+  return compareCanonical(a, b);
+}
+
+function isVirtualCanvasLayout(item: unknown): boolean {
+  if (item === null || typeof item !== 'object') return false;
+  const record = item as Record<string, unknown>;
+  return record.isCanvas === true || record.id === CANVAS_LAYOUT_ID;
+}
+
+function projectLayout(item: unknown): NormalizedLayoutMeaningV1 {
+  const projected = projectValue(item, ['layout'], new Set()) as NormalizedLayoutMeaningV1;
+  const rawLayers = (item as { layers?: unknown }).layers;
+  const layers = Array.isArray(rawLayers)
+    ? rawLayers
+        .filter((layer) => (layer as { type?: unknown } | null)?.type !== 'BACKGROUND')
+        .map((layer) => projectLayer(layer, ['layout', 'layers']))
+        .sort(compareSiblings)
+    : [];
+  return { ...projected, layers };
+}
+
+/**
+ * Normalize a live editor snapshot into the closed v1 product meaning.
+ *
+ * Layout order and sibling order are deterministic; the virtual canvas Layout
+ * and every declared excluded field are absent.
+ */
+export function normalizeArtworkProductMeaning(
+  snapshot: ArtworkEditorSnapshot,
+): NormalizedArtworkMeaningV1 {
+  if (snapshot === null || typeof snapshot !== 'object') {
+    unusable('Artwork snapshot is not an object.');
+  }
+  const items = (snapshot as { layoutItems?: unknown }).layoutItems;
+  if (!Array.isArray(items)) {
+    unusable('Artwork snapshot exposes no layoutItems array.');
+  }
+  const layouts = items
+    .filter((item) => !isVirtualCanvasLayout(item))
+    .map((item) => projectLayout(item))
+    .sort((a, b) => compareSiblings(a, b));
+  return {
+    schemaVersion: NORMALIZED_MEANING_SCHEMA_VERSION,
+    profileId: NORMALIZED_MEANING_PROFILE_ID,
+    layouts,
+  };
+}
+
+/**
+ * Deterministic 64-bit FNV-1a fingerprint of a normalized meaning.
+ *
+ * Four 16-bit little-endian limbs keep the hash exact without `BigInt`, which
+ * the ES2017 product target does not provide. This mirrors the product's
+ * existing `fnv1a64Hex` arithmetic.
+ */
+export function fingerprintNormalizedMeaning(value: unknown): string {
+  const canonical = canonicalizeNormalizedMeaning(value);
+  const limbs: number[] = [...FNV1A64_OFFSET];
+  for (let index = 0; index < canonical.length; index += 1) {
+    limbs[0] = (limbs[0] ^ (canonical.charCodeAt(index) & 0xffff)) >>> 0;
+    const products = [
+      limbs[0] * FNV1A64_PRIME[0],
+      limbs[1] * FNV1A64_PRIME[0],
+      limbs[2] * FNV1A64_PRIME[0] + limbs[0] * FNV1A64_PRIME[2],
+      limbs[3] * FNV1A64_PRIME[0] + limbs[1] * FNV1A64_PRIME[2],
+    ];
+    let carry = 0;
+    for (let limb = 0; limb < 4; limb += 1) {
+      const total = (products[limb] as number) + carry;
+      limbs[limb] = total % 0x10000;
+      carry = Math.floor(total / 0x10000);
+    }
+  }
+  return [3, 2, 1, 0].map((limb) => (limbs[limb] as number).toString(16).padStart(4, '0')).join('');
+}
+
+/** FNV-1a 64-bit in four 16-bit little-endian limbs (ES2017: no BigInt). */
+const FNV1A64_OFFSET = [0x2325, 0x8422, 0x9ce4, 0xcbf2] as const;
+const FNV1A64_PRIME = [0x01b3, 0x0000, 0x0100, 0x0000] as const;
+
+/**
+ * Persisted Crossword marker key. This mirrors the encoding constant owned by
+ * `artworkSerialization.ts`; the extractor reads the raw payload, so it must
+ * name the persisted marker rather than import an editor-time guard.
+ */
+const RAW_CROSSWORD_MARKER_KEY = 'isArtworkCrosswordLayer';
+
+/** The raw persisted Crossword config of a layer, or `null`. */
+function crosswordConfigOf(layer: unknown): Record<string, unknown> | null {
+  const config = readConfig(layer);
+  if (config?.[RAW_CROSSWORD_MARKER_KEY] !== true) return null;
+  const crossword = config.crossword;
+  if (crossword === null || typeof crossword !== 'object' || Array.isArray(crossword)) return null;
+  return crossword as Record<string, unknown>;
+}
+
+/**
+ * Extract the bounded raw Crossword semantics from an un-normalized create
+ * payload or response DTO (ADR 0019 R7). This is a named raw check over bounded
+ * extracted data — never an unrestricted string search — and it reads raw
+ * values exactly as persisted, including the generation seed that normalized
+ * meaning deliberately treats as an opaque typed property.
+ *
+ * Layouts are visited in payload order; the first persisted Crossword layer
+ * wins. Returns `null` when the value carries no Crossword layer.
+ */
+export function extractRawCrosswordSemanticPayload(
+  value: unknown,
+): RawCrosswordSemanticPayloadV1 | null {
+  if (value === null || typeof value !== 'object') return null;
+  const layouts = (value as { layouts?: unknown }).layouts;
+  if (!Array.isArray(layouts)) return null;
+
+  for (const layout of layouts) {
+    const layers = (layout as { layers?: unknown } | null)?.layers;
+    if (!Array.isArray(layers)) continue;
+    for (const layer of layers) {
+      const crossword = crosswordConfigOf(layer);
+      if (crossword === null) continue;
+      const seed = crossword.generationSeed;
+      const words = crossword.words;
+      const layoutValue = crossword.layout;
+      if (typeof seed !== 'number' || !Number.isFinite(seed)) continue;
+      if (!Array.isArray(words) || !words.every((word) => typeof word === 'string')) continue;
+      if (layoutValue === null || typeof layoutValue !== 'object' || Array.isArray(layoutValue)) {
+        continue;
+      }
+      return {
+        marker: true,
+        generationSeed: seed,
+        words: [...(words as string[])],
+        layout: structuredClone(layoutValue) as Record<string, unknown>,
+      };
+    }
+  }
+  return null;
+}
diff --git a/src/lib/artwork/verification/normalizedMeaningResponse.ts b/src/lib/artwork/verification/normalizedMeaningResponse.ts
