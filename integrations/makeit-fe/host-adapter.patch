+'use client';
+
+import type Konva from 'konva';
+
+import { getTextLayerFramePadding } from '@/hooks/artwork/editor/warpText/useArtworkTextFrameGeometry';
+import type { ArtworkTextCircleWarpPayload } from '@/lib/artwork/textEngine/core/types';
+import type { ArtworkTextLayer } from '@/stores/artworkEditorStore';
+import {
+  affinePreimage,
+  bilinearPoint,
+  canonicalScalar,
+  distanceToQuadEdges,
+  fnv1a64Hex,
+  HIT_POINT_CANDIDATE_UVS,
+  HIT_POINT_INSET_CSS_PX,
+  isFiniteAffine,
+  measureStageCssFacts,
