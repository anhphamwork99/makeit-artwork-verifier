@@ -0,0 +1,76 @@
+import { existsSync, mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+export function extractResultEnvelope(text) {
+  const start = text.indexOf('{');
+  if (start < 0) throw new Error('command did not return a JSON result envelope.');
+  return JSON.parse(text.slice(start));
+}
+
+export function validateVersionSmoke(envelope) {
+  if (
+    envelope?.status !== 'PASS' ||
+    envelope?.exitCode !== 0 ||
+    typeof envelope?.detail !== 'string' ||
+    !envelope.detail.startsWith('makeit-artwork-verifier ')
+  ) {
+    throw new Error('version smoke check returned an unexpected result.');
+  }
+  return envelope.detail;
+}
+
+export function validatePlanSmoke(envelope) {
+  if (
+    envelope?.status !== 'PASS' ||
+    envelope?.exitCode !== 0 ||
+    envelope?.launchAttempted !== false ||
+    envelope?.details?.launchability?.launchable !== true
+  ) {
+    throw new Error('planning smoke check did not produce a launchable PASS.');
+  }
+  return {
+    caseId: envelope.details.caseId,
+    planFingerprint: envelope.details.planFingerprint,
+  };
+}
+
+export function parseChromiumProbe(text) {
+  const envelope = extractResultEnvelope(text);
+  return {
+    ready: envelope?.ready === true,
+    executablePath: typeof envelope?.executablePath === 'string' ? envelope.executablePath : null,
+  };
+}
+
+export const CHROMIUM_PROBE_SOURCE = `
+import { existsSync } from 'node:fs';
+import { chromium } from '@playwright/test';
+const executablePath = chromium.executablePath();
+process.stdout.write(JSON.stringify({
+  ready: existsSync(executablePath),
+  executablePath,
+}));
+`;
+
+export function createSmokeDirectory() {
+  return mkdtempSync(join(tmpdir(), 'makeit-artwork-verifier-smoke-'));
+}
+
+export function removeSmokeDirectory(directory) {
+  rmSync(directory, { recursive: true, force: true });
+}
+
+export function canonicalSmokeCase(toolkitRoot) {
+  const casePath = join(
+    toolkitRoot,
+    'cases',
+    'diagnostic',
+    'requests',
+    'layer-text-move-drag-ordinary.json',
+  );
+  if (!existsSync(casePath)) {
+    throw new Error('canonical planning smoke case is unavailable.');
+  }
+  return casePath;
+}
diff --git a/scripts/artwork-verifier-readiness.test.mjs b/scripts/artwork-verifier-readiness.test.mjs
