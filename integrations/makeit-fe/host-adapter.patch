+    source: 'live-konva-hit-v1' as const,
+    hitClassification: 'target' as const,
+  };
+}
+
+function frame(
+  overrides: Partial<NestedObjectFrameFacts> & { id: string },
+): NestedObjectFrameFacts {
+  return {
+    kind: 'object',
+    parentId: LAYOUT_ID,
+    x: 0,
+    y: 0,
+    width: 100,
+    height: 50,
+    rotationDegrees: 0,
+    flipX: false,
+    flipY: false,
+    ...overrides,
+  };
+}
+
+const WITNESS = frame({
+  id: 'text-witness',
+  kind: 'text',
+  parentId: 'object-inner',
+  x: 24,
+  y: 31,
+  width: 128,
+  height: 56,
+  rotationDegrees: 11,
+});
+const INNER = frame({
+  id: 'object-inner',
+  parentId: 'object-outer',
+  x: 68,
+  y: 54,
+  width: 190,
+  height: 150,
+  rotationDegrees: -17,
+});
+const OUTER = frame({
+  id: 'object-outer',
+  parentId: LAYOUT_ID,
+  x: 105,
+  y: 85,
+  width: 330,
+  height: 280,
+  rotationDegrees: 24,
+});
+const CHAIN = [WITNESS, INNER, OUTER];
+
+// ── Konva doubles ───────────────────────────────────────────────────────────
+
+function fakeNode(
+  id: string,
+  relative: number[],
+  extra: {
+    layer?: Konva.Node | null;
+    children?: Konva.Node[];
+    className?: string;
+  } = {},
+): Konva.Node {
+  return {
+    id: () => id,
+    getClassName: () => extra.className ?? 'Group',
+    getParent: () => ({ id: () => `${id}-parent` }),
+    x: () => 1,
+    y: () => 2,
+    offsetX: () => 0,
+    offsetY: () => 0,
+    scaleX: () => 1,
+    scaleY: () => 1,
+    rotation: () => 0,
+    skewX: () => 0,
+    skewY: () => 0,
+    getTransform: () => ({ getMatrix: () => relative }),
+    getAbsoluteTransform: vi.fn(() => ({ getMatrix: () => relative })),
+    getChildren: () => extra.children ?? [],
+    getLayer: () => extra.layer ?? null,
+  } as unknown as Konva.Node;
+}
+
+function fakeStage(): Konva.Stage {
+  const canvasRect = { left: 12, top: 20, width: 800, height: 600 };
+  return {
+    width: () => 1200,
+    height: () => 900,
+    getTransform: () => ({ getMatrix: () => [1.36, 0, 0, 1.36, 40, -30] }),
+    container: () => ({
+      getBoundingClientRect: () => ({ ...canvasRect, width: 800, height: 600 }),
+      querySelector: () => ({ getBoundingClientRect: () => canvasRect }),
+    }),
+  } as unknown as Konva.Stage;
+}
+
+function projectionNodes(renderedWitnessToLayout: number[], layoutToWorld: number[]) {
+  const layer = fakeNode('board-layer', [1, 0, 0, 1, 0, 0]);
+  const layout = fakeNode(LAYOUT_ID, layoutToWorld, { layer });
+  const witness = fakeNode('text-witness', renderedWitnessToLayout);
+  // ADR 0015 B9: the id-bearing node is the translation wrapper; its single
+  // content/flip shell wraps the single center-rotation subtree.
+  const rotation = fakeNode('object-outer-rotation', outerCenterWrapperRelative());
+  const shell = fakeNode('object-outer-shell', IDENTITY, { children: [rotation] });
+  const target = fakeNode('object-outer', IDENTITY, { children: [shell] });
+  return { layer, layout, witness, target };
+}
+
+function projectionNodesWithIdentityPassthrough(
+  renderedWitnessToLayout: number[],
+  layoutToWorld: number[],
+) {
+  const layer = fakeNode('board-layer', [1, 0, 0, 1, 0, 0]);
+  const layout = fakeNode(LAYOUT_ID, layoutToWorld, { layer });
+  const witness = fakeNode('text-witness', renderedWitnessToLayout);
+  const rotation = fakeNode('object-outer-rotation', outerCenterWrapperRelative());
+  const passthrough = fakeNode('object-outer-fragment', IDENTITY, { children: [rotation] });
+  const shell = fakeNode('object-outer-shell', IDENTITY, { children: [passthrough] });
+  const target = fakeNode('object-outer', IDENTITY, { children: [shell] });
+  return { layer, layout, witness, target };
+}
+
+const IDENTITY = [1, 0, 0, 1, 0, 0];
+
+/** Product normalization facts used by projection tests. */
+const NORMALIZATION = {
+  certificateVersion: 'makeit.nested-object-normalization-certificate.v1',
+  fixedPoint: true,
+  referentiallyUnchanged: true,
+  subtreeFingerprint: 'subtree-fp-test',
+} as const;
+
+/** The expected live center-rotation wrapper of the OUTER target (local center). */
+function outerCenterWrapperRelative(): number[] {
+  const matrix = canonicalFrameMatrix({ ...OUTER, x: 0, y: 0 }) as Affine2D;
+  return [matrix.a, matrix.b, matrix.c, matrix.d, matrix.e, matrix.f];
+}
+
+describe('canonical nested affine chain (R5)', () => {
+  it('builds the frame matrix as center translation → rotation → flip → negative center', () => {
+    const matrix = canonicalFrameMatrix(OUTER);
+    expect(matrix).not.toBeNull();
+    if (matrix === null) return;
+    const centerLocal = { x: OUTER.width / 2, y: OUTER.height / 2 };
+    const placedCenter = applyAffine(matrix, centerLocal);
+    expect(placedCenter.x).toBeCloseTo(OUTER.x + OUTER.width / 2, 10);
+    expect(placedCenter.y).toBeCloseTo(OUTER.y + OUTER.height / 2, 10);
+    // The unrotated top-left lands at (x, y) when rotation is zero.
+    const unrotated = canonicalFrameMatrix({ ...OUTER, rotationDegrees: 0 });
+    expect(unrotated).not.toBeNull();
+    if (unrotated === null) return;
+    expect(applyAffine(unrotated, { x: 0, y: 0 }).x).toBeCloseTo(OUTER.x, 10);
+  });
+
+  it('composes text → inner → outer → Layout in the declared order', () => {
+    const composed = composeCanonicalChain(CHAIN, LAYOUT_ID);
+    expect('failure' in composed).toBe(false);
+    if ('failure' in composed) return;
+    const renderMatrix = (facts: NestedObjectFrameFacts) => {
+      const renderFrame = segmentRenderFrame(facts);
+      return renderFrameMatrix(renderFrame, facts.flipX, facts.flipY) as Affine2D;
+    };
+    const mWitness = renderMatrix(WITNESS);
+    const mInner = renderMatrix(INNER);
+    const mOuter = renderMatrix(OUTER);
+    const expected = multiplyAffine(mOuter, multiplyAffine(mInner, mWitness));
+    const point = { x: 7.5, y: 11.25 };
+    const actual = applyAffine(composed.witnessToLayout, point);
+    const reference = applyAffine(expected, point);
+    expect(actual.x).toBeCloseTo(reference.x, 10);
+    expect(actual.y).toBeCloseTo(reference.y, 10);
+    expect(composed.segments.map((segment) => segment.parentId)).toEqual([
+      'object-inner',
+      'object-outer',
+      LAYOUT_ID,
+    ]);
+  });
+
+  it('exposes the renderer-local witness quad and the persisted-content quad', () => {
+    // The plain Text witness renders through the exact 8px padded frame.
+    expect(canonicalWitnessLocalQuad(segmentRenderFrame(WITNESS))).toEqual([
+      { x: 0, y: 0 },
+      { x: 144, y: 0 },
+      { x: 144, y: 72 },
+      { x: 0, y: 72 },
+    ]);
+    expect(segmentRenderFrame(WITNESS)).toMatchObject({
+      x: 16,
+      y: 23,
+      width: 144,
+      height: 72,
+      derivation: 'plain-text-frame-padding-v1',
+      padding: { left: 8, right: 8, top: 8, bottom: 8 },
