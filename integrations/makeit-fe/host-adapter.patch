+
+// The generic affine/Konva/fingerprint helpers live in `affineProjection` and
+// are re-exported here so the Slice 5-B public surface is unchanged.
+export { fnv1a64Hex, measureStageCssFacts } from '@/lib/artwork/verification/affineProjection';
+export type {
+  Affine2D,
+  GeometryPoint,
+  Quad,
+  StageCssFacts,
+} from '@/lib/artwork/verification/affineProjection';
+
+/**
+ * Typed circle-warp geometry projection for observation bridge v4 (WP5 Slice 5-B).
+ *
+ * This module is read-only renderer provenance: given the live Konva target and
+ * Layout nodes, the authoritative product Text layer, and the bridge generation,
+ * it composes the correction coordinate chain the warped Oracle requires:
+ *
+ * ```text
+ * warp-control-local
+ *   -- warpControlToSubjectFrame --> subject-frame-local
+ *   -- subjectFrameToLayout      --> layout-local
+ *   -- layoutToWorldScene        --> world-scene
+ *   -- worldSceneToStageViewportCss --> stage-viewport-css
+ *   -- stageViewportToBrowserClientCss --> browser-client-css
+ * ```
+ *
+ * `warpControlToSubjectFrame` carries the frame rules the renderer actually
+ * applies: the product circle frame padding (obtained by calling the exact
+ * product helper `getTextLayerFramePadding()`), the bounds-origin translation,
+ * and the Text flips about the padded frame center. `subjectFrameToLayout` is
+ * read from the *live mounted* outer target Group relative to the live mounted
+ * Layout Group — it is never reconstructed from canonical layer coordinates.
+ *
+ * Nothing here mutates the Stage, the nodes, or product state; every Konva read
+ * is a matrix/rect read.
+ */
+
+export const GEOMETRY_SCHEMA_VERSION = 2;
+export const CIRCLE_CONTROL_ENVELOPE_KIND = 'circle-control-envelope-quad-v1';
+export const CIRCLE_TEXT_FRAME_PROJECTION_KIND = 'circle-text-frame-projection-v1';
+export const GEOMETRY_FINGERPRINT_ALGORITHM = 'fnv1a64';
+export const WARP_FINGERPRINT_PREIMAGE_VERSION = 'makeit.warp-fingerprint.circle.v1';
+export const REPRESENTATION_FINGERPRINT_PREIMAGE_VERSION = 'makeit.geometry-representation.v2';
+
+/**
+ * Seam-unique geometry-schema discriminant. It exists only in this verification
+ * module, so the production-absence scan can prove the typed geometry contract
+ * never reaches production output.
+ */
+export const GEOMETRY_SCHEMA_DISCRIMINANT = 'makeit.artwork-verification.geometry.v2';
+
+export const GEOMETRY_SPACE_UNITS = Object.freeze({
+  warpControlLocal: 'artwork-unit',
+  subjectFrameLocal: 'artwork-unit',
+  layoutLocal: 'artwork-unit',
+  worldScene: 'scene-unit',
+  stageViewportCss: 'css-px',
+  browserClientCss: 'css-px',
+});
+
+export const CIRCLE_CONTROL_ENVELOPE_POINT_ORDER = [
+  'top-left',
+  'top-right',
+  'bottom-right',
+  'bottom-left',
+] as const;
+
+export const GEOMETRY_MATRIX_KEYS = [
+  'warpControlToSubjectFrame',
+  'subjectFrameToLayout',
+  'layoutToWorldScene',
+  'worldSceneToStageViewportCss',
+  'stageViewportToBrowserClientCss',
+] as const;
+
+export type GeometryMatrixKey = (typeof GEOMETRY_MATRIX_KEYS)[number];
+
+// Generic affine/point/quad types live in `affineProjection` and are imported
+// and re-exported above.
+
+export interface CircleTextFrameProjectionV1 {
+  kind: typeof CIRCLE_TEXT_FRAME_PROJECTION_KIND;
+  padding: { left: number; right: number; top: number; bottom: number };
+  controlBounds: { x: number; y: number; width: number; height: number };
+  subjectFrame: { width: number; height: number; flipCenterX: number; flipCenterY: number };
+  flips: { x: boolean; y: boolean };
+}
+
+export interface TypedRendererProvenanceV2 {
+  schemaVersion: 2;
+  bridgeGeneration: number;
+  stageFingerprint: string;
+  target: {
+    id: string;
+    konvaId: string;
+    nodeClass: string;
+    subjectFrameToLayout: Affine2D;
+    fingerprint: string;
+  };
+  layout: {
+    id: string;
+    konvaId: string;
+    nodeClass: string;
+    layoutToWorldScene: Affine2D;
+    fingerprint: string;
+  };
+  representationFingerprint: string;
+}
+
+export interface CircleControlEnvelopeQuadV1 {
+  kind: typeof CIRCLE_CONTROL_ENVELOPE_KIND;
+  pointOrder: typeof CIRCLE_CONTROL_ENVELOPE_POINT_ORDER;
+  warpType: 'circle';
+  units: typeof GEOMETRY_SPACE_UNITS;
+  projection: CircleTextFrameProjectionV1;
+  warpControlLocal: Quad;
+  subjectFrameLocal: Quad;
+  layoutLocal: Quad;
+  worldScene: Quad;
+  stageViewportCss: Quad;
+  browserClientCss: Quad;
+  matrices: Record<GeometryMatrixKey, Affine2D>;
+  warpFingerprint: string;
+  representationFingerprint: string;
+}
+
+export interface ArtworkVerificationGeometryV2 {
+  schemaVersion: 2;
+  discriminant: typeof GEOMETRY_SCHEMA_DISCRIMINANT;
+  typedProvenance: TypedRendererProvenanceV2;
+  representation: CircleControlEnvelopeQuadV1;
+  cssRatios: { x: number; y: number };
+  /**
+   * Stable renderer-representation identity used by target-aware idle, the
+   * G0/G1 bracket, and torn-observation detection. It is an opaque equality
+   * fact; nothing parses it.
+   */
+  envelopeFingerprint: string;
+}
+
+export interface GeometryProjectionFailure {
+  code:
+    | 'GEOMETRY_REPRESENTATION_UNSUPPORTED'
+    | 'GEOMETRY_TRANSFORM_INVALID'
+    | 'GEOMETRY_TARGET_ID_MISMATCH';
+  reason: string;
+  detail: string;
+}
+
+export type GeometryProjectionResult =
+  | { ok: true; record: ArtworkVerificationGeometryV2 }
+  | { ok: false; failure: GeometryProjectionFailure };
+
+export interface CircleWarpPayloadInput {
+  centerX: number;
+  centerY: number;
+  radius: number;
+  radiusY: number | null;
+  rotationAngle: number;
+  arcLength: number;
+  inverted: boolean;
+  verticalAlign: string;
+  arcAlign: string;
+}
+
+// ── Deterministic canonical serialization and fingerprints ──────────────────
+// The canonical serializer and the FNV-1a 64-bit digest live in the generic
+// `affineProjection` module and are imported/re-exported above.
+
+export function buildWarpFingerprintPreimage(payload: CircleWarpPayloadInput): string {
+  return canonicalScalar({
+    version: WARP_FINGERPRINT_PREIMAGE_VERSION,
+    warpType: 'circle',
+    values: [
+      payload.centerX,
+      payload.centerY,
+      payload.radius,
+      payload.radiusY ?? null,
+      payload.rotationAngle,
+      payload.arcLength,
+      payload.inverted,
+      payload.verticalAlign,
+      payload.arcAlign,
+    ],
+  });
+}
+
+export function computeCircleWarpFingerprint(payload: CircleWarpPayloadInput): string {
+  return fnv1a64Hex(buildWarpFingerprintPreimage(payload));
+}
+
+function projectionPreimage(projection: CircleTextFrameProjectionV1): Record<string, unknown> {
+  return {
+    kind: projection.kind,
+    padding: [
+      projection.padding.left,
+      projection.padding.right,
+      projection.padding.top,
+      projection.padding.bottom,
+    ],
+    controlBounds: [
+      projection.controlBounds.x,
+      projection.controlBounds.y,
+      projection.controlBounds.width,
+      projection.controlBounds.height,
+    ],
+    subjectFrame: [
+      projection.subjectFrame.width,
+      projection.subjectFrame.height,
+      projection.subjectFrame.flipCenterX,
+      projection.subjectFrame.flipCenterY,
+    ],
+    flips: [projection.flips.x, projection.flips.y],
+  };
+}
+
+export interface RepresentationFingerprintInput {
+  representation: Omit<
+    CircleControlEnvelopeQuadV1,
+    'representationFingerprint' | 'warpFingerprint'
+  >;
+  targetId: string;
+  layoutId: string;
+  cssRatios: { x: number; y: number };
+  bridgeGeneration: number;
+  warpFingerprint: string;
+}
+
+export function buildRepresentationFingerprintPreimage(
+  input: RepresentationFingerprintInput,
+): string {
+  const { representation } = input;
+  return canonicalScalar({
+    version: REPRESENTATION_FINGERPRINT_PREIMAGE_VERSION,
+    kind: representation.kind,
+    pointOrder: [...representation.pointOrder],
+    warpType: representation.warpType,
+    units: representation.units,
+    projection: projectionPreimage(representation.projection),
+    spaces: {
+      warpControlLocal: quadPreimage(representation.warpControlLocal),
+      subjectFrameLocal: quadPreimage(representation.subjectFrameLocal),
+      layoutLocal: quadPreimage(representation.layoutLocal),
+      worldScene: quadPreimage(representation.worldScene),
+      stageViewportCss: quadPreimage(representation.stageViewportCss),
+      browserClientCss: quadPreimage(representation.browserClientCss),
+    },
+    matrices: GEOMETRY_MATRIX_KEYS.map((key) => [
+      key,
+      affinePreimage(representation.matrices[key]),
+    ]),
+    targetId: input.targetId,
+    layoutId: input.layoutId,
+    cssRatios: [input.cssRatios.x, input.cssRatios.y],
+    bridgeGeneration: input.bridgeGeneration,
+    warpFingerprint: input.warpFingerprint,
+  });
+}
+
+export function computeRepresentationFingerprint(input: RepresentationFingerprintInput): string {
+  return fnv1a64Hex(buildRepresentationFingerprintPreimage(input));
+}
+
+// ── Read-only affine math (generic helpers in `affineProjection`) ───────────
+
+// ── Live Konva reads (generic helpers in `affineProjection`) ────────────────
+
+// ── Projection ──────────────────────────────────────────────────────────────
+
+/** Clamped circle control bounds, matching `transformGeometryToCircle`. */
+export function circleControlBounds(payload: CircleWarpPayloadInput): {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+  left: number;
+  top: number;
+  right: number;
+  bottom: number;
+} | null {
+  const radius = normalizeFiniteNumber(Math.max(payload.radius, 1));
+  const radiusY = normalizeFiniteNumber(
+    payload.radiusY != null ? Math.max(payload.radiusY, 1) : Math.max(payload.radius, 1),
+  );
+  const centerX = normalizeFiniteNumber(payload.centerX);
+  const centerY = normalizeFiniteNumber(payload.centerY);
+  if (radius === null || radiusY === null || centerX === null || centerY === null) return null;
+  const left = centerX - radius;
+  const top = centerY - radiusY;
+  return {
+    left,
+    top,
+    right: centerX + radius,
+    bottom: centerY + radiusY,
+    x: left,
+    y: top,
+    width: radius * 2,
+    height: radiusY * 2,
+  };
+}
+
+function rawControlQuad(bounds: {
+  left: number;
+  top: number;
+  right: number;
+  bottom: number;
+}): Quad {
+  return [
+    { x: bounds.left, y: bounds.top },
+    { x: bounds.right, y: bounds.top },
+    { x: bounds.right, y: bounds.bottom },
+    { x: bounds.left, y: bounds.bottom },
+  ];
+}
+
+export interface CircleEnvelopeProjectionInput {
+  stage: Konva.Stage;
+  generation: number;
+  id: string;
+  layoutId: string;
+  layer: ArtworkTextLayer;
+  targetNode: Konva.Node;
+  layoutNode: Konva.Node;
+}
+
+/**
+ * Projects the live circle-warped Text layer into the geometry schema v2 record.
+ * Returns a structured failure instead of guessing when any required fact is
+ * missing, non-finite, or non-invertible.
+ */
+export function projectCircleControlEnvelope(
+  input: CircleEnvelopeProjectionInput,
+): GeometryProjectionResult {
+  const { layer } = input;
+  if (layer.warp.type !== 'circle') {
+    return {
+      ok: false,
+      failure: {
+        code: 'GEOMETRY_REPRESENTATION_UNSUPPORTED',
+        reason: 'WARP_TYPE_UNSUPPORTED',
+        detail: `Layer "${input.id}" reports warp type "${layer.warp.type}", not circle.`,
+      },
+    };
+  }
+  const payload = layer.warp.payload as ArtworkTextCircleWarpPayload;
+  const bounds = circleControlBounds({
+    centerX: payload.centerX,
+    centerY: payload.centerY,
+    radius: payload.radius,
+    radiusY: payload.radiusY,
+    rotationAngle: payload.rotationAngle,
+    arcLength: payload.arcLength,
+    inverted: payload.inverted,
+    verticalAlign: payload.verticalAlign,
+    arcAlign: payload.arcAlign,
+  });
+  if (bounds === null) {
+    return {
+      ok: false,
+      failure: {
+        code: 'GEOMETRY_TRANSFORM_INVALID',
+        reason: 'CONTROL_BOUNDS_INVALID',
+        detail: 'The circle payload produced non-finite control bounds.',
+      },
+    };
+  }
+
+  // The exact product frame-padding authority the renderer uses.
+  const padding = getTextLayerFramePadding(layer);
+  const subjectFrameWidth = bounds.width + padding.left + padding.right;
+  const subjectFrameHeight = bounds.height + padding.top + padding.bottom;
+  const flipCenterX = subjectFrameWidth / 2;
+  const flipCenterY = subjectFrameHeight / 2;
+
+  const projection: CircleTextFrameProjectionV1 = {
+    kind: CIRCLE_TEXT_FRAME_PROJECTION_KIND,
+    padding: {
+      left: padding.left,
+      right: padding.right,
+      top: padding.top,
+      bottom: padding.bottom,
+    },
+    controlBounds: { x: bounds.x, y: bounds.y, width: bounds.width, height: bounds.height },
+    subjectFrame: {
+      width: subjectFrameWidth,
+      height: subjectFrameHeight,
+      flipCenterX,
+      flipCenterY,
+    },
+    flips: { x: layer.transform.flipX === true, y: layer.transform.flipY === true },
+  };
+
+  // Renderer facts: translate the raw control box into the padded frame, then
+  // flip about the padded frame center.
+  const translateIntoFrame = translationAffine(padding.left - bounds.x, padding.top - bounds.y);
+  const flip: Affine2D = {
+    a: projection.flips.x ? -1 : 1,
+    b: 0,
+    c: 0,
+    d: projection.flips.y ? -1 : 1,
+    e: projection.flips.x ? 2 * flipCenterX : 0,
+    f: projection.flips.y ? 2 * flipCenterY : 0,
+  };
+  const warpControlToSubjectFrame = multiplyAffine(flip, translateIntoFrame);
+
+  const subjectFrameToLayout = readRelativeAffine(input.targetNode, input.layoutNode);
+  if (subjectFrameToLayout === null) {
+    return {
+      ok: false,
+      failure: {
+        code: 'GEOMETRY_TRANSFORM_INVALID',
+        reason: 'SUBJECT_FRAME_TO_LAYOUT_INVALID',
+        detail:
+          'The live target-to-Layout Konva transform could not be read as a finite affine map.',
+      },
+    };
+  }
+
+  const layerNode = (() => {
+    try {
+      return input.layoutNode.getLayer();
+    } catch {
+      return null;
+    }
+  })();
+  const layoutToWorldScene =
+    layerNode === null ? null : readRelativeAffine(input.layoutNode, layerNode);
+  if (layoutToWorldScene === null) {
+    return {
+      ok: false,
+      failure: {
+        code: 'GEOMETRY_TRANSFORM_INVALID',
+        reason: 'LAYOUT_TO_WORLD_INVALID',
+        detail:
+          'The live Layout-to-scene Konva transform could not be read as a finite affine map.',
+      },
+    };
+  }
+
+  const stageViewMatrix = readStageViewMatrix(input.stage);
+  if (stageViewMatrix === null) {
+    return {
+      ok: false,
+      failure: {
+        code: 'GEOMETRY_TRANSFORM_INVALID',
+        reason: 'STAGE_TRANSFORM_INVALID',
+        detail: 'The live Stage affine transform could not be read as a finite affine map.',
+      },
+    };
+  }
+  const measured = measureStageCssFacts(input.stage);
+  if (!measured.ok) return { ok: false, failure: measured.failure };
+  const { cssRatios, containerRect } = measured.facts;
+
+  const worldSceneToStageViewportCss = multiplyAffine(
+    scaleAffine(1 / cssRatios.x, 1 / cssRatios.y),
+    stageViewMatrix,
+  );
+  const stageViewportToBrowserClientCss = translationAffine(containerRect.left, containerRect.top);
+
+  const matrices: Record<GeometryMatrixKey, Affine2D> = {
+    warpControlToSubjectFrame,
+    subjectFrameToLayout,
+    layoutToWorldScene,
+    worldSceneToStageViewportCss,
+    stageViewportToBrowserClientCss,
+  };
+  if (Object.values(matrices).some((matrix) => !isFiniteAffine(matrix))) {
+    return {
+      ok: false,
+      failure: {
+        code: 'GEOMETRY_TRANSFORM_INVALID',
+        reason: 'MATRIX_INVALID',
+        detail: 'At least one composed geometry matrix is not a finite affine map.',
+      },
+    };
+  }
+
+  const warpControlLocal = rawControlQuad(bounds);
+  const subjectFrameLocal = transformQuad(warpControlToSubjectFrame, warpControlLocal);
+  const layoutLocal = transformQuad(subjectFrameToLayout, subjectFrameLocal);
+  const worldScene = transformQuad(layoutToWorldScene, layoutLocal);
+  const stageViewportCss = transformQuad(worldSceneToStageViewportCss, worldScene);
+  const browserClientCss = transformQuad(stageViewportToBrowserClientCss, stageViewportCss);
+
+  const warpFingerprint = computeCircleWarpFingerprint({
+    centerX: payload.centerX,
+    centerY: payload.centerY,
+    radius: payload.radius,
+    radiusY: payload.radiusY ?? null,
+    rotationAngle: payload.rotationAngle,
+    arcLength: payload.arcLength,
+    inverted: payload.inverted,
+    verticalAlign: payload.verticalAlign,
+    arcAlign: payload.arcAlign,
+  });
+
+  const representationWithoutFingerprints: Omit<
+    CircleControlEnvelopeQuadV1,
+    'representationFingerprint' | 'warpFingerprint'
+  > = {
+    kind: CIRCLE_CONTROL_ENVELOPE_KIND,
+    pointOrder: CIRCLE_CONTROL_ENVELOPE_POINT_ORDER,
+    warpType: 'circle' as const,
+    units: GEOMETRY_SPACE_UNITS,
+    projection,
+    warpControlLocal,
+    subjectFrameLocal,
+    layoutLocal,
+    worldScene,
+    stageViewportCss,
+    browserClientCss,
+    matrices,
+  };
+
+  const representationFingerprint = computeRepresentationFingerprint({
+    representation: representationWithoutFingerprints,
+    targetId: input.id,
+    layoutId: input.layoutId,
+    cssRatios,
+    bridgeGeneration: input.generation,
+    warpFingerprint,
+  });
+
+  const targetFingerprint = (() => {
+    try {
+      return JSON.stringify({
+        id: input.targetNode.id(),
+        parentId: input.targetNode.getParent()?.id() ?? null,
+        x: safeRead(() => input.targetNode.x()),
+        y: safeRead(() => input.targetNode.y()),
+        offsetX: safeRead(() => input.targetNode.offsetX()),
+        offsetY: safeRead(() => input.targetNode.offsetY()),
+        width: safeRead(() => input.targetNode.width()),
+        height: safeRead(() => input.targetNode.height()),
+        scaleX: safeRead(() => input.targetNode.scaleX()),
+        scaleY: safeRead(() => input.targetNode.scaleY()),
+        rotation: safeRead(() => input.targetNode.rotation()),
+        skewX: safeRead(() => input.targetNode.skewX()),
+        skewY: safeRead(() => input.targetNode.skewY()),
+        subjectFrameToLayout: affinePreimage(subjectFrameToLayout),
+        visible: safeBooleanRead(() => input.targetNode.isVisible()),
+        listening: safeBooleanRead(() => input.targetNode.isListening()),
+      });
+    } catch {
+      return 'unreadable';
+    }
+  })();
+  const layoutFingerprint = (() => {
+    try {
+      return JSON.stringify({
+        id: input.layoutNode.id(),
+        parentId: input.layoutNode.getParent()?.id() ?? null,
+        x: safeRead(() => input.layoutNode.x()),
+        y: safeRead(() => input.layoutNode.y()),
+        offsetX: safeRead(() => input.layoutNode.offsetX()),
+        offsetY: safeRead(() => input.layoutNode.offsetY()),
+        scaleX: safeRead(() => input.layoutNode.scaleX()),
+        scaleY: safeRead(() => input.layoutNode.scaleY()),
+        rotation: safeRead(() => input.layoutNode.rotation()),
+        layoutToWorldScene: affinePreimage(layoutToWorldScene),
+        visible: safeBooleanRead(() => input.layoutNode.isVisible()),
+      });
+    } catch {
+      return 'unreadable';
+    }
+  })();
+  const stageFingerprint = JSON.stringify({
+    x: safeRead(() => input.stage.x()),
+    y: safeRead(() => input.stage.y()),
+    scaleX: safeRead(() => input.stage.scaleX()),
+    scaleY: safeRead(() => input.stage.scaleY()),
+    rotation: safeRead(() => input.stage.rotation()),
+    skewX: safeRead(() => input.stage.skewX()),
+    skewY: safeRead(() => input.stage.skewY()),
+    width: safeRead(() => input.stage.width()),
+    height: safeRead(() => input.stage.height()),
+    cssRatios,
+  });
+
+  const typedProvenance: TypedRendererProvenanceV2 = {
+    schemaVersion: 2,
+    bridgeGeneration: input.generation,
+    stageFingerprint,
+    target: {
+      id: input.id,
+      konvaId: (() => {
+        try {
+          return input.targetNode.id();
+        } catch {
+          return '';
+        }
+      })(),
+      nodeClass: (() => {
+        try {
+          return input.targetNode.getClassName();
+        } catch {
+          return '';
+        }
+      })(),
+      subjectFrameToLayout,
+      fingerprint: targetFingerprint,
+    },
+    layout: {
+      id: input.layoutId,
+      konvaId: (() => {
+        try {
+          return input.layoutNode.id();
+        } catch {
+          return '';
+        }
+      })(),
+      nodeClass: (() => {
+        try {
+          return input.layoutNode.getClassName();
+        } catch {
+          return '';
+        }
+      })(),
+      layoutToWorldScene,
+      fingerprint: layoutFingerprint,
+    },
+    representationFingerprint,
+  };
+
+  const representation: CircleControlEnvelopeQuadV1 = {
+    ...representationWithoutFingerprints,
+    warpFingerprint,
+    representationFingerprint,
+  };
+
+  return {
+    ok: true,
+    record: {
+      schemaVersion: GEOMETRY_SCHEMA_VERSION,
+      discriminant: GEOMETRY_SCHEMA_DISCRIMINANT,
+      typedProvenance,
+      representation,
+      cssRatios,
+      envelopeFingerprint: [
+        representationFingerprint,
+        typedProvenance.target.fingerprint,
+        typedProvenance.layout.fingerprint,
+        typedProvenance.stageFingerprint,
+      ].join(':'),
+    },
+  };
+}
+
+function safeRead(read: () => number): number | null {
+  try {
+    const value = read();
+    return typeof value === 'number' && Number.isFinite(value) ? value : null;
+  } catch {
+    return null;
+  }
+}
+
+function safeBooleanRead(read: () => boolean): boolean {
+  try {
+    return read() === true;
+  } catch {
+    return false;
+  }
+}
+
+// ── Safe native hit-point construction (R8) ─────────────────────────────────
+
+const CHROME_NAME_PATTERN = /chrome|handle|rotate|warp|overlay|guide|hover|selection/i;
+
+function isHitInsideNode(hit: Konva.Node | null, expected: Konva.Node): boolean {
+  let current = hit;
+  while (current) {
+    if (current === expected) return true;
+    current = current.getParent();
+  }
+  return false;
+}
+
+/** True when the hit resolved to target-owned selection/handle/warp chrome. */
+function isChromeHit(hit: Konva.Node | null, expected: Konva.Node): boolean {
+  let current = hit;
+  while (current && current !== expected) {
+    const id = (() => {
+      try {
+        return current.id();
+      } catch {
+        return '';
+      }
+    })();
+    const name = (() => {
+      try {
+        return current.name();
+      } catch {
+        return '';
+      }
+    })();
+    if (CHROME_NAME_PATTERN.test(id) || CHROME_NAME_PATTERN.test(name)) return true;
+    current = current.getParent();
+  }
+  return false;
+}
+
+export interface WarpedHitPointInput {
+  stage: Konva.Stage;
+  targetNode: Konva.Node;
+  browserClientQuad: Quad;
+  cssRatios: { x: number; y: number };
+  containerRect: { left: number; top: number };
+}
+
+/**
+ * Deterministic safe hit point for a warped target: the first candidate in the
+ * declared order that is inside the convex browser-client quad, at least
+ * `4 CSS px` from every quad edge, and resolves through `stage.getIntersection`
+ * to the target's live listening region rather than target-owned chrome.
+ */
+export function findWarpedHitPoint(
+  input: WarpedHitPointInput,
+): GeometryPoint | { failure: GeometryProjectionFailure } {
+  for (const candidate of HIT_POINT_CANDIDATE_UVS) {
+    const point = bilinearPoint(input.browserClientQuad, candidate.u, candidate.v);
+    if (!pointInConvexQuad(point, input.browserClientQuad)) continue;
+    if (distanceToQuadEdges(point, input.browserClientQuad) < HIT_POINT_INSET_CSS_PX) continue;
+    const stagePoint = {
+      x: (point.x - input.containerRect.left) * input.cssRatios.x,
+      y: (point.y - input.containerRect.top) * input.cssRatios.y,
+    };
+    if (!Number.isFinite(stagePoint.x) || !Number.isFinite(stagePoint.y)) continue;
+    let hit: Konva.Node | null = null;
+    try {
+      hit = input.stage.getIntersection(stagePoint) ?? null;
+    } catch {
+      hit = null;
+    }
+    if (hit === null) continue;
+    if (!isHitInsideNode(hit, input.targetNode)) continue;
+    if (isChromeHit(hit, input.targetNode)) continue;
+    return point;
+  }
+  return {
+    failure: {
+      code: 'GEOMETRY_TRANSFORM_INVALID',
+      reason: 'HIT_POINT_UNAVAILABLE',
+      detail:
+        'No safe warped hit point resolved to the target listening frame at least 4 CSS px from every envelope edge.',
+    },
+  };
+}
