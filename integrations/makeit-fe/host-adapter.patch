+    // Object segments share the persisted frame.
+    expect(segmentRenderFrame(OUTER)).toMatchObject({
+      x: OUTER.x,
+      y: OUTER.y,
+      width: OUTER.width,
+      height: OUTER.height,
+      derivation: 'object-wrapper-plus-center-rotation-v1',
+      padding: null,
+    });
+  });
+
+  it('fails closed on chain parent, shape, and finiteness violations', () => {
+    expect(composeCanonicalChain([WITNESS], LAYOUT_ID)).toHaveProperty('failure');
+    const wrongParent = composeCanonicalChain(
+      [WITNESS, INNER, { ...OUTER, parentId: 'other' }],
+      LAYOUT_ID,
