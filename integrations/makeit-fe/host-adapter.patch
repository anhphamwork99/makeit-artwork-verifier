+
+/**
+ * The post-action observation interaction member used by projection tests
+ * (ADR 0014 R6). `status` and classification are caller-supplied so a test can
+ * produce a clear or an obstructed observation over identical geometry.
+ */
+function postActionInteraction(input: {
+  status: 'clear' | 'obstructed';
+  hitClassification:
+    | 'target'
+    | 'owned-non-chrome-descendant'
+    | 'selection-chrome'
+    | 'transform-chrome'
+    | 'foreign-listening-node'
+    | 'no-hit';
+  point?: { x: number; y: number };
+}) {
+  const obscured = input.status === 'obstructed';
+  return {
+    phase: 'post-action' as const,
+    purpose: 'observe-authoritative-geometry' as const,
+    authority: 'none' as const,
+    status: input.status,
+    targetId: 'object-outer',
+    space: 'browser-client-css' as const,
+    candidate: 'center' as const,
+    point: input.point ?? { x: 300, y: 220 },
+    safetyInsetCssPx: 4 as const,
+    source: 'live-konva-hit-v1' as const,
+    hitClassification: input.hitClassification,
+    obstructionCode: obscured ? ('POST_ACTION_HIT_OBSTRUCTED' as const) : null,
+    safeHitDescriptor:
+      input.hitClassification === 'selection-chrome'
+        ? { nodeClass: 'Rect' as const, chromeName: 'artwork-chrome' as const, ownedByTarget: true }
+        : input.hitClassification === 'no-hit'
+          ? { nodeClass: null, chromeName: null, ownedByTarget: false }
+          : { nodeClass: 'Rect' as const, chromeName: null, ownedByTarget: false },
+  };
+}
