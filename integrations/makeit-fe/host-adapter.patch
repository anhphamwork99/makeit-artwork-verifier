@@ -0,0 +1,63 @@
+#!/usr/bin/env node
+
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { spawnSync } from 'node:child_process';
+
+import { resolveArtworkVerifierPackage } from './artwork-verifier-package.mjs';
+import { prepareArtworkEvidenceRoot } from './verify-artwork-paths.mjs';
+
+const repoRoot = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+
+function refuse(message) {
+  process.stderr.write(`verify-artwork adapter: ${message}\n`);
+  process.exit(78);
+}
+
+let toolkit;
+try {
+  toolkit = resolveArtworkVerifierPackage();
+} catch (error) {
+  refuse(error instanceof Error ? error.message : String(error));
+}
+
+const forwardedArgs = process.argv.slice(2);
+const appRootIndex = forwardedArgs.indexOf('--app-root');
+if (appRootIndex >= 0) {
+  const suppliedRoot = forwardedArgs[appRootIndex + 1];
+  if (!suppliedRoot || resolve(suppliedRoot) !== repoRoot) {
+    refuse('`--app-root` is owned by the FE adapter and must name this checkout.');
+  }
+}
+if (
+  (forwardedArgs[0] === 'host' ||
+    forwardedArgs[0] === 'doctor' ||
+    forwardedArgs[0] === 'diagnostic' ||
+    forwardedArgs[0] === 'cleanup') &&
+  appRootIndex < 0
+) {
+  forwardedArgs.push('--app-root', repoRoot);
+}
+
+let evidenceRoot;
+try {
+  evidenceRoot = prepareArtworkEvidenceRoot(repoRoot);
+} catch {
+  refuse('the FE-owned artwork evidence root is unavailable or unsafe.');
+}
+
+const result = spawnSync(process.execPath, [toolkit.entrypoint, ...forwardedArgs], {
+  cwd: repoRoot,
+  env: {
+    ...process.env,
+    MAKEIT_ARTWORK_EVIDENCE_ROOT: evidenceRoot,
+  },
+  stdio: 'inherit',
+});
+
+if (result.error) refuse('the installed verifier process could not be started.');
+if (result.signal) {
+  process.kill(process.pid, result.signal);
+  process.exit(1);
+}
+process.exit(result.status ?? 1);
