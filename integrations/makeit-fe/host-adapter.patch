+      const degenerate: Quad = [
+        { x: 0, y: 0 },
+        { x: 0, y: 0 },
+        { x: 0, y: 0 },
+        { x: 0, y: 0 },
+      ];
+      expect(quadIsSimple(degenerate)).toBe(false);
+      expect(eligibleHitPointCandidates(degenerate)).toEqual([]);
+    });
+  });
+
+  it('agrees on affine components exactly at the tolerance and fails immediately outside', () => {
+    const left: Affine2D = { a: 1, b: 0, c: 0, d: 1, e: 0, f: 0 };
