+export interface CanonicalImageAuthorityInput {
+  /** Canonical `config.placeholder === true`. */
+  placeholder: boolean;
+  /** Canonical `config.testedWithImage === true`. */
+  testedWithImage: boolean;
+  /** Canonical `src` is a non-empty string. */
+  hasSource: boolean;
+  /** Canonical source is a `blob:` scheme (the only upload authority). */
+  blobScheme: boolean;
+  /** Count of live Konva Image descendants with any drawable. */
+  rasterNodeCount: number;
+  /** Count of live Konva Image descendants whose drawable is an HTMLCanvasElement. */
+  canvasBackedNodeCount: number;
