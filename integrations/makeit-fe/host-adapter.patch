+    it('enforces the exact 4 CSS px inset boundary', () => {
+      const candidates = eligibleHitPointCandidates(rotated, HIT_POINT_INSET_CSS_PX);
+      expect(candidates.length).toBeGreaterThan(0);
+      for (const candidate of candidates) {
+        expect(candidate.edgeDistance).toBeGreaterThanOrEqual(HIT_POINT_INSET_CSS_PX);
+        expect(pointInConvexQuad(candidate.point, rotated)).toBe(true);
+      }
+      const center = bilinearPoint(rotated, 0.5, 0.5);
+      expect(distanceToQuadEdges(center, rotated)).toBeGreaterThan(HIT_POINT_INSET_CSS_PX);
