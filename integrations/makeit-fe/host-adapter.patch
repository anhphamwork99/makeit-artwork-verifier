+    if (rotated === null) throw new Error('expected a finite matrix');
+    const center = applyAffine(rotated, { x: 165, y: 140 });
+    expect(center.x).toBeCloseTo(105 + 165, 10);
+    expect(center.y).toBeCloseTo(85 + 140, 10);
+    // Flip is applied before rotation, mirroring the product frame contract.
+    const flipped = frameToParentMatrix({
+      x: 0,
+      y: 0,
+      width: 20,
+      height: 10,
+      rotationDegrees: 0,
+      flipX: true,
+      flipY: false,
+    });
+    if (flipped === null) throw new Error('expected a finite matrix');
+    expect(applyAffine(flipped, { x: 0, y: 0 })).toEqual({ x: 20, y: 0 });
+  });
+
+  it('reads relative Konva transforms through the uncached ancestor form', () => {
+    const node = fakeNode([1, 0, 0, 1, 3, 4], [1, 0, 0, 1, 30, 40]);
+    const ancestor = {} as Konva.Node;
