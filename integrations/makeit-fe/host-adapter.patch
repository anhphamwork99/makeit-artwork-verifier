+  size: number,
+  numerator: number,
+  denominator: number,
+): number {
+  if (!Number.isFinite(size) || size <= 0) return 0;
+  const derived = Math.floor((size * numerator) / denominator);
+  return Math.min(Math.trunc(size) - 1, Math.max(0, derived));
