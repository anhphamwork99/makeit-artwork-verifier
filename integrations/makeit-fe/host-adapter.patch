+  input: CanonicalImageAuthorityInput,
+): CanonicalImageAuthorityDecision {
+  if (input.placeholder && !input.testedWithImage && !input.hasSource) {
+    return { status: 'not-applicable', reason: 'no-raster-node', acquire: false };
+  }
+  if (!input.hasSource) {
+    return { status: 'pending', reason: 'empty-raster-source', acquire: false };
+  }
+  if (!input.blobScheme) {
+    return { status: 'failed', reason: 'source-unreadable', acquire: false };
+  }
+  if (input.rasterNodeCount === 0) {
+    return { status: 'pending', reason: 'no-raster-node', acquire: false };
+  }
