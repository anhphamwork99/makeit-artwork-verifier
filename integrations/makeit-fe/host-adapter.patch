diff --git a/scripts/artwork-verifier-capabilities.mjs b/scripts/artwork-verifier-capabilities.mjs
new file mode 100644
index 00000000..0560e874
--- /dev/null
+++ b/scripts/artwork-verifier-capabilities.mjs
@@ -0,0 +1,158 @@
+#!/usr/bin/env node
+
+import { readFileSync } from 'node:fs';
+import { join, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+import { resolveArtworkVerifierPackage } from './artwork-verifier-package.mjs';
+
+const toolkit = resolveArtworkVerifierPackage();
+const toolkitRoot = toolkit.packageRoot;
+
+function readJson(relativePath) {
+  return JSON.parse(readFileSync(join(toolkitRoot, relativePath), 'utf8'));
+}
+
+function bindingKey(subjectId, capability) {
+  return `${subjectId}\u0000${capability}`;
+}
+
+export function buildCapabilityInventory({
+  subjects,
+  coverage,
+  routes,
+  suite,
+  requests,
+  toolkitRevision = null,
+}) {
+  const modelsByBinding = new Map(
+    coverage.models.map((model) => [bindingKey(model.subjectId, model.capability), model]),
+  );
+  const routesByBinding = new Map();
+  for (const route of routes.routeSelections) {
+    const key = bindingKey(route.subjectId, route.capability);
+    const entries = routesByBinding.get(key) ?? [];
+    entries.push(route);
+    routesByBinding.set(key, entries);
+  }
+
+  const representativeByBinding = new Map();
+  const representativeCases = suite.cases.map((entry) => {
+    const request = requests.get(entry.request);
+    if (!request) {
+      throw new Error(`Representative request is unavailable: ${entry.request}`);
+    }
+    const intent = request.intent;
+    const key = bindingKey(intent.subjectId, intent.capability);
+    const entries = representativeByBinding.get(key) ?? [];
+    const summary = {
+      order: entry.order,
+      request: entry.request,
+      subjectId: intent.subjectId,
+      capability: intent.capability,
+      scenario: intent.scenario,
+      variant: intent.variant ?? null,
+      expectedOutcome: entry.expectedOutcome,
+    };
+    entries.push(summary);
+    representativeByBinding.set(key, entries);
+    return summary;
+  });
+
+  const bindings = [];
+  for (const subject of subjects.declarations) {
+    for (const binding of subject.capabilityBindings) {
+      const key = bindingKey(subject.subjectId, binding.capability);
+      const model = modelsByBinding.get(key);
+      const selectedRoutes = routesByBinding.get(key) ?? [];
+      const provenCases = representativeByBinding.get(key) ?? [];
+      bindings.push({
+        subjectId: subject.subjectId,
+        subjectLabel: subject.label,
+        variants: subject.variants,
+        capability: binding.capability,
+        workflowId: binding.workflowId,
+        correctnessRoutes: selectedRoutes.map((route) => ({
+          variant: route.variant,
+          readinessProfileId: route.readinessProfileId,
+          oracleProfileId: route.oracleProfileId,
+        })),
+        coverageScenarios:
+          model?.scenarios.map((scenario) => ({
+            id: scenario.id,
+            label: scenario.label,
+            eligibility: scenario.eligibility,
+          })) ?? [],
+        representativeCases: provenCases,
+        intakeStatus:
+          selectedRoutes.length > 0 && model ? 'ROUTED_PLAN_REQUIRED' : 'VERIFICATION_GAP',
+      });
+    }
+  }
+
+  return {
+    schemaVersion: 1,
+    status: 'READY',
+    toolkitRevision,
+    policy: {
+      checkedInRequest:
+        'An exact checked-in representative request may run after setup; never generalize its proof to another scenario.',
+      routedPlanRequired:
+        'Agent may author a strict request for a declared route/model, but static planning must PASS before any browser run.',
+      verificationGap:
+        'Do not launch. Produce a verification-gap report for the maintenance workflow.',
+    },
+    counts: {
+      subjects: subjects.declarations.length,
+      bindings: bindings.length,
+      correctnessRoutes: routes.routeSelections.length,
+      coverageModels: coverage.models.length,
+      representativeCases: representativeCases.length,
+    },
+    representativeSuite: {
+      suiteId: suite.suiteId,
+      version: suite.version,
+      cases: representativeCases,
+    },
+    bindings,
+  };
+}
+
+export function loadCapabilityInventory() {
+  const subjects = readJson('catalogues/subjects/verification-subjects.v1.json');
+  const coverage = readJson('catalogues/coverage/binding-coverage-models.v1.json');
+  const routes = readJson('catalogues/oracles/route-selections.v1.json');
+  const suite = readJson('cases/diagnostic/suites/representative.v1.json');
+  const requests = new Map(suite.cases.map((entry) => [entry.request, readJson(entry.request)]));
+  return buildCapabilityInventory({
+    subjects,
+    coverage,
+    routes,
+    suite,
+    requests,
+    toolkitRevision: toolkit.identity,
+  });
+}
+
+function isDirectRun() {
+  return process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url);
+}
+
+if (isDirectRun()) {
+  try {
+    process.stdout.write(`${JSON.stringify(loadCapabilityInventory(), null, 2)}\n`);
+  } catch (error) {
+    process.stdout.write(
+      `${JSON.stringify(
+        {
+          schemaVersion: 1,
+          status: 'BLOCKED',
+          detail: error instanceof Error ? error.message : String(error),
+        },
+        null,
+        2,
+      )}\n`,
+    );
+    process.exitCode = 78;
+  }
+}
