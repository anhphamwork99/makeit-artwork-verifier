+
+function kindFromType(type: SceneNodeType): ArtworkVerificationKind {
+  if (type === 'FRAME') return 'layout';
+  return type.toLowerCase() as ArtworkVerificationKind;
+}
+
+function konvaIdForNode(node: SceneNode): string {
+  return node.type === 'FRAME' ? `layout-${node.id}` : node.id;
+}
+
+function findKonvaNode(stage: Konva.Stage, node: SceneNode): Konva.Node | null {
+  const targetId = konvaIdForNode(node);
+  return stage.find((candidate: Konva.Node) => candidate.id() === targetId)[0] ?? null;
+}
+
+/** Live node lookup by exact Konva id, read-only. */
+function konvaNodeById(stage: Konva.Stage, konvaId: string): Konva.Node | null {
+  return stage.find((candidate: Konva.Node) => candidate.id() === konvaId)[0] ?? null;
+}
+
+/**
+ * Resolves the authoritative circle-warped Text layer and its parent Layout for
+ * a target id. Returns `null` for anything that is not a circle-warped Text
+ * layer, so no other representation can accidentally enter the typed path.
+ */
+function findCircleWarpLayerContext(
+  layerId: string,
+): { layer: ArtworkTextLayer; layoutItem: ArtworkLayoutItem } | null {
+  const state = useArtworkEditorStore.getState();
+  for (const layoutItem of state.layoutItems) {
+    for (const layer of layoutItem.layers ?? []) {
+      if (!('id' in layer) || layer.id !== layerId) continue;
+      if (!isArtworkTextLayer(layer)) return null;
+      return { layer, layoutItem };
+    }
+  }
+  return null;
+}
+
+interface WarpedProjection {
+  record: ArtworkVerificationGeometryV2 | null;
+  targetNode: Konva.Node | null;
+  reason: string | null;
+}
+
+/**
+ * Projects the live typed geometry for a circle-warped Text target, or reports
+ * the structured reason it is unavailable. Read-only: no Stage/node/store
+ * mutation, no product action.
+ */
+function projectWarpedTarget(
+  stage: Konva.Stage,
+  generation: number,
+  id: string,
+): WarpedProjection | null {
+  const context = findCircleWarpLayerContext(id);
+  if (context === null) return null;
+  if (context.layer.warp.type !== 'circle') return null;
+  const targetNode = konvaNodeById(stage, id);
+  if (targetNode === null) return { record: null, targetNode: null, reason: 'unmounted' };
+  const layoutNode = konvaNodeById(stage, `layout-${context.layoutItem.id}`);
+  if (layoutNode === null) return { record: null, targetNode, reason: 'layout-unmounted' };
+  const projected = projectCircleControlEnvelope({
+    stage,
+    generation,
+    id,
+    layoutId: context.layoutItem.id,
+    layer: context.layer,
+    targetNode,
+    layoutNode,
+  });
+  if (!projected.ok) return { record: null, targetNode, reason: projected.failure.reason };
+  return { record: projected.record, targetNode, reason: null };
+}
+
+/** The typed envelope identity used by idle/G0/G1 equality, or `null`. */
+function warpedEnvelopeFingerprint(
+  stage: Konva.Stage,
+  generation: number,
+  id: string,
+): string | null {
+  const projected = projectWarpedTarget(stage, generation, id);
+  return projected !== null && projected.record !== null
+    ? projected.record.envelopeFingerprint
+    : null;
+}
