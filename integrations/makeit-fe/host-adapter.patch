+import assert from 'node:assert/strict';
+import { mkdtempSync, mkdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { afterEach, test } from 'node:test';
+
+import {
+  buildGapReport,
+  readGapInput,
+  sanitizeSourceReference,
+  validateGapRequest,
+  writeGapBundle,
+} from './artwork-verification-gap.mjs';
+
+const temporaryRoots = [];
+
+afterEach(() => {
+  for (const root of temporaryRoots.splice(0)) rmSync(root, { recursive: true, force: true });
+});
+
+function exampleGap() {
+  return {
+    schemaVersion: 1,
+    source: {
+      kind: 'url',
+      reference: 'https://docs.example.com/artwork/new-feature?token=secret#case',
+    },
+    requestedBehavior: {
+      title: 'Move a new layer',
+      summary: 'The seller moves a newly introduced layer on the Artwork canvas.',
+      steps: ['Create the new layer.', 'Drag it to the right.'],
+      expectations: ['The layer moves by the requested delta.'],
+    },
+    attemptedMapping: {
+      subjectId: 'layer/new-kind',
+      capability: 'move',
+      scenario: null,
+      variant: null,
+    },
+    blockers: [
+      {
+        kind: 'SUBJECT_UNSUPPORTED',
+        detail: 'The subject is not declared in the verifier catalogue.',
+      },
+    ],
+  };
+}
+
+test('sanitizes URL source references by removing query, fragment and credentials', () => {
+  assert.equal(
+    sanitizeSourceReference(
+      'url',
+      'https://docs.example.com/artwork/new-feature?token=secret#case',
+    ),
+    'https://docs.example.com/artwork/new-feature',
+  );
+  assert.throws(
+    () => sanitizeSourceReference('url', 'https://user:secret@docs.example.com/case'),
+    /without credentials/,
+  );
+});
+
+test('validates a structured verification gap and fixes its maintenance route', () => {
+  const gap = validateGapRequest(exampleGap());
+  assert.equal(gap.source.reference, 'https://docs.example.com/artwork/new-feature');
+  assert.equal(gap.recommendation, 'maintain-verification-skills');
+  assert.deepEqual(gap.recommendationProject, {
+    repository: 'anhphamwork99/makeit-artwork-verifier',
+    path: '.planning/maintain-verification-skills/PROJECT.md',
+  });
+  assert.equal(gap.blockers[0].kind, 'SUBJECT_UNSUPPORTED');
+});
+
+test('requires at least one closed blocker', () => {
+  const input = exampleGap();
+  input.blockers = [];
+  assert.throws(() => validateGapRequest(input), /at least one verification gap/);
+});
+
+test('writes a friendly report and structured gap artifact', () => {
+  const reportsRoot = mkdtempSync(join(tmpdir(), 'makeit-verification-gap-'));
+  temporaryRoots.push(reportsRoot);
+  const gap = validateGapRequest(exampleGap());
+  const bundle = writeGapBundle({ reportsRoot, reportId: 'gap-1', gap });
+  const report = readFileSync(bundle.reportPath, 'utf8');
+  assert.match(report, /chưa thể chạy test case/);
+  assert.match(report, /SUBJECT_UNSUPPORTED/);
+  assert.match(
+    report,
+    /makeit-artwork-verifier:\.planning\/maintain-verification-skills\/PROJECT\.md/,
+  );
+  assert.doesNotMatch(report, /token=secret/);
+  assert.match(buildGapReport(gap, 'verification-gap.json'), /Structured gap/);
+});
+
+test('reads gap input only from the owned requests directory', () => {
+  const root = mkdtempSync(join(tmpdir(), 'makeit-verification-gap-input-'));
+  temporaryRoots.push(root);
+  const requestsRoot = join(root, 'requests');
+  mkdirSync(requestsRoot);
+  const allowed = join(requestsRoot, 'gap.json');
+  writeFileSync(allowed, JSON.stringify(exampleGap()));
+  assert.equal(readGapInput(allowed, requestsRoot).schemaVersion, 1);
+
+  const foreign = join(root, 'foreign.json');
+  writeFileSync(foreign, JSON.stringify(exampleGap()));
+  assert.throws(() => readGapInput(foreign, requestsRoot), /must be a file under/);
+});
diff --git a/scripts/artwork-verification-report.mjs b/scripts/artwork-verification-report.mjs
new file mode 100644
index 00000000..0b3b903f
--- /dev/null
+++ b/scripts/artwork-verification-report.mjs
@@ -0,0 +1,191 @@
+import { mkdirSync, writeFileSync } from 'node:fs';
+import { basename, join } from 'node:path';
+
+const FRIENDLY_STATUS = {
+  PASS: 'Đạt — hành vi đáp ứng các kiểm tra bắt buộc.',
+  BUG: 'Phát hiện lỗi sản phẩm — hành vi thực tế không đáp ứng kỳ vọng của test case.',
+  HARNESS_BLOCKED:
+    'Chưa thể kiểm tra — verifier thiếu điều kiện hoặc không xác định được đối tượng cần thao tác.',
+  ENVIRONMENT_FAILURE:
+    'Lỗi môi trường — ứng dụng, browser hoặc dependency không thể khởi chạy đúng.',
+  USAGE: 'Yêu cầu chưa hợp lệ — cần chỉnh lại test case hoặc tham số đầu vào.',
+};
+
+export function extractJsonEnvelope(text) {
+  const start = text.indexOf('{');
+  if (start < 0) throw new Error('Verifier did not return a JSON result envelope.');
+  return JSON.parse(text.slice(start));
+}
+
+function diagnosticItems(result) {
+  const items = [];
+  const readableDetail = (entry) => {
+    if (
+      typeof entry?.detail === 'string' &&
+      entry.detail.length > 0 &&
+      !entry.detail.startsWith('[redacted:')
+    ) {
+      return entry.detail;
+    }
+    return entry?.code ?? null;
+  };
+  for (const entry of result.diagnostics ?? []) {
+    items.push(readableDetail(entry) ?? String(entry));
+  }
+  for (const entry of result.details?.issues ?? []) {
+    items.push(readableDetail(entry) ?? String(entry));
+  }
+  return [...new Set(items.filter(Boolean))];
+}
+
+function requiredChecks(result) {
+  return (result.details?.requiredChecks ?? []).map((check) => ({
+    id: check.checkId ?? check.id ?? 'unnamed-check',
+    status: check.status ?? 'UNKNOWN',
+  }));
+}
+
+function markdownList(items, emptyText) {
+  if (items.length === 0) return `- ${emptyText}`;
+  return items.map((item) => `- ${item}`).join('\n');
+}
+
+export function buildFriendlyReport({
+  invocation,
+  result,
+  evidenceVerification,
+  rawResultPath,
+  rawVerificationPath,
+}) {
+  const status = result.status ?? 'UNKNOWN';
+  const details = result.details ?? {};
+  const scope = details.scope ?? {};
+  const checks = requiredChecks(result);
+  const diagnostics = diagnosticItems(result);
+  const evidenceStatus = evidenceVerification?.status ?? 'NOT_AVAILABLE';
+  const evidenceTrusted = evidenceStatus === 'PASS';
+  const behaviorPassed = status === 'PASS';
+  const finalPass = behaviorPassed && evidenceTrusted;
+  const title = finalPass ? 'Kết quả kiểm tra: ĐẠT' : `Kết quả kiểm tra: ${status}`;
+  const friendly = FRIENDLY_STATUS[status] ?? `Verifier kết thúc với trạng thái ${status}.`;
+  const cleanup = details.cleanup;
+  const cleanupText = cleanup
+    ? cleanup.complete
+      ? 'Hoàn tất; process, port và scratch state do verifier sở hữu đã được dọn dẹp.'
+      : 'Chưa hoàn tất. Cần xem diagnostics trước khi chạy lại.'
+    : 'Không có tài nguyên runtime nào được cấp phát hoặc không có thông tin cleanup.';
+  const target = [scope.subjectId, scope.capability, scope.scenario, scope.variant]
+    .filter(Boolean)
+    .join(' / ');
+  const observedBehavior =
+    scope.subjectId && scope.capability
+      ? `Verifier đã thực hiện hành vi \`${scope.capability}\` trên \`${scope.subjectId}\`${
+          scope.scenario ? ` trong tình huống \`${scope.scenario}\`` : ''
+        }.`
+      : 'Verifier dừng trước khi có thể quan sát đầy đủ hành vi của người dùng.';
+
+  const nextSteps = [];
+  if (finalPass) {
+    nextSteps.push('Không cần hành động sửa lỗi cho test case này.');
+  } else if (status === 'BUG') {
+    nextSteps.push(
+      'Dùng run ID và evidence bên dưới để tạo hoặc cập nhật bug report cho hành vi sản phẩm.',
+    );
+  } else if (status === 'USAGE') {
+    nextSteps.push('Kiểm tra lại đường dẫn và nội dung Case Request rồi invoke skill lần nữa.');
+  } else {
+    nextSteps.push(
+      'Giải quyết diagnostics bên dưới rồi chạy lại cùng test case; không coi kết quả này là lỗi sản phẩm.',
+    );
+  }
+  if (behaviorPassed && !evidenceTrusted) {
+    nextSteps.unshift('Không công nhận PASS cho tới khi evidence verification trả PASS.');
+  }
+
+  return `# ${title}
+
+## Kết luận dễ hiểu
+
+${friendly}${behaviorPassed && !evidenceTrusted ? ' Tuy nhiên, bằng chứng chưa vượt qua kiểm tra integrity nên kết quả chưa được công nhận là PASS.' : ''}
+
+## Hành vi người dùng được kiểm tra
+
+${observedBehavior}
+
+## Test case đã chạy
+
+- Lệnh: \`${invocation}\`
+- Phạm vi: ${target || 'Không xác định trước khi verifier dừng.'}
+- Run/Suite ID: \`${details.runId ?? details.suiteExecutionId ?? details.suiteId ?? 'không có'}\`
+- Coverage: \`${details.coverageStatus ?? 'không có'}\`
+- Behavior outcome: \`${details.behaviorOutcome ?? result.outcome ?? status}\`
+
+## Các kiểm tra bắt buộc
+
+${markdownList(
+  checks.map((check) => `\`${check.id}\`: **${check.status}**`),
+  'Verifier chưa chạy tới bước đánh giá required checks.',
+)}
+
+## Bằng chứng và độ tin cậy
+
+- Evidence verification: **${evidenceStatus}**
+- Evidence root: \`${details.evidenceRoot ?? 'không có'}\`
+- Raw verifier result: [${rawResultPath}](./${rawResultPath})
+- Raw evidence verification: ${
+    rawVerificationPath ? `[${rawVerificationPath}](./${rawVerificationPath})` : 'không có'
+  }
+
+## Cleanup
+
+${cleanupText}
+
+## Vấn đề cần chú ý
+
+${markdownList(diagnostics, 'Không có diagnostic blocking được báo cáo.')}
+
+## Bước tiếp theo
+
+${markdownList(nextSteps, 'Không có.')}
+
+---
+
+Report này diễn giải kết quả Diagnostic correctness cho đúng test case đã cung cấp. Nó không tự mở rộng thành claim exhaustive, cross-browser, backend, production-safety hoặc Release Credit.
+`;
+}
+
+export function writeReportBundle({
+  reportsRoot,
+  reportId,
+  invocation,
+  result,
+  evidenceVerification,
+}) {
+  const bundleRoot = join(reportsRoot, reportId);
+  mkdirSync(bundleRoot, { recursive: false, mode: 0o700 });
+  const rawResultPath = join(bundleRoot, 'verifier-result.json');
+  const rawVerificationPath = evidenceVerification
+    ? join(bundleRoot, 'evidence-verification.json')
+    : null;
+  const reportPath = join(bundleRoot, 'report.md');
+
+  writeFileSync(rawResultPath, `${JSON.stringify(result, null, 2)}\n`, { mode: 0o600 });
+  if (rawVerificationPath) {
+    writeFileSync(rawVerificationPath, `${JSON.stringify(evidenceVerification, null, 2)}\n`, {
+      mode: 0o600,
+    });
+  }
+  writeFileSync(
+    reportPath,
+    buildFriendlyReport({
+      invocation,
+      result,
+      evidenceVerification,
+      rawResultPath: basename(rawResultPath),
+      rawVerificationPath: rawVerificationPath ? basename(rawVerificationPath) : null,
+    }),
+    { mode: 0o600 },
+  );
+
+  return { bundleRoot, reportPath, rawResultPath, rawVerificationPath };
+}
