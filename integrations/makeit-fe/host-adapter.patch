+      generation: 1,
+      id: 'text-1',
+      layoutId: 'layout-a',
+      layer,
+      targetNode: fakeNode({ id: 'text-1', absolute: translation(0, 0) }) as never,
+      layoutNode: fakeNode({ id: 'layout-a', absolute: translation(0, 0) }) as never,
+    });
+    if (!result.ok) throw new Error(result.failure.detail);
+    return result.record;
+  }
