+/**
+ * Shared browser-Document identity anchor (specification 9.1, 17).
+ *
+ * The read-only observation bridge and the one-shot setup boundary are separate
+ * seams, but both must resolve the *same* identity for the same browser Document
+ * and route document. Binding them to one anchor is what makes a reload
+ * invalidate both a seal and a setup authorization without either seam owning
+ * its own invalidation logic: a reload replaces the realm host object, so the
+ * next Document gets a fresh `realmDocumentId` and an epoch that restarts at 1.
+ *
+ * The anchor therefore lives on the live host object (the browser `window`, or
+ * `globalThis` in a non-DOM realm) rather than in module state, and every
+ * resolution in the same browser Document returns the identical anchor. It is
+ * keyed by a registered Symbol so two independently bundled seams cannot drift
+ * onto different slot names, and so it never appears in enumeration, JSON, logs,
+ * or serialized evidence.
+ *
+ * `documentId` addresses the pair (browser Document, product route document):
+ * it is stable across seam/Stage remounts in one Document, and changes when the
+ * route addresses a different product document (for example
+ * `/artwork/editor/<id>` for another id). Hydrating content into the current
+ * route document is not a document change, so `documentId` does not change on
+ * hydrate.
+ */
+
+export interface ArtworkVerificationDocumentAnchor {
+  /** Stable identity of the browser Document this realm currently exposes. */
+  realmDocumentId: string;
+  /** 1-based realm/document epoch; advances only on browser-Document replacement. */
+  documentEpoch: number;
+  /** The Document observed when this anchor was created, for replacement detection. */
+  observedDocument: unknown;
+}
+
+/** Exported so tests can simulate a fresh browser Document (a reload). */
+export const ARTWORK_VERIFICATION_DOCUMENT_ANCHOR_KEY = Symbol.for(
+  'makeit.artwork-verification.document-anchor',
+);
+
+/** The identity facts every seam reads; the bridge adds its own contract version. */
+export interface ArtworkVerificationDocumentAddress {
+  documentId: string;
+  documentEpoch: number;
+  realmDocumentId: string;
+  routeDocumentKey: string;
+}
+
+type ArtworkVerificationAnchorHost = Record<symbol, unknown>;
+
+function anchorHost(): ArtworkVerificationAnchorHost {
+  if (typeof window !== 'undefined') return window as unknown as ArtworkVerificationAnchorHost;
+  return globalThis as unknown as ArtworkVerificationAnchorHost;
+}
+
+function currentBrowserDocument(): unknown {
+  return typeof document === 'undefined' ? null : document;
+}
+
+function mintRealmDocumentId(): string {
+  const cryptoApi = (globalThis as { crypto?: { randomUUID?: () => string } }).crypto;
+  if (cryptoApi && typeof cryptoApi.randomUUID === 'function') return cryptoApi.randomUUID();
+  return `doc-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`;
+}
+
+/**
+ * Resolves (creating on first use) the browser-Document-scoped anchor. The
+ * anchor is reused for every resolution in the same browser Document; it is
+ * replaced, and the epoch advanced, only when the observed Document is actually
+ * replaced in this realm.
+ */
+export function resolveArtworkVerificationDocumentAnchor(): ArtworkVerificationDocumentAnchor {
+  const host = anchorHost();
+  const observedDocument = currentBrowserDocument();
+  const existing = host[ARTWORK_VERIFICATION_DOCUMENT_ANCHOR_KEY] as
+    | ArtworkVerificationDocumentAnchor
+    | undefined;
+  if (existing && (observedDocument === null || existing.observedDocument === observedDocument)) {
+    return existing;
+  }
+  const anchor: ArtworkVerificationDocumentAnchor = {
+    realmDocumentId: mintRealmDocumentId(),
+    documentEpoch: existing ? existing.documentEpoch + 1 : 1,
+    observedDocument,
+  };
+  host[ARTWORK_VERIFICATION_DOCUMENT_ANCHOR_KEY] = anchor;
+  return anchor;
+}
+
+/**
+ * Canonical route-document address. A trailing slash is insignificant
+ * (`/artwork/editor/a/` addresses `/artwork/editor/a`), while the id segment is
+ * preserved exactly so two route documents can never collapse into one identity.
+ */
+export function artworkVerificationRouteDocumentKey(pathname: string): string {
+  const trimmed = pathname.replace(/\/+$/, '');
+  return trimmed.length === 0 ? '/' : trimmed;
+}
+
+/**
+ * Resolves the current document/currentness identity from the live browser
+ * Document and the current route address. It is derived on every read, so it
+ * follows a client-side route change and stays stable across seam/Stage
+ * remounts; it is never derived from product content state.
+ */
+export function resolveArtworkVerificationDocumentAddress(): ArtworkVerificationDocumentAddress {
+  const anchor = resolveArtworkVerificationDocumentAnchor();
+  const pathname =
+    typeof window !== 'undefined' && window.location ? window.location.pathname : '/';
+  const routeDocumentKey = artworkVerificationRouteDocumentKey(pathname);
+  return {
+    documentId: `${anchor.realmDocumentId}:${routeDocumentKey}`,
+    documentEpoch: anchor.documentEpoch,
+    realmDocumentId: anchor.realmDocumentId,
+    routeDocumentKey,
+  };
+}
