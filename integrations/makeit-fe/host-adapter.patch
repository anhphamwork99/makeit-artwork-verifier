@@ -0,0 +1,83 @@
+import assert from 'node:assert/strict';
+import { existsSync } from 'node:fs';
+import { afterEach, test } from 'node:test';
+
+import {
+  createSmokeDirectory,
+  extractResultEnvelope,
+  parseChromiumProbe,
+  removeSmokeDirectory,
+  validatePlanSmoke,
+  validateVersionSmoke,
+} from './artwork-verifier-readiness.mjs';
+
+const temporaryRoots = [];
+
+afterEach(() => {
+  for (const root of temporaryRoots.splice(0)) removeSmokeDirectory(root);
+});
+
+test('validates the verifier version smoke envelope', () => {
+  assert.equal(
+    validateVersionSmoke({
+      status: 'PASS',
+      exitCode: 0,
+      detail: 'makeit-artwork-verifier 0.1.0',
+    }),
+    'makeit-artwork-verifier 0.1.0',
+  );
+  assert.throws(
+    () => validateVersionSmoke({ status: 'HARNESS_BLOCKED', exitCode: 2 }),
+    /unexpected result/,
+  );
+});
+
+test('requires planning smoke to be a non-launching launchable PASS', () => {
+  assert.deepEqual(
+    validatePlanSmoke({
+      status: 'PASS',
+      exitCode: 0,
+      launchAttempted: false,
+      details: {
+        caseId: 'case-1',
+        planFingerprint: 'plan-1',
+        launchability: { launchable: true },
+      },
+    }),
+    { caseId: 'case-1', planFingerprint: 'plan-1' },
+  );
+  assert.throws(
+    () =>
+      validatePlanSmoke({
+        status: 'PASS',
+        exitCode: 0,
+        launchAttempted: false,
+        details: { launchability: { launchable: false } },
+      }),
+    /launchable PASS/,
+  );
+});
+
+test('parses Chromium readiness without exposing extra process output', () => {
+  assert.deepEqual(
+    parseChromiumProbe('notice\n{"ready":true,"executablePath":"/browser/chromium"}'),
+    {
+      ready: true,
+      executablePath: '/browser/chromium',
+    },
+  );
+});
+
+test('creates and removes an isolated smoke directory', () => {
+  const root = createSmokeDirectory();
+  temporaryRoots.push(root);
+  assert.equal(existsSync(root), true);
+  removeSmokeDirectory(root);
+  temporaryRoots.splice(temporaryRoots.indexOf(root), 1);
+  assert.equal(existsSync(root), false);
+});
+
+test('extracts the final JSON result envelope', () => {
+  assert.deepEqual(extractResultEnvelope('noise\n{"status":"PASS"}'), { status: 'PASS' });
+  assert.throws(() => extractResultEnvelope('no envelope'), /JSON result envelope/);
+});
diff --git a/scripts/run-artwork-verification.mjs b/scripts/run-artwork-verification.mjs
new file mode 100644
index 00000000..6bbcb04e
--- /dev/null
+++ b/scripts/run-artwork-verification.mjs
@@ -0,0 +1,196 @@
+#!/usr/bin/env node
+
+import { existsSync } from 'node:fs';
+import { dirname, isAbsolute, join, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { spawnSync } from 'node:child_process';
+
+import { extractJsonEnvelope, writeReportBundle } from './artwork-verification-report.mjs';
+import { prepareArtworkVerificationWorkspace } from './verify-artwork-paths.mjs';
+
+import { resolveArtworkVerifierPackage } from './artwork-verifier-package.mjs';
+
+const repoRoot = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const setupScript = join(repoRoot, 'scripts', 'setup-artwork-verifier.mjs');
+const adapterScript = join(repoRoot, 'scripts', 'verify-artwork.mjs');
+const toolkitRoot = resolveArtworkVerifierPackage().packageRoot;
+
+function usage(message) {
+  process.stderr.write(`${message}\n`);
+  process.stderr.write(
+    'Usage: pnpm verify:artwork:run --case <request.json> | --suite representative\n',
+  );
+  process.exit(64);
+}
+
+function runNode(script, args) {
+  return spawnSync(process.execPath, [script, ...args], {
+    cwd: repoRoot,
+    encoding: 'utf8',
+    stdio: ['ignore', 'pipe', 'pipe'],
+    maxBuffer: 64 * 1024 * 1024,
+    env: process.env,
+  });
+}
+
+const args = process.argv.slice(2);
+const caseIndex = args.indexOf('--case');
+const suiteIndex = args.indexOf('--suite');
+const hasCase = caseIndex >= 0;
+const hasSuite = suiteIndex >= 0;
+if (args.length !== 2) {
+  usage('Use exactly one option and one value.');
+}
+if (hasCase === hasSuite) {
+  usage('Provide exactly one of `--case` or `--suite`.');
+}
+if (hasCase && !args[caseIndex + 1]) usage('`--case` requires a request path.');
+if (hasSuite && !args[suiteIndex + 1]) usage('`--suite` requires a suite name.');
+
+const setup = runNode(setupScript, ['--required']);
+if (setup.stderr) process.stderr.write(setup.stderr);
+if (setup.status !== 0) {
+  let setupResult;
+  try {
+    setupResult = extractJsonEnvelope(setup.stdout);
+  } catch {
+    setupResult = {
+      status: 'BLOCKED',
+      detail: 'Verifier setup failed without a readable result envelope.',
+    };
+  }
+  let workspace;
+  try {
+    workspace = prepareArtworkVerificationWorkspace(repoRoot);
+  } catch {
+    process.stdout.write(setup.stdout);
+    process.exit(setup.status ?? 78);
+  }
+  const reportId = `${new Date().toISOString().replace(/[-:.]/g, '')}-setup-blocked`;
+  const syntheticResult = {
+    status: 'ENVIRONMENT_FAILURE',
+    outcome: null,
+    detail: setupResult.detail,
+    diagnostics: [
+      {
+        code: 'VERIFIER_SETUP_BLOCKED',
+        severity: 'blocking',
+        detail: setupResult.detail,
+      },
+    ],
+    details: {
+      runId: null,
+      coverageStatus: null,
+      behaviorOutcome: null,
+      requiredChecks: [],
+      issues: [],
+      cleanup: null,
+      evidenceRoot: null,
+      scope: {},
+    },
+  };
+  const bundle = writeReportBundle({
+    reportsRoot: workspace.reportsRoot,
+    reportId,
+    invocation: `pnpm verify:artwork:run ${args.join(' ')}`,
+    result: syntheticResult,
+    evidenceVerification: null,
+  });
+  process.stdout.write(
+    `${JSON.stringify(
+      {
+        status: 'ENVIRONMENT_FAILURE',
+        verifierStatus: 'NOT_STARTED',
+        evidenceStatus: 'NOT_AVAILABLE',
+        reportPath: bundle.reportPath,
+        runId: null,
+        detail: setupResult.detail,
+      },
+      null,
+      2,
+    )}\n`,
+  );
+  process.exit(setup.status ?? 78);
+}
+if (setup.stdout) process.stdout.write(setup.stdout);
+
+function resolveCasePath(input) {
+  if (isAbsolute(input)) return input;
+  const applicationPath = resolve(repoRoot, input);
+  if (existsSync(applicationPath)) return applicationPath;
+  const toolkitPath = resolve(toolkitRoot, input);
+  if (existsSync(toolkitPath)) return toolkitPath;
+  return applicationPath;
+}
+
+const requestedCase = hasCase ? args[caseIndex + 1] : null;
+const requestedSuite = hasSuite ? args[suiteIndex + 1] : null;
+const invocationArgs = requestedCase
+  ? ['diagnostic', '--case', resolveCasePath(requestedCase)]
+  : ['diagnostic', '--suite', requestedSuite];
+const invocation = requestedCase
+  ? `pnpm verify:artwork diagnostic --case ${requestedCase}`
+  : `pnpm verify:artwork diagnostic --suite ${requestedSuite}`;
+const diagnostic = runNode(adapterScript, invocationArgs);
+if (diagnostic.stderr) process.stderr.write(diagnostic.stderr);
+
+let result;
+try {
+  result = extractJsonEnvelope(diagnostic.stdout);
+} catch (error) {
+  process.stderr.write(`${error.message}\n`);
+  if (diagnostic.stdout) process.stderr.write(diagnostic.stdout);
+  process.exit(diagnostic.status ?? 1);
+}
+
+const evidenceId =
+  result.details?.runId ?? result.details?.suiteExecutionId ?? result.details?.suiteId ?? null;
+let evidenceVerification = null;
+if (evidenceId) {
+  const verification = runNode(adapterScript, ['evidence', 'verify', '--run', evidenceId]);
+  if (verification.stderr) process.stderr.write(verification.stderr);
+  try {
+    evidenceVerification = extractJsonEnvelope(verification.stdout);
+  } catch {
+    evidenceVerification = {
+      status: 'HARNESS_BLOCKED',
+      exitCode: verification.status ?? 2,
+      detail: 'Evidence verification did not return a readable JSON envelope.',
+    };
+  }
+}
+
+const workspace = prepareArtworkVerificationWorkspace(repoRoot);
+const timestamp = new Date().toISOString().replace(/[-:.]/g, '');
+const identity = evidenceId ?? `no-evidence-${process.pid}`;
+const reportId = `${timestamp}-${identity}`.replace(/[^A-Za-z0-9._-]/g, '-');
+const bundle = writeReportBundle({
+  reportsRoot: workspace.reportsRoot,
+  reportId,
+  invocation,
+  result,
+  evidenceVerification,
+});
+
+const evidenceTrusted = evidenceVerification?.status === 'PASS';
+const acceptedPass = result.status === 'PASS' && evidenceTrusted;
+process.stdout.write(
+  `${JSON.stringify(
+    {
+      status: acceptedPass ? 'PASS' : result.status,
+      verifierStatus: result.status,
+      evidenceStatus: evidenceVerification?.status ?? 'NOT_AVAILABLE',
+      reportPath: bundle.reportPath,
+      runId: evidenceId,
+      detail: acceptedPass
+        ? 'Verification passed and the evidence integrity check passed.'
+        : 'Verification completed; read the generated report for the blocking result or finding.',
+    },
+    null,
+    2,
+  )}\n`,
+);
+
+if (acceptedPass) process.exit(0);
+if (result.status === 'PASS' && !evidenceTrusted) process.exit(2);
+process.exit(diagnostic.status ?? result.exitCode ?? 1);
diff --git a/scripts/setup-artwork-verifier.mjs b/scripts/setup-artwork-verifier.mjs
new file mode 100644
index 00000000..26edd2a3
--- /dev/null
+++ b/scripts/setup-artwork-verifier.mjs
@@ -0,0 +1,148 @@
+#!/usr/bin/env node
+
+import { dirname, join, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { spawnSync } from 'node:child_process';
+
+import {
+  resolveArtworkVerifierPackage,
+  resolvePlaywrightCli,
+} from './artwork-verifier-package.mjs';
+import { prepareArtworkVerificationWorkspace } from './verify-artwork-paths.mjs';
+import {
+  canonicalSmokeCase,
+  CHROMIUM_PROBE_SOURCE,
+  createSmokeDirectory,
+  extractResultEnvelope,
+  parseChromiumProbe,
+  removeSmokeDirectory,
+  validatePlanSmoke,
+  validateVersionSmoke,
+} from './artwork-verifier-readiness.mjs';
+
+const repoRoot = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+
+function output(status, detail, extra = {}) {
+  process.stdout.write(`${JSON.stringify({ status, detail, ...extra }, null, 2)}\n`);
+}
+
+function fail(detail, extra = {}) {
+  output('BLOCKED', detail, extra);
+  process.exit(78);
+}
+
+function run(command, args, options = {}) {
+  return spawnSync(command, args, {
+    cwd: options.cwd ?? repoRoot,
+    encoding: 'utf8',
+    stdio: options.inherit ? 'inherit' : ['ignore', 'pipe', 'pipe'],
+    env: process.env,
+  });
+}
+
+function nodeSupported() {
+  const [major, minor] = process.versions.node.split('.').map(Number);
+  return major > 20 || (major === 20 && minor >= 11) ? major < 25 : false;
+}
+
+if (!nodeSupported()) {
+  fail(`Node.js ${process.versions.node} is unsupported; use Node.js >=20.11 <25.`);
+}
+
+let workspace;
+try {
+  workspace = prepareArtworkVerificationWorkspace(repoRoot);
+} catch (error) {
+  fail(`Cannot scaffold the verifier workspace safely: ${error.message}`);
+}
+
+let toolkit;
+try {
+  toolkit = resolveArtworkVerifierPackage();
+} catch (error) {
+  fail(error instanceof Error ? error.message : String(error));
+}
+
+function probeChromium() {
+  const result = run(process.execPath, ['--input-type=module', '--eval', CHROMIUM_PROBE_SOURCE], {
+    cwd: toolkit.packageRoot,
+  });
+  if (result.status !== 0) return { ready: false, executablePath: null };
+  try {
+    return parseChromiumProbe(result.stdout);
+  } catch {
+    return { ready: false, executablePath: null };
+  }
+}
+
+function ensureChromium() {
+  let probe = probeChromium();
+  if (probe.ready) return probe;
+
+  let playwrightCli;
+  try {
+    playwrightCli = resolvePlaywrightCli(toolkit.packageJsonPath);
+  } catch (error) {
+    fail(error instanceof Error ? error.message : String(error));
+  }
+  const install = run(process.execPath, [playwrightCli, 'install', 'chromium'], {
+    cwd: toolkit.packageRoot,
+    inherit: true,
+  });
+  if (install.status !== 0) {
+    fail('Playwright Chromium installation failed. Review the installer output above.');
+  }
+
+  probe = probeChromium();
+  if (!probe.ready) {
+    fail('Playwright Chromium installation completed but no executable is available.');
+  }
+  return probe;
+}
+
+function runCliSmokeChecks() {
+  const version = run(process.execPath, [toolkit.entrypoint, '--version'], {
+    cwd: toolkit.packageRoot,
+  });
+  if (version.status !== 0) throw new Error('version command exited non-zero.');
+  const versionDetail = validateVersionSmoke(extractResultEnvelope(version.stdout));
+
+  const smokeRoot = createSmokeDirectory();
+  try {
+    const outDir = join(smokeRoot, 'plan');
+    const plan = run(
+      process.execPath,
+      [
+        toolkit.entrypoint,
+        'plan',
+        '--case',
+        canonicalSmokeCase(toolkit.packageRoot),
+        '--out',
+        outDir,
+      ],
+      { cwd: toolkit.packageRoot },
+    );
+    if (plan.status !== 0) throw new Error('planning command exited non-zero.');
+    return {
+      version: versionDetail,
+      planning: validatePlanSmoke(extractResultEnvelope(plan.stdout)),
+    };
+  } finally {
+    removeSmokeDirectory(smokeRoot);
+  }
+}
+
+const chromium = ensureChromium();
+let smoke;
+try {
+  smoke = runCliSmokeChecks();
+} catch (error) {
+  fail(`Verifier CLI smoke checks failed: ${error.message}`, { smokeCheck: 'cli' });
+}
+
+output('READY', 'Installed Artwork verifier package and FE workspace are ready.', {
+  toolkitPackage: toolkit.identity,
+  chromium,
+  smoke,
+  workspace,
+});
diff --git a/scripts/verify-artwork-paths.mjs b/scripts/verify-artwork-paths.mjs
new file mode 100644
index 00000000..68fe5ca7
--- /dev/null
+++ b/scripts/verify-artwork-paths.mjs
@@ -0,0 +1,83 @@
+import { lstatSync, mkdirSync, realpathSync } from 'node:fs';
+import { join, resolve } from 'node:path';
+
+export const ARTWORK_VERIFICATION_DIRECTORY = 'artwork-editor-verification';
+export const ARTWORK_EVIDENCE_DIRECTORY = 'evidence';
+export const ARTWORK_REPORTS_DIRECTORY = 'reports';
+export const ARTWORK_REQUESTS_DIRECTORY = 'requests';
+
+export function artworkEvidenceRootFor(repoRoot) {
+  return join(resolve(repoRoot), ARTWORK_VERIFICATION_DIRECTORY, ARTWORK_EVIDENCE_DIRECTORY);
+}
+
+export function ensureOwnedDirectory(directory) {
+  let stat;
+  try {
+    stat = lstatSync(directory);
+  } catch (error) {
+    if (error?.code !== 'ENOENT') throw error;
+    try {
+      mkdirSync(directory, { mode: 0o700 });
+    } catch (mkdirError) {
+      if (mkdirError?.code !== 'EEXIST') throw mkdirError;
+    }
+    stat = lstatSync(directory);
+  }
+
+  if (stat.isSymbolicLink() || !stat.isDirectory()) {
+    throw new Error('the FE-owned artwork verification path must contain only real directories.');
+  }
+}
+
+/**
+ * Provision the FE-owned runtime evidence base without following a symlink.
+ *
+ * The toolkit requires an existing canonical absolute directory. Creating each
+ * application-owned segment independently preserves that contract without
+ * allowing a recursive mkdir to traverse a substituted symlink.
+ */
+export function prepareArtworkEvidenceRoot(repoRoot) {
+  const normalizedRoot = resolve(repoRoot);
+  const canonicalRoot = realpathSync(normalizedRoot);
+  if (canonicalRoot !== normalizedRoot) {
+    throw new Error(
+      'the FE checkout path must be canonical and must not resolve through a symlink.',
+    );
+  }
+
+  const verificationRoot = join(canonicalRoot, ARTWORK_VERIFICATION_DIRECTORY);
+  ensureOwnedDirectory(verificationRoot);
+
+  const evidenceRoot = join(verificationRoot, ARTWORK_EVIDENCE_DIRECTORY);
+  ensureOwnedDirectory(evidenceRoot);
+
+  if (realpathSync(evidenceRoot) !== evidenceRoot) {
+    throw new Error('the FE-owned artwork evidence root must be canonical.');
+  }
+  return evidenceRoot;
+}
+
+/**
+ * Scaffold the application-owned verifier workspace.
+ *
+ * Empty directories are intentionally local-only. Evidence, reports and
+ * user-authored request drafts must never become part of the product source
+ * or the commit-pinned toolkit.
+ */
+export function prepareArtworkVerificationWorkspace(repoRoot) {
+  const evidenceRoot = prepareArtworkEvidenceRoot(repoRoot);
+  const verificationRoot = join(resolve(repoRoot), ARTWORK_VERIFICATION_DIRECTORY);
+  const directories = {
+    verificationRoot,
+    evidenceRoot,
+    runsRoot: join(evidenceRoot, 'runs'),
+    suitesRoot: join(evidenceRoot, 'suites'),
+    reportsRoot: join(verificationRoot, ARTWORK_REPORTS_DIRECTORY),
+    requestsRoot: join(verificationRoot, ARTWORK_REQUESTS_DIRECTORY),
+  };
+
+  for (const directory of Object.values(directories)) {
+    ensureOwnedDirectory(directory);
+  }
+  return directories;
+}
