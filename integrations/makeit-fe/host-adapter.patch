@@ -0,0 +1,435 @@
+'use client';
+
+import { resolveArtworkVerificationDocumentAddress } from '@/lib/artwork/verification/documentIdentity';
+import { useArtworkEditorStore } from '@/stores/artworkEditorStore';
+
+/**
+ * Document-scoped observation signal anchor (WP5 Slice 5-A; supervisor R1–R4).
+ *
+ * The read-only observation bridge needs a wake source correlated to
+ * authoritative product state, not to arbitrary store notifications. This
+ * module owns that source privately:
+ *
+ * - one monotonic `revision` scoped to the current browser `Document`;
+ * - one versioned `state-v1` fingerprint over authority-relevant state only;
+ * - one bridge-owned Zustand subscription at a time;
+ * - the pending waiter set and its bounded timers.
+ *
+ * Nothing here mutates product state. The anchor is stored on the same live
+ * host the shared document identity uses, keyed by a registered Symbol, so it
+ * persists across Stage/bridge remounts in one browser Document and never
+ * appears in enumeration, JSON, logs, or evidence.
+ */
+
+/** Cursor schema version carried by every corollary observation. */
+export const ARTWORK_VERIFICATION_CURSOR_SCHEMA_VERSION = 1;
+
+/**
+ * Seam-unique registered-Symbol slot for the private signal anchor. The
+ * production-absence vocabulary keys off this exact value, so it must never be
+ * a generic word such as `cursor`.
+ */
+export const ARTWORK_VERIFICATION_SIGNAL_ANCHOR_KEY = Symbol.for(
+  'makeit.artwork-verification.signal-anchor',
+);
+
+/**
+ * Seam-unique discriminant emitted only by this module. It gives the hostile
+ * production scan a unique string to prove the signal module is unreachable
+ * without matching a generic English word.
+ */
+export const ARTWORK_VERIFICATION_CURSOR_DISCRIMINANT =
+  'makeit.artwork-verification.observation-cursor.v1';
+
+/** Why an observation cursor could no longer be used as authority. */
+export type ArtworkVerificationInvalidationReason =
+  | 'document-mismatch'
+  | 'document-epoch-mismatch'
+  | 'bridge-version-mismatch'
+  | 'bridge-generation-mismatch'
+  | 'bridge-unmounted';
+
+/** Document-correlated facts stamped onto every authority-bearing read. */
+export interface ArtworkVerificationSignalCursorFacts {
+  documentId: string;
+  documentEpoch: number;
+  bridgeGeneration: number;
+  revision: number;
+}
+
+/** The bounded waiter outcome; a timeout is a wake result, not a verdict. */
+export type ArtworkVerificationSignalWake =
+  | {
+      kind: 'changed';
+      wakeSource: 'already-advanced' | 'store-signal';
+      cursor: ArtworkVerificationSignalCursorFacts;
+    }
+  | { kind: 'timeout'; cursor: ArtworkVerificationSignalCursorFacts }
+  | { kind: 'invalidated'; reason: ArtworkVerificationInvalidationReason; revision: number };
+
+/** Raised when a cursor read cannot return trustworthy authority. */
+export class ArtworkVerificationSignalError extends Error {
+  readonly reason: ArtworkVerificationInvalidationReason;
+
+  constructor(reason: ArtworkVerificationInvalidationReason, detail: string) {
+    super(detail);
+    this.name = 'ArtworkVerificationSignalError';
+    this.reason = reason;
+  }
+}
+
+interface ArtworkVerificationSignalWaiter {
+  afterRevision: number;
+  generation: number;
+  timer: ReturnType<typeof setTimeout> | null;
+  resolve: (wake: ArtworkVerificationSignalWake) => void;
+}
+
+/** The private, non-enumerable signal anchor. Never exported as a bridge surface. */
+export interface ArtworkVerificationSignalAnchor {
+  observedDocument: unknown;
+  documentId: string | null;
+  documentEpoch: number | null;
+  revision: number;
+  lastFingerprint: string;
+  nextGeneration: number;
+  activeGeneration: number | null;
+  invalidatedReason: ArtworkVerificationInvalidationReason | null;
+  overflowed: boolean;
+  unsubscribe: (() => void) | null;
+  waiters: Set<ArtworkVerificationSignalWaiter>;
+}
+
+type SignalAnchorHost = Record<symbol, unknown>;
+
+function anchorHost(): SignalAnchorHost {
+  if (typeof window !== 'undefined') return window as unknown as SignalAnchorHost;
+  return globalThis as unknown as SignalAnchorHost;
+}
+
+function currentBrowserDocument(): unknown {
+  return typeof document === 'undefined' ? null : document;
+}
+
+/**
+ * The authority-relevant `state-v1` fingerprint. It deliberately excludes the
+ * stale-prone `nodes`/`rootIds` mirror, hover, clipboard, property-panel tab,
+ * tool-only state, and action functions, so a duplicate or unrelated
+ * notification cannot advance the revision.
+ */
+export function readArtworkVerificationSignalFingerprint(): string {
+  const state = useArtworkEditorStore.getState();
+  return JSON.stringify({
+    layoutItems: state.layoutItems,
+    activeLayoutId: state.activeLayoutId,
+    selectedLayoutIds: state.selectedLayoutIds,
+    selectedLayerIds: state.selectedLayers.map((layer) => layer.id),
+    primarySelectedLayerId: state.primarySelectedLayerId,
+    optimisticSelectedLayerId: state.optimisticSelectedLayerId,
+    camera: state.camera,
+    isPanning: state.isPanning,
+    pastDepth: Array.isArray(state.past) ? state.past.length : 0,
+    futureDepth: Array.isArray(state.future) ? state.future.length : 0,
+    canUndo: state.canUndo,
+    canRedo: state.canRedo,
+  });
+}
+
+/**
+ * Resolves (creating, and recreating on browser-Document replacement) the
+ * document-scoped signal anchor. Revision restarts at 0 only when the browser
+ * Document itself is replaced, never on a Stage/bridge remount.
+ */
+export function resolveArtworkVerificationSignalAnchor(): ArtworkVerificationSignalAnchor {
+  const host = anchorHost();
+  const observedDocument = currentBrowserDocument();
+  const existing = host[ARTWORK_VERIFICATION_SIGNAL_ANCHOR_KEY] as
+    | ArtworkVerificationSignalAnchor
+    | undefined;
+  if (existing && (observedDocument === null || existing.observedDocument === observedDocument)) {
+    return existing;
+  }
+  const anchor: ArtworkVerificationSignalAnchor = {
+    observedDocument,
+    documentId: null,
+    documentEpoch: null,
+    revision: 0,
+    lastFingerprint: readArtworkVerificationSignalFingerprint(),
+    nextGeneration: 1,
+    activeGeneration: null,
+    invalidatedReason: null,
+    overflowed: false,
+    unsubscribe: null,
+    waiters: new Set(),
+  };
+  host[ARTWORK_VERIFICATION_SIGNAL_ANCHOR_KEY] = anchor;
+  return anchor;
+}
+
+function cursorFacts(
+  anchor: ArtworkVerificationSignalAnchor,
+  generation: number,
+): ArtworkVerificationSignalCursorFacts {
+  return {
+    documentId: anchor.documentId ?? '',
+    documentEpoch: anchor.documentEpoch ?? 0,
+    bridgeGeneration: generation,
+    revision: anchor.revision,
+  };
+}
+
+function removeWaiter(
+  anchor: ArtworkVerificationSignalAnchor,
+  waiter: ArtworkVerificationSignalWaiter,
+): void {
+  anchor.waiters.delete(waiter);
+  if (waiter.timer !== null) {
+    clearTimeout(waiter.timer);
+    waiter.timer = null;
+  }
+}
+
+/**
+ * Fails closed: the generation stops being active, the private subscription is
+ * released, and every pending waiter is resolved as invalidated. Used for
+ * unmount, document replacement, and safe-integer exhaustion.
+ */
+function failClosed(
+  anchor: ArtworkVerificationSignalAnchor,
+  reason: ArtworkVerificationInvalidationReason,
+): void {
+  anchor.invalidatedReason = reason;
+  anchor.activeGeneration = null;
+  if (anchor.unsubscribe) {
+    try {
+      anchor.unsubscribe();
+    } catch {
+      // A throwing unsubscribe must not prevent waiter/global cleanup.
+    }
+    anchor.unsubscribe = null;
+  }
+  for (const waiter of [...anchor.waiters]) {
+    removeWaiter(anchor, waiter);
+    waiter.resolve({ kind: 'invalidated', reason, revision: anchor.revision });
+  }
+}
+
+/**
+ * Every public read, waiter comparison, and subscription callback reconciles
+ * the live document identity before returning authority, so a client-side route
+ * document change invalidates the generation before any mixed-identity payload
+ * can be produced.
+ */
+function reconcileIdentity(anchor: ArtworkVerificationSignalAnchor): void {
+  if (anchor.invalidatedReason !== null) return;
+  if (anchor.documentId === null || anchor.documentEpoch === null) return;
+  const address = resolveArtworkVerificationDocumentAddress();
+  if (anchor.documentEpoch !== address.documentEpoch) {
+    failClosed(anchor, 'document-epoch-mismatch');
+    return;
+  }
+  if (anchor.documentId !== address.documentId) {
+    failClosed(anchor, 'document-mismatch');
+  }
+}
+
+function settleAdvanced(
+  anchor: ArtworkVerificationSignalAnchor,
+  wakeSource: 'already-advanced' | 'store-signal',
+): void {
+  for (const waiter of [...anchor.waiters]) {
+    if (anchor.revision > waiter.afterRevision) {
+      removeWaiter(anchor, waiter);
+      waiter.resolve({
+        kind: 'changed',
+        wakeSource,
+        cursor: cursorFacts(anchor, waiter.generation),
+      });
+    }
+  }
+}
+
+/**
+ * Reconciles the live fingerprint and advances the revision exactly once per
+ * meaningful transition. `wakeSource` distinguishes a subscription-driven wake
+ * (`store-signal`) from a synchronous reconciliation catch
+ * (`already-advanced`); a reconciliation catch is never mislabelled a signal.
+ */
+function advanceFingerprint(anchor: ArtworkVerificationSignalAnchor, viaSignal: boolean): void {
+  if (anchor.overflowed) return;
+  const fingerprint = readArtworkVerificationSignalFingerprint();
+  if (fingerprint === anchor.lastFingerprint) return;
+  if (anchor.revision >= Number.MAX_SAFE_INTEGER) {
+    anchor.overflowed = true;
+    failClosed(anchor, 'bridge-generation-mismatch');
+    return;
+  }
+  anchor.revision += 1;
+  anchor.lastFingerprint = fingerprint;
+  settleAdvanced(anchor, viaSignal ? 'store-signal' : 'already-advanced');
+}
+
+/**
+ * Starts one bridge generation: invalidates/releases any prior generation,
+ * allocates the next generation, reconciles the current fingerprint without
+ * resetting revision, and installs exactly one private subscription.
+ */
+export function beginArtworkVerificationSignalGeneration(): number {
+  const anchor = resolveArtworkVerificationSignalAnchor();
+  if (anchor.activeGeneration !== null) failClosed(anchor, 'bridge-unmounted');
+
+  const address = resolveArtworkVerificationDocumentAddress();
+  anchor.documentId = address.documentId;
+  anchor.documentEpoch = address.documentEpoch;
+  anchor.lastFingerprint = readArtworkVerificationSignalFingerprint();
+  anchor.invalidatedReason = null;
+
+  const generation = anchor.nextGeneration;
+  anchor.nextGeneration += 1;
+  anchor.activeGeneration = generation;
+  anchor.unsubscribe = useArtworkEditorStore.subscribe(() => {
+    reconcileIdentity(anchor);
+    if (anchor.invalidatedReason === null) advanceFingerprint(anchor, true);
+  });
+  return generation;
+}
+
+/**
+ * Idempotently ends one generation. A cleanup for an already-replaced
+ * generation is a no-op, so an old StrictMode cleanup can never release the
+ * replacement's subscription, invalidate its waiters, or delete its global.
+ */
+export function endArtworkVerificationSignalGeneration(generation: number): void {
+  const anchor = resolveArtworkVerificationSignalAnchor();
+  if (anchor.activeGeneration !== generation) return;
+  failClosed(anchor, 'bridge-unmounted');
+}
+
+/**
+ * Synchronously reconciles identity and fingerprint and returns a stamped
+ * cursor. Throws `ArtworkVerificationSignalError` when the contained generation
+ * is no longer trustworthy authority.
+ */
+export function readArtworkVerificationSignalCursor(
+  generation: number,
+): ArtworkVerificationSignalCursorFacts {
+  const anchor = resolveArtworkVerificationSignalAnchor();
+  if (anchor.overflowed) {
+    throw new ArtworkVerificationSignalError(
+      'bridge-generation-mismatch',
+      'Observation revision exhausted the safe-integer domain; authority fails closed.',
+    );
+  }
+  if (anchor.activeGeneration !== generation) {
+    throw new ArtworkVerificationSignalError(
+      anchor.activeGeneration === null ? 'bridge-unmounted' : 'bridge-generation-mismatch',
+      'Observation bridge generation is no longer active.',
+    );
+  }
+  reconcileIdentity(anchor);
+  if (anchor.invalidatedReason !== null) {
+    throw new ArtworkVerificationSignalError(
+      anchor.invalidatedReason,
+      `Observation authority was invalidated: ${anchor.invalidatedReason}.`,
+    );
+  }
+  advanceFingerprint(anchor, false);
+  if (anchor.invalidatedReason !== null) {
+    throw new ArtworkVerificationSignalError(
+      anchor.invalidatedReason,
+      `Observation authority was invalidated: ${anchor.invalidatedReason}.`,
+    );
+  }
+  return cursorFacts(anchor, generation);
+}
+
+/**
+ * Race-free `waitForChange` core:
+ *
+ * 1. validate generation/document identity against the live anchor;
+ * 2. reconcile the fingerprint and resolve `already-advanced` if the retained
+ *    revision already passed the caller's revision;
+ * 3. register a pending waiter, then reconcile and compare again to close the
+ *    compare-before-subscribe race;
+ * 4. otherwise resolve on the next signal, invalidation, or bounded timeout.
+ *
+ * A waiter and its timer are always removed before its promise settles.
+ */
+export function waitForArtworkVerificationChange(input: {
+  generation: number;
+  after: ArtworkVerificationSignalCursorFacts;
+  timeoutMs: number;
+}): Promise<ArtworkVerificationSignalWake> {
+  return new Promise<ArtworkVerificationSignalWake>((resolve) => {
+    const anchor = resolveArtworkVerificationSignalAnchor();
+    const invalidate = (reason: ArtworkVerificationInvalidationReason) => {
+      resolve({ kind: 'invalidated', reason, revision: anchor.revision });
+    };
+
+    if (anchor.overflowed) {
+      invalidate('bridge-generation-mismatch');
+      return;
+    }
+    if (anchor.activeGeneration !== input.generation) {
+      invalidate(
+        anchor.activeGeneration === null ? 'bridge-unmounted' : 'bridge-generation-mismatch',
+      );
+      return;
+    }
+
+    reconcileIdentity(anchor);
+    if (anchor.invalidatedReason !== null) {
+      invalidate(anchor.invalidatedReason);
+      return;
+    }
+    const address = resolveArtworkVerificationDocumentAddress();
+    if (input.after.documentEpoch !== address.documentEpoch) {
+      invalidate('document-epoch-mismatch');
+      return;
+    }
+    if (input.after.documentId !== address.documentId) {
+      invalidate('document-mismatch');
+      return;
+    }
+
+    advanceFingerprint(anchor, false);
+    if (anchor.revision > input.after.revision) {
+      resolve({
+        kind: 'changed',
+        wakeSource: 'already-advanced',
+        cursor: cursorFacts(anchor, input.generation),
+      });
+      return;
+    }
+
+    const waiter: ArtworkVerificationSignalWaiter = {
+      afterRevision: input.after.revision,
+      generation: input.generation,
+      timer: null,
+      resolve,
+    };
+    anchor.waiters.add(waiter);
+
+    reconcileIdentity(anchor);
+    if (anchor.invalidatedReason !== null) {
+      removeWaiter(anchor, waiter);
+      invalidate(anchor.invalidatedReason);
+      return;
+    }
+    advanceFingerprint(anchor, false);
+    if (anchor.revision > waiter.afterRevision) {
+      removeWaiter(anchor, waiter);
+      resolve({
+        kind: 'changed',
+        wakeSource: 'already-advanced',
+        cursor: cursorFacts(anchor, input.generation),
+      });
+      return;
+    }
+
+    waiter.timer = setTimeout(() => {
+      removeWaiter(anchor, waiter);
+      resolve({ kind: 'timeout', cursor: cursorFacts(anchor, input.generation) });
+    }, input.timeoutMs);
+  });
+}
