+/**
+ * Pure FE-owned compatibility declaration for the private Artwork verifier.
+ *
+ * This module intentionally has no application imports so the standalone
+ * toolkit can load the product provider from an explicit app root during Node
+ * preflight. The browser bridge and provider both consume these constants,
+ * preventing their declared bridge identity from drifting.
+ */
+
+/** Observation bridge contract exposed by the current FE source. */
+export const ARTWORK_VERIFICATION_BRIDGE_VERSION = 7;
+
+/** Closed schema for the toolkit's narrow FE-host compatibility preflight. */
+export const HOST_COMPATIBILITY_SCHEMA_VERSION = 1;
+
+/**
+ * Product-owned declaration of verification-boundary capabilities. Versions
+ * change only when the observable contract changes, not for internal refactors.
+ */
+export const artworkVerificationHostCompatibility = Object.freeze({
+  schemaVersion: HOST_COMPATIBILITY_SCHEMA_VERSION,
+  bridgeVersion: ARTWORK_VERIFICATION_BRIDGE_VERSION,
+  capabilities: Object.freeze({
+    'image-upload.public-control': 'role-name-v1',
+    'nested-object.identity-wrapper': 'chain-v1',
+    'history.semantic-transition': 'meaning-revision-v1',
+  }),
+});
diff --git a/src/lib/artwork/verification/nestedObjectGeometry.ts b/src/lib/artwork/verification/nestedObjectGeometry.ts
new file mode 100644
index 00000000..b61841a4
--- /dev/null
+++ b/src/lib/artwork/verification/nestedObjectGeometry.ts
@@ -0,0 +1,2501 @@
+'use client';
+
+import type Konva from 'konva';
+
+import {
+  affineAgreesWithin,
+  affinePreimage,
+  applyAffine,
+  canonicalScalar,
+  composeChain,
+  fnv1a64Hex,
+  frameToParentMatrix,
+  isFiniteAffine,
+  isFinitePoint,
+  measureStageCssFacts,
+  multiplyAffine,
+  readRelativeAffine,
+  readStageViewMatrix,
+  scaleAffine,
+  transformQuad,
+  translationAffine,
+  type Affine2D,
+  type GeometryPoint,
+  type Quad,
+} from '@/lib/artwork/verification/affineProjection';
+
+/**
+ * Nested Object local/world affine-chain geometry for observation bridge v6
+ * (WP5 Slice 5-D, ADR 0013 R4–R8).
+ *
+ * Canonical application state owns ids, containment, parent-local coordinates,
+ * ordering, and persisted transform intent. The live mounted renderer owns the
+ * composed transform and hit ownership. This module composes both
+ * independently:
+ *
+ * ```text
+ * text-witness
+ *   -- canonical frame --> object-inner
+ *   -- canonical frame --> object-outer
+ *   -- canonical frame --> layout-object-active
+ *   -- live layout      --> world-scene
+ *   -- live Stage + CSS --> browser-client-css
+ * ```
+ *
+ * The canonical witness→Layout matrix is recomposed from snapshot state alone;
+ * the rendered witness→Layout matrix is read from the mounted witness node
+ * relative to the mounted Layout node with the uncached
+ * `getAbsoluteTransform(layoutNode)`. Agreement is decided on corresponding
+ * points, never on fingerprint equality, bounding boxes, or a scalar zoom.
+ */
+
+// ── Versions, kinds, and vocabularies ───────────────────────────────────────
+
+/** Typed geometry schema version exposed by bridge v6. */
+export const NESTED_OBJECT_GEOMETRY_SCHEMA_VERSION = 3;
+
+/** Seam-unique geometry-schema discriminant for this module. */
+export const NESTED_OBJECT_GEOMETRY_DISCRIMINANT = 'makeit.artwork-verification.geometry.v3';
+
+/** The one representation kind this slice authorizes (ADR 0015 B6). */
+export const NESTED_OBJECT_AFFINE_CHAIN_KIND = 'nested-object-affine-chain-v2';
+
+/** Published representation version for the v2 dual-frame contract. */
+export const NESTED_OBJECT_REPRESENTATION_VERSION = 2;
+
+/**
+ * Exact product Text renderer-frame padding for the plain, scale-text,
+ * no-shadow, zero-frame-shift witness (ADR 0015 B7/B8). Any drift is a
+ * harness block, never an implicit generalization to other Text variants.
+ */
+export const NESTED_TEXT_FRAME_PADDING = 8;
+
+/** Typed pair-explicit request schema version. */
+export const NESTED_OBJECT_REQUEST_SCHEMA_VERSION = 1;
+
+export const NESTED_OBJECT_POINT_ORDER = [
+  'top-left',
+  'top-right',
+  'bottom-right',
+  'bottom-left',
+] as const;
+export type NestedObjectPointLabel = (typeof NESTED_OBJECT_POINT_ORDER)[number];
+
+/** Truthful units per declared space. */
+export const NESTED_OBJECT_SPACE_UNITS = Object.freeze({
+  subjectLocal: 'artwork-unit',
+  parentLocal: 'artwork-unit',
+  layoutLocal: 'artwork-unit',
+  worldScene: 'scene-unit',
+  stageViewportCss: 'css-px',
+  browserClientCss: 'css-px',
+});
+
+export const NESTED_OBJECT_CHAIN_FINGERPRINT_PREIMAGE_VERSION = 'makeit.nested-object-chain.v2';
+export const NESTED_OBJECT_REPRESENTATION_FINGERPRINT_PREIMAGE_VERSION =
+  'makeit.geometry-representation.v3.nested-object-v2';
+export const NESTED_OBJECT_INTERACTION_FINGERPRINT_PREIMAGE_VERSION =
+  'makeit.nested-object-interaction.v1';
+export const NESTED_OBJECT_RECORD_FINGERPRINT_PREIMAGE_VERSION = 'makeit.nested-object-record.v1';
+
+/** Camera canonical/live agreement tolerance (R7). */
+export const NESTED_OBJECT_CAMERA_TOLERANCE = 1e-6;
+
+/** Canonical discrete/affine epsilon (CANONICAL_EXACT@1). */
+export const NESTED_OBJECT_CANONICAL_EPSILON = 1e-6;
+
+/** Rendered browser-client corresponding-point tolerance (RENDER_TRANSFORM_CSS@1). */
+export const NESTED_OBJECT_RENDER_TOLERANCE_CSS_PX = 0.25;
+
+// ── Purpose-scoped interaction vocabularies (ADR 0014 R4/R6) ────────────────
+
+/** The two closed phase/purpose pairs. */
+export type NestedObjectInteractionContext =
+  | { phase: 'pre-action'; purpose: 'authorize-native-action' }
+  | { phase: 'post-action'; purpose: 'observe-authoritative-geometry' };
+
+/** Closed R8 target-quad probe candidate vocabulary, in fixed search order. */
+export const NESTED_INTERACTION_CANDIDATES = [
+  'center',
+  'upper-right',
+  'lower-right',
+  'lower-left',
+  'upper-left',
+] as const;
+export type NestedInteractionCandidate = (typeof NESTED_INTERACTION_CANDIDATES)[number];
+
+/** Closed allowlisted Konva node-class descriptor; never a raw dump. */
+export const SAFE_HIT_NODE_CLASSES = ['Rect', 'Circle', 'Group', 'Transformer', 'Other'] as const;
+export type SafeHitNodeClass = (typeof SAFE_HIT_NODE_CLASSES)[number] | null;
+
+/** The only static chrome name this repair may record. */
+export const SAFE_CHROME_NAME = 'artwork-chrome';
+export type SafeChromeName = typeof SAFE_CHROME_NAME | null;
+
+export interface SafeHitDescriptor {
+  nodeClass: SafeHitNodeClass;
+  chromeName: SafeChromeName;
+  ownedByTarget: boolean;
+}
+
+export type NestedPostHitClassification =
+  | 'target'
+  | 'owned-non-chrome-descendant'
+  | 'selection-chrome'
+  | 'transform-chrome'
+  | 'foreign-listening-node'
+  | 'no-hit';
+
+export type NestedPreHitClassification = 'target' | 'owned-non-chrome-descendant';
+
+/**
+ * Pre-action interaction member: the only action-authorizing hit. `authority`
+ * is `action`, `status` is `authorized`, and the classification is strictly
+ * target-owned and chrome-free.
+ */
+export interface NestedObjectPreActionInteraction {
+  phase: 'pre-action';
+  purpose: 'authorize-native-action';
+  authority: 'action';
+  status: 'authorized';
+  targetId: string;
+  space: 'browser-client-css';
+  candidate: NestedInteractionCandidate;
+  point: GeometryPoint;
+  safetyInsetCssPx: 4;
+  source: 'live-konva-hit-v1';
+  hitClassification: NestedPreHitClassification;
+  interactionFingerprint: string;
+}
+
+/**
+ * Post-action interaction member: authoritative geometry observation with
+ * `authority:'none'` that truthfully records the deterministic probe result,
+ * including selection-chrome obstruction.
+ */
+export interface NestedObjectPostActionInteraction {
+  phase: 'post-action';
+  purpose: 'observe-authoritative-geometry';
+  authority: 'none';
+  status: 'clear' | 'obstructed';
+  targetId: string;
+  space: 'browser-client-css';
+  candidate: NestedInteractionCandidate;
+  point: GeometryPoint;
+  safetyInsetCssPx: 4;
+  source: 'live-konva-hit-v1';
+  hitClassification: NestedPostHitClassification;
+  obstructionCode: null | 'POST_ACTION_HIT_OBSTRUCTED';
+  safeHitDescriptor: SafeHitDescriptor;
+  interactionFingerprint: string;
+}
+
+export type NestedObjectGeometryInteraction =
+  | NestedObjectPreActionInteraction
+  | NestedObjectPostActionInteraction;
+
+/** One interaction member without its own fingerprint, as projected. */
+export type NestedObjectInteractionInput =
+  | Omit<NestedObjectPreActionInteraction, 'interactionFingerprint'>
+  | Omit<NestedObjectPostActionInteraction, 'interactionFingerprint'>;
+
+export const NESTED_OBJECT_SAFETY_INSET_CSS_PX = 4 as const;
+
+// ── Types ───────────────────────────────────────────────────────────────────
+
+export type NestedObjectFrameKind = 'object' | 'text';
+
+/**
+ * The complete persisted intent for one witness/Object frame, expressed in its
+ * parent-local space. Content/style/warp facts are deliberately absent: the
+ * affine chain depends only on the frame, rotation, and flips.
+ */
+export interface NestedObjectFrameFacts {
+  id: string;
+  kind: NestedObjectFrameKind;
+  parentId: string;
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+  rotationDegrees: number;
+  flipX: boolean;
+  flipY: boolean;
+}
+
+export interface NestedObjectPersistedFrame {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+  rotationDegrees: number;
+  flipX: boolean;
+  flipY: boolean;
+}
+
+export type NestedObjectRenderDerivation =
+  | 'object-wrapper-plus-center-rotation-v1'
+  | 'plain-text-frame-padding-v1';
+
+export interface NestedObjectFramePadding {
+  left: number;
+  right: number;
+  top: number;
+  bottom: number;
+}
+
+export interface NestedObjectRenderFrame {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+  rotationDegrees: number;
+  derivation: NestedObjectRenderDerivation;
+  padding: NestedObjectFramePadding | null;
+  frameShift: { x: number; y: number };
+}
+
+/**
+ * One chain segment under the ADR 0015 v2 dual-frame contract. The persisted
+ * frame is the semantic parent-local intent; the render frame is the exact
+ * mounted renderer frame (Text padding / Object wrappers). `canonicalRenderMatrix`
+ * is the render frame's parent-local affine map and the composition authority.
+ */
+export interface CanonicalChainSegmentV2 {
+  id: string;
+  kind: NestedObjectFrameKind;
+  parentId: string;
+  persistedFrame: NestedObjectPersistedFrame;
+  renderFrame: NestedObjectRenderFrame;
+  canonicalRenderMatrix: Affine2D;
+}
+
+export interface NestedObjectNormalizationFacts {
+  certificateVersion: string;
+  fixedPoint: boolean;
+  referentiallyUnchanged: boolean;
+  subtreeFingerprint: string;
+}
+
+/** The closed target-Object wrapper facts (ADR 0015 B9). */
+export interface NestedObjectTargetWrappers {
+  translationWrapperToLayout: Affine2D;
+  centerRotationSubtreeToTranslationWrapper: Affine2D;
+  completeObjectToLayout: Affine2D;
+  flipShellIdentity: boolean;
+  wrapperStructureValidated: true;
+}
+
+export interface NestedObjectGeometryV3 {
+  schemaVersion: typeof NESTED_OBJECT_GEOMETRY_SCHEMA_VERSION;
+  discriminant: typeof NESTED_OBJECT_GEOMETRY_DISCRIMINANT;
+  representation: {
+    kind: typeof NESTED_OBJECT_AFFINE_CHAIN_KIND;
+    representationVersion: typeof NESTED_OBJECT_REPRESENTATION_VERSION;
+    pointOrder: typeof NESTED_OBJECT_POINT_ORDER;
+    units: typeof NESTED_OBJECT_SPACE_UNITS;
+    targetId: string;
+    witnessId: string;
+    layoutId: string;
+    canonicalChain: readonly CanonicalChainSegmentV2[];
+    targetCanonicalFrame: CanonicalChainSegmentV2;
+    witnessCanonicalFrame: CanonicalChainSegmentV2;
+    canonicalWitnessLocalQuad: Quad;
+    persistedWitnessContentQuad: Quad;
+    targetWrappers: NestedObjectTargetWrappers;
+    canonicalLayoutQuad: Quad;
+    renderedLayoutQuad: Quad;
+    renderedWorldSceneQuad: Quad;
+    renderedStageViewportCssQuad: Quad;
+    renderedBrowserClientCssQuad: Quad;
+    representationFingerprint: string;
+    matrices: {
+      canonicalWitnessToLayout: Affine2D;
+      renderedWitnessToLayout: Affine2D;
+      layoutToWorldScene: Affine2D;
+      worldSceneToStageViewportCss: Affine2D;
+      stageViewportToBrowserClientCss: Affine2D;
+    };
+  };
+  camera: {
+    canonical: { x: number; y: number; zoom: number };
+    stageMatrix: Affine2D;
+    cssRatios: { x: number; y: number };
+  };
+  typedProvenance: {
+    bridgeGeneration: number;
+    target: { id: string; konvaId: string; fingerprint: string };
+    witness: { id: string; konvaId: string; fingerprint: string };
+    layout: { id: string; konvaId: string; fingerprint: string };
+    chainFingerprint: string;
+    representationFingerprint: string;
+    stageFingerprint: string;
+  };
+  interaction: NestedObjectGeometryInteraction;
+  normalization: NestedObjectNormalizationFacts;
+  chainFingerprint: string;
+  /** Correlation fact only; never a substitute for field validation. */
+  recordFingerprint: string;
+}
+
+export interface NestedObjectGeometryTypedRequest {
+  schemaVersion: typeof NESTED_OBJECT_REQUEST_SCHEMA_VERSION;
+  representation: typeof NESTED_OBJECT_AFFINE_CHAIN_KIND;
+  targetId: string;
+  witnessId: string;
+  layoutId: string;
+  interaction: NestedObjectInteractionContext;
+}
+
+export interface NestedObjectGeometryFailure {
+  code:
+    | 'GEOMETRY_REPRESENTATION_UNSUPPORTED'
+    | 'GEOMETRY_TRANSFORM_INVALID'
+    | 'GEOMETRY_CHAIN_INVALID'
+    | 'GEOMETRY_CHAIN_ID_MISMATCH'
+    | 'GEOMETRY_PARENT_MISMATCH'
+    | 'GEOMETRY_CAMERA_MISMATCH'
+    | 'GEOMETRY_TARGET_ID_MISMATCH'
+    | 'HIT_POINT_UNAVAILABLE'
+    | 'TARGET_QUAD_INTERACTION_POINT_INVALID';
+  reason: string;
+  detail: string;
+}
+
+export type NestedObjectGeometryResult =
+  | { ok: true; record: NestedObjectGeometryV3 }
+  | { ok: false; failure: NestedObjectGeometryFailure };
+
+function fail(
+  code: NestedObjectGeometryFailure['code'],
+  reason: string,
+  detail: string,
+): NestedObjectGeometryResult {
+  return { ok: false, failure: { code, reason, detail } };
+}
+
+// ── Canonical chain ─────────────────────────────────────────────────────────
+
+/**
+ * The canonical subject/parent-local matrix of one frame, from persisted intent
+ * alone (R5): center translation → rotation → flip → negative-center
+ * translation. Returns `null` for non-finite input.
+ */
+export function canonicalFrameMatrix(facts: NestedObjectFrameFacts): Affine2D | null {
+  return frameToParentMatrix({
+    x: facts.x,
+    y: facts.y,
+    width: facts.width,
+    height: facts.height,
+    rotationDegrees: facts.rotationDegrees,
+    flipX: facts.flipX,
+    flipY: facts.flipY,
+  });
+}
+
+/** The permanent semantic witness-local quad: `(0,0) → (w,0) → (w,h) → (0,h)`. */
+export function canonicalWitnessLocalQuad(frame: { width: number; height: number }): Quad {
+  return [
+    { x: 0, y: 0 },
+    { x: frame.width, y: 0 },
+    { x: frame.width, y: frame.height },
+    { x: 0, y: frame.height },
+  ];
+}
+
+/** The persisted semantic frame projection of one chain segment. */
+export function segmentPersistedFrame(facts: NestedObjectFrameFacts): NestedObjectPersistedFrame {
+  return {
+    x: facts.x,
+    y: facts.y,
+    width: facts.width,
+    height: facts.height,
+    rotationDegrees: facts.rotationDegrees,
+    flipX: facts.flipX,
+    flipY: facts.flipY,
+  };
+}
+
+/**
+ * The exact render frame of one chain segment (ADR 0015 B7/B8). Object segments
+ * share the persisted frame and record the wrapper realization; the plain Text
+ * witness records the exact product `8` CSS/artwork-unit padding expansion.
+ */
+export function segmentRenderFrame(facts: NestedObjectFrameFacts): NestedObjectRenderFrame {
+  if (facts.kind === 'text') {
+    const padding = NESTED_TEXT_FRAME_PADDING;
+    return {
+      x: facts.x - padding,
+      y: facts.y - padding,
+      width: facts.width + 2 * padding,
+      height: facts.height + 2 * padding,
+      rotationDegrees: facts.rotationDegrees,
+      derivation: 'plain-text-frame-padding-v1',
+      padding: { left: padding, right: padding, top: padding, bottom: padding },
+      frameShift: { x: 0, y: 0 },
+    };
+  }
+  return {
+    x: facts.x,
+    y: facts.y,
+    width: facts.width,
+    height: facts.height,
+    rotationDegrees: facts.rotationDegrees,
+    derivation: 'object-wrapper-plus-center-rotation-v1',
+    padding: null,
+    frameShift: { x: 0, y: 0 },
+  };
+}
+
+/** The parent-local render matrix of one render frame (flip-aware, R5). */
+export function renderFrameMatrix(
+  frame: NestedObjectRenderFrame,
+  flipX: boolean,
+  flipY: boolean,
+): Affine2D | null {
+  return canonicalFrameMatrix({
+    id: '',
+    kind: 'object',
+    parentId: '',
+    x: frame.x,
+    y: frame.y,
+    width: frame.width,
+    height: frame.height,
+    rotationDegrees: frame.rotationDegrees,
+    flipX,
+    flipY,
+  });
+}
+
+export interface CanonicalChainResult {
+  segments: CanonicalChainSegmentV2[];
+  witnessToLayout: Affine2D;
+}
+
+/**
+ * Composes a closed witness→…→target frame chain (ordered witness first) into
+ * one renderer-local-to-Layout matrix. Each segment's `parentId` must equal the
+ * next segment's id, and the last segment's `parentId` must be the Layout id.
+ * The composition uses each segment's render matrix (ADR 0015 B8).
+ */
+export function composeCanonicalChain(
+  chain: readonly NestedObjectFrameFacts[],
+  layoutId: string,
+): CanonicalChainResult | { failure: NestedObjectGeometryFailure } {
+  if (chain.length < 2) {
+    return {
+      failure: {
+        code: 'GEOMETRY_CHAIN_INVALID',
+        reason: 'CHAIN_TOO_SHORT',
+        detail: `A nested canonical chain requires at least two frames; received ${chain.length}.`,
+      },
+    };
+  }
+  const segments: CanonicalChainSegmentV2[] = [];
+  for (let index = 0; index < chain.length; index += 1) {
+    const facts = chain[index];
+    if (
+      typeof facts.id !== 'string' ||
+      facts.id.length === 0 ||
+      typeof facts.parentId !== 'string' ||
+      facts.parentId.length === 0 ||
+      (facts.kind !== 'object' && facts.kind !== 'text') ||
+      typeof facts.flipX !== 'boolean' ||
+      typeof facts.flipY !== 'boolean'
+    ) {
+      return {
+        failure: {
+          code: 'GEOMETRY_CHAIN_INVALID',
+          reason: 'CHAIN_FRAME_MALFORMED',
+          detail: `Chain frame at index ${index} is malformed.`,
+        },
+      };
+    }
+    const renderFrame = segmentRenderFrame(facts);
+    const matrix = renderFrameMatrix(renderFrame, facts.flipX, facts.flipY);
+    if (matrix === null || !isFiniteAffine(matrix)) {
+      return {
+        failure: {
+          code: 'GEOMETRY_CHAIN_INVALID',
+          reason: 'CHAIN_FRAME_NON_FINITE',
+          detail: `Chain frame "${facts.id}" carries non-finite frame facts.`,
+        },
+      };
+    }
+    const expectedParent = index + 1 < chain.length ? chain[index + 1].id : layoutId;
+    if (facts.parentId !== expectedParent) {
+      return {
+        failure: {
+          code: 'GEOMETRY_PARENT_MISMATCH',
+          reason: 'CHAIN_PARENT_MISMATCH',
+          detail: `Chain frame "${facts.id}" declares parent "${facts.parentId}" but ${expectedParent} is required.`,
+        },
+      };
+    }
+    segments.push({
+      id: facts.id,
+      kind: facts.kind,
+      parentId: facts.parentId,
+      persistedFrame: segmentPersistedFrame(facts),
+      renderFrame,
+      canonicalRenderMatrix: matrix,
+    });
+  }
+  const ids = new Set(segments.map((segment) => segment.id));
+  if (ids.size !== segments.length) {
+    return {
+      failure: {
+        code: 'GEOMETRY_CHAIN_INVALID',
+        reason: 'CHAIN_ID_REPEATED',
+        detail: 'The canonical chain repeats a frame id.',
+      },
+    };
+  }
+  const witnessToLayout = composeChain(segments.map((segment) => segment.canonicalRenderMatrix));
+  if (!isFiniteAffine(witnessToLayout)) {
+    return {
+      failure: {
+        code: 'GEOMETRY_CHAIN_INVALID',
+        reason: 'CHAIN_COMPOSITION_NON_FINITE',
+        detail: 'The canonical chain composed into a non-finite matrix.',
+      },
+    };
+  }
+  return { segments, witnessToLayout };
+}
+
+// ── Camera agreement (R7) ───────────────────────────────────────────────────
+
+export interface CameraAgreement {
+  panX: boolean;
+  panY: boolean;
+  scaleX: boolean;
+  scaleY: boolean;
+  rotation: boolean;
+  skewX: boolean;
+  skewY: boolean;
+  agrees: boolean;
+  nonIdentityZoom: boolean;
+}
+
+/**
+ * Compares canonical camera intent with the complete live Stage matrix. A
+ * non-identity zoom is a readiness precondition, never manufactured by the
+ * constructor.
+ */
+export function evaluateCameraAgreement(
+  camera: { x: number; y: number; zoom: number },
+  stageMatrix: Affine2D,
+  tolerance: number = NESTED_OBJECT_CAMERA_TOLERANCE,
+): CameraAgreement {
+  const close = (left: number, right: number) =>
+    Number.isFinite(left) && Number.isFinite(right) && Math.abs(left - right) <= tolerance;
+  const panX = close(stageMatrix.e, camera.x);
+  const panY = close(stageMatrix.f, camera.y);
+  const scaleX = close(stageMatrix.a, camera.zoom);
+  const scaleY = close(stageMatrix.d, camera.zoom);
+  const rotation = Math.abs(stageMatrix.b) <= tolerance && Math.abs(stageMatrix.c) <= tolerance;
+  const skewX = Math.abs(stageMatrix.c) <= tolerance;
+  const skewY = Math.abs(stageMatrix.b) <= tolerance;
+  return {
+    panX,
+    panY,
+    scaleX,
+    scaleY,
+    rotation,
+    skewX,
+    skewY,
+    agrees: panX && panY && scaleX && scaleY && rotation && skewX && skewY,
+    nonIdentityZoom:
+      Number.isFinite(camera.zoom) && Math.abs(camera.zoom - 1) > NESTED_OBJECT_CAMERA_TOLERANCE,
+  };
+}
+
+// ── Fingerprints (R6) ───────────────────────────────────────────────────────
+
+function segmentFingerprintPreimageV2(segment: CanonicalChainSegmentV2): unknown[] {
+  const padding = segment.renderFrame.padding;
+  return [
+    segment.id,
+    segment.kind,
+    segment.parentId,
+    [
+      segment.persistedFrame.x,
+      segment.persistedFrame.y,
+      segment.persistedFrame.width,
+      segment.persistedFrame.height,
+      segment.persistedFrame.rotationDegrees,
+      segment.persistedFrame.flipX,
+      segment.persistedFrame.flipY,
+    ],
+    [
+      segment.renderFrame.x,
+      segment.renderFrame.y,
+      segment.renderFrame.width,
+      segment.renderFrame.height,
+      segment.renderFrame.rotationDegrees,
+      segment.renderFrame.derivation,
+      padding === null ? null : [padding.left, padding.right, padding.top, padding.bottom],
+      [segment.renderFrame.frameShift.x, segment.renderFrame.frameShift.y],
+    ],
+    affinePreimage(segment.canonicalRenderMatrix),
+  ];
+}
+
+export function buildChainFingerprintPreimage(
+  chain: readonly CanonicalChainSegmentV2[],
+  targetId: string,
+  witnessId: string,
+  layoutId: string,
+): string {
+  return canonicalScalar({
+    version: NESTED_OBJECT_CHAIN_FINGERPRINT_PREIMAGE_VERSION,
+    targetId,
+    witnessId,
+    layoutId,
+    segments: chain.map((segment) => segmentFingerprintPreimageV2(segment)),
+  });
+}
+
+export function computeChainFingerprint(
+  chain: readonly CanonicalChainSegmentV2[],
+  targetId: string,
+  witnessId: string,
+  layoutId: string,
+): string {
+  return fnv1a64Hex(buildChainFingerprintPreimage(chain, targetId, witnessId, layoutId));
+}
+
+export interface RepresentationFingerprintInputV3 {
+  representation: Omit<NestedObjectGeometryV3['representation'], 'representationFingerprint'>;
+  camera: NestedObjectGeometryV3['camera'];
+  bridgeGeneration: number;
+  chainFingerprint: string;
+}
+
+function quadPreimageV3(quad: Quad): number[] {
+  return [quad[0].x, quad[0].y, quad[1].x, quad[1].y, quad[2].x, quad[2].y, quad[3].x, quad[3].y];
+}
+
+export function buildRepresentationFingerprintPreimageV3(
+  input: RepresentationFingerprintInputV3,
+): string {
+  const { representation, camera } = input;
+  return canonicalScalar({
+    version: NESTED_OBJECT_REPRESENTATION_FINGERPRINT_PREIMAGE_VERSION,
+    kind: representation.kind,
+    representationVersion: representation.representationVersion,
+    pointOrder: [...representation.pointOrder],
+    units: representation.units,
+    targetId: representation.targetId,
+    witnessId: representation.witnessId,
+    layoutId: representation.layoutId,
+    canonicalChain: representation.canonicalChain.map((segment) =>
+      segmentFingerprintPreimageV2(segment),
+    ),
+    targetWrappers: [
+      affinePreimage(representation.targetWrappers.translationWrapperToLayout),
+      affinePreimage(representation.targetWrappers.centerRotationSubtreeToTranslationWrapper),
+      affinePreimage(representation.targetWrappers.completeObjectToLayout),
+      representation.targetWrappers.flipShellIdentity,
+    ],
+    quads: {
+      canonicalWitnessLocal: quadPreimageV3(representation.canonicalWitnessLocalQuad),
+      persistedWitnessContent: quadPreimageV3(representation.persistedWitnessContentQuad),
+      canonicalLayout: quadPreimageV3(representation.canonicalLayoutQuad),
+      renderedLayout: quadPreimageV3(representation.renderedLayoutQuad),
+      renderedWorldScene: quadPreimageV3(representation.renderedWorldSceneQuad),
+      renderedStageViewportCss: quadPreimageV3(representation.renderedStageViewportCssQuad),
+      renderedBrowserClientCss: quadPreimageV3(representation.renderedBrowserClientCssQuad),
+    },
+    matrices: [
+      [
+        'canonicalWitnessToLayout',
+        affinePreimage(representation.matrices.canonicalWitnessToLayout),
+      ],
+      ['renderedWitnessToLayout', affinePreimage(representation.matrices.renderedWitnessToLayout)],
+      ['layoutToWorldScene', affinePreimage(representation.matrices.layoutToWorldScene)],
+      [
+        'worldSceneToStageViewportCss',
+        affinePreimage(representation.matrices.worldSceneToStageViewportCss),
+      ],
+      [
+        'stageViewportToBrowserClientCss',
+        affinePreimage(representation.matrices.stageViewportToBrowserClientCss),
+      ],
+    ],
+    camera: {
+      canonical: [camera.canonical.x, camera.canonical.y, camera.canonical.zoom],
+      stageMatrix: affinePreimage(camera.stageMatrix),
+      cssRatios: [camera.cssRatios.x, camera.cssRatios.y],
+    },
+    bridgeGeneration: input.bridgeGeneration,
+    chainFingerprint: input.chainFingerprint,
+  });
+}
+
+export function computeRepresentationFingerprintV3(
+  input: RepresentationFingerprintInputV3,
+): string {
+  return fnv1a64Hex(buildRepresentationFingerprintPreimageV3(input));
+}
+
+// ── Interaction and record fingerprints (ADR 0014 R6) ───────────────────────
+
+/**
+ * Canonical preimage for one complete interaction member, excluding only its
+ * own `interactionFingerprint`. Post-action `point` is included: it is internal
+ * authority, even though the public projection omits it.
+ */
+export function buildInteractionFingerprintPreimage(
+  interaction: NestedObjectGeometryInteraction,
+): string {
+  const shared = {
+    version: NESTED_OBJECT_INTERACTION_FINGERPRINT_PREIMAGE_VERSION,
+    phase: interaction.phase,
+    purpose: interaction.purpose,
+    authority: interaction.authority,
+    status: interaction.status,
+    targetId: interaction.targetId,
+    space: interaction.space,
+    candidate: interaction.candidate,
+    point: [interaction.point.x, interaction.point.y],
+    safetyInsetCssPx: interaction.safetyInsetCssPx,
+    source: interaction.source,
+    hitClassification: interaction.hitClassification,
+  };
+  if (interaction.phase === 'pre-action') {
+    return canonicalScalar(shared);
+  }
+  return canonicalScalar({
+    ...shared,
+    obstructionCode: interaction.obstructionCode,
+    safeHitDescriptor: {
+      nodeClass: interaction.safeHitDescriptor.nodeClass,
+      chromeName: interaction.safeHitDescriptor.chromeName,
+      ownedByTarget: interaction.safeHitDescriptor.ownedByTarget,
+    },
+  });
+}
+
+export function computeInteractionFingerprint(
+  interaction: NestedObjectGeometryInteraction,
+): string {
+  return fnv1a64Hex(buildInteractionFingerprintPreimage(interaction));
+}
+
+export interface RecordFingerprintInputV3 {
+  representationFingerprint: string;
+  interactionFingerprint: string;
+  phase: NestedObjectGeometryInteraction['phase'];
+  purpose: NestedObjectGeometryInteraction['purpose'];
+  chainFingerprint: string;
+  bridgeGeneration: number;
+}
+
+/**
+ * Record fingerprint: representation + interaction fingerprints, phase/purpose,
+ * chain fingerprint, and bridge generation. Correlation/evidence only.
+ */
+export function buildRecordFingerprintPreimage(input: RecordFingerprintInputV3): string {
+  return canonicalScalar({
+    version: NESTED_OBJECT_RECORD_FINGERPRINT_PREIMAGE_VERSION,
+    representationFingerprint: input.representationFingerprint,
+    interactionFingerprint: input.interactionFingerprint,
+    phase: input.phase,
+    purpose: input.purpose,
+    chainFingerprint: input.chainFingerprint,
+    bridgeGeneration: input.bridgeGeneration,
+  });
+}
+
+export function computeRecordFingerprint(input: RecordFingerprintInputV3): string {
+  return fnv1a64Hex(buildRecordFingerprintPreimage(input));
+}
+
+// ── Live projection (R4–R7) ─────────────────────────────────────────────────
+
+export interface NestedObjectProjectionInput {
+  bridgeGeneration: number;
+  targetId: string;
+  witnessId: string;
+  layoutId: string;
+  /** Ordered witness-first canonical frame chain. */
+  chain: readonly NestedObjectFrameFacts[];
+  stage: Konva.Stage;
+  targetNode: Konva.Node;
+  witnessNode: Konva.Node;
+  layoutNode: Konva.Node;
+  camera: { x: number; y: number; zoom: number };
+  /** Product-function normalization facts for the accepted active subtree. */
+  normalization: NestedObjectNormalizationFacts;
+  /** Purpose-scoped interaction member, without its own fingerprint. */
+  interaction: NestedObjectInteractionInput;
+}
+
+function nodeFingerprint(node: Konva.Node, relative: Affine2D | null): string {
+  const read = (value: () => number): number | null => {
+    try {
+      const result = value();
+      return typeof result === 'number' && Number.isFinite(result) ? result : null;
+    } catch {
+      return null;
+    }
+  };
+  const idOf = (value: () => string): string => {
+    try {
+      return value();
+    } catch {
+      return '';
+    }
+  };
+  return canonicalScalar({
+    konvaId: idOf(() => node.id()),
+    parentKonvaId: idOf(() => node.getParent()?.id() ?? ''),
+    className: idOf(() => node.getClassName()),
+    x: read(() => node.x()),
+    y: read(() => node.y()),
+    offsetX: read(() => node.offsetX()),
+    offsetY: read(() => node.offsetY()),
+    scaleX: read(() => node.scaleX()),
+    scaleY: read(() => node.scaleY()),
+    rotation: read(() => node.rotation()),
+    skewX: read(() => node.skewX()),
+    skewY: read(() => node.skewY()),
+    relative: relative === null ? null : affinePreimage(relative),
+  });
+}
+
+function isIdentityAffine(matrix: Affine2D): boolean {
+  const epsilon = NESTED_OBJECT_CANONICAL_EPSILON;
+  return (
+    Math.abs(matrix.a - 1) <= epsilon &&
+    Math.abs(matrix.b) <= epsilon &&
+    Math.abs(matrix.c) <= epsilon &&
+    Math.abs(matrix.d - 1) <= epsilon &&
+    Math.abs(matrix.e) <= epsilon &&
+    Math.abs(matrix.f) <= epsilon
+  );
+}
+
+/**
+ * The expected pure center-rotation wrapper matrix of a false-flip Object,
+ * expressed in the Object translation-wrapper's local space (ADR 0015 B8).
+ */
+function expectedCenterRotationMatrix(frame: NestedObjectPersistedFrame): Affine2D | null {
+  return canonicalFrameMatrix({
+    id: '',
+    kind: 'object',
+    parentId: '',
+    x: 0,
+    y: 0,
+    width: frame.width,
+    height: frame.height,
+    rotationDegrees: frame.rotationDegrees,
+    flipX: false,
+    flipY: false,
+  });
+}
+
+/** The resolved live target-Object wrapper chain (ADR 0015 B9). */
+export interface ResolvedObjectWrappers {
+  translationWrapperToLayout: Affine2D;
+  centerRotationSubtreeToTranslationWrapper: Affine2D;
+  completeObjectToLayout: Affine2D;
+  flipShellIdentity: boolean;
+}
+
+/**
+ * Resolves and validates the exact live Object wrapper structure read-only.
+ *
+ * The id-bearing node is the translation wrapper; its single content/flip shell
+ * wraps the single center-rotation subtree. Any missing, duplicate, ambiguous,
+ * reordered, or nonconforming wrapper fails closed; the id-bearing node alone is
+ * never substituted for the complete Object transform.
+ */
+export function resolveObjectWrapperChain(input: {
+  targetNode: Konva.Node;
+  layoutNode: Konva.Node;
+  targetPersistedFrame: NestedObjectPersistedFrame;
+}):
+  | { ok: true; wrappers: ResolvedObjectWrappers }
+  | { ok: false; failure: NestedObjectGeometryFailure } {
+  const wrapperFailure = (
+    reason: string,
+    detail: string,
+  ): { ok: false; failure: NestedObjectGeometryFailure } => ({
+    ok: false,
+    failure: { code: 'GEOMETRY_TRANSFORM_INVALID', reason, detail },
+  });
+  const translationWrapperToLayout = readRelativeAffine(input.targetNode, input.layoutNode);
+  if (translationWrapperToLayout === null || !isFiniteAffine(translationWrapperToLayout)) {
+    return wrapperFailure(
+      'TARGET_TRANSLATION_WRAPPER_INVALID',
+      'The live target translation wrapper to Layout was not a finite affine map.',
+    );
+  }
+  const expectedCenter = expectedCenterRotationMatrix(input.targetPersistedFrame);
+  if (expectedCenter === null || !isFiniteAffine(expectedCenter)) {
+    return wrapperFailure(
+      'TARGET_CENTER_WRAPPER_INVALID',
+      'The expected target center-rotation wrapper is not finite.',
+    );
+  }
+  let children: Konva.Node[];
+  try {
+    children = (input.targetNode as Konva.Container).getChildren();
+  } catch {
+    return wrapperFailure('WRAPPER_STRUCTURE_UNRESOLVED', 'The live target exposes no children.');
+  }
+  const shells = children.filter((child) => {
+    try {
+      return child.getClassName() === 'Group';
+    } catch {
+      return false;
+    }
+  });
+  if (shells.length === 0) {
+    return wrapperFailure(
+      'WRAPPER_STRUCTURE_MISSING',
+      'The live target exposes no content/flip shell wrapper.',
+    );
+  }
+  const shell = shells[0] as Konva.Node;
+  const shellToTarget = readRelativeAffine(shell, input.targetNode);
+  if (shellToTarget === null || !isFiniteAffine(shellToTarget)) {
+    return wrapperFailure(
+      'WRAPPER_SHELL_INVALID',
+      'The live target content/flip shell to translation wrapper is not finite.',
+    );
+  }
+  let shellChildren: Konva.Node[];
+  try {
+    shellChildren = (shell as Konva.Container).getChildren();
+  } catch {
+    return wrapperFailure(
+      'WRAPPER_STRUCTURE_UNRESOLVED',
+      'The live content shell exposes no children.',
+    );
+  }
+  const rotationCandidates: Affine2D[] = [];
+  const pending: Array<{ node: Konva.Node; depth: number }> = shellChildren.map((node) => ({
+    node,
+    depth: 0,
+  }));
+  const visited = new Set<Konva.Node>();
+  while (pending.length > 0) {
+    const candidate = pending.shift();
+    if (!candidate || visited.has(candidate.node)) continue;
+    visited.add(candidate.node);
+    try {
+      if (candidate.node.getClassName() !== 'Group') continue;
+    } catch {
+      continue;
+    }
+    const relative = readRelativeAffine(candidate.node, input.targetNode);
+    if (relative === null || !isFiniteAffine(relative)) continue;
+    if (affineAgreesWithin(relative, expectedCenter, NESTED_OBJECT_CANONICAL_EPSILON)) {
+      rotationCandidates.push(relative);
+      continue;
+    }
+    // React/Konva may materialize a Fragment as one or more identity Groups.
+    // Descend only through a short, transform-free chain; any transformed or
+    // ambiguous structure still fails closed below.
+    if (candidate.depth >= 3 || !isIdentityAffine(relative)) continue;
+    try {
+      for (const child of (candidate.node as Konva.Container).getChildren()) {
+        pending.push({ node: child, depth: candidate.depth + 1 });
+      }
+    } catch {}
+  }
+  if (rotationCandidates.length !== 1) {
+    const observed = shellChildren.slice(0, 6).map((child) => {
+      let className = 'unknown';
+      try {
+        className = child.getClassName();
+      } catch {
+        className = 'error';
+      }
+      const relative = readRelativeAffine(child, input.targetNode);
+      return `${className}:[${
+        relative === null
+          ? 'null'
+          : [relative.a, relative.b, relative.c, relative.d, relative.e, relative.f]
+              .map((value) => value.toFixed(3))
+              .join(',')
+      }]`;
+    });
+    return wrapperFailure(
+      rotationCandidates.length === 0
+        ? 'TARGET_CENTER_WRAPPER_MISSING'
+        : 'TARGET_CENTER_WRAPPER_AMBIGUOUS',
+      `The live target content shell exposes ${rotationCandidates.length} conforming center-rotation wrappers; exactly one is required. shells=${shells.length} shellChildren=${observed.join('|')} shellToTarget=[${[
+        shellToTarget.a,
+        shellToTarget.b,
+        shellToTarget.c,
+        shellToTarget.d,
+        shellToTarget.e,
+        shellToTarget.f,
+      ]
+        .map((value) => value.toFixed(3))
+        .join(',')}] expectedCenter=[${[
+        expectedCenter.a,
+        expectedCenter.b,
+        expectedCenter.c,
+        expectedCenter.d,
+        expectedCenter.e,
+        expectedCenter.f,
+      ]
+        .map((value) => value.toFixed(3))
+        .join(',')}]`,
+    );
+  }
+  const centerRotationSubtreeToTranslationWrapper = rotationCandidates[0] as Affine2D;
+  const flipShellIdentity = isIdentityAffine(shellToTarget);
+  const completeObjectToLayout = multiplyAffine(
+    translationWrapperToLayout,
+    centerRotationSubtreeToTranslationWrapper,
+  );
+  if (!isFiniteAffine(completeObjectToLayout)) {
+    return wrapperFailure(
+      'TARGET_COMPLETE_WRAPPER_INVALID',
+      'The complete target Object to Layout composition is not finite.',
+    );
+  }
+  return {
+    ok: true,
+    wrappers: {
+      translationWrapperToLayout,
+      centerRotationSubtreeToTranslationWrapper,
+      completeObjectToLayout,
+      flipShellIdentity,
+    },
+  };
+}
+
+/**
+ * Projects the live nested target/witness/Layout chain into the geometry schema
+ * v3 record. Fails closed with a precise coded reason rather than guessing when
+ * any required intent, node, matrix, or camera fact is missing or invalid.
+ */
+export function projectNestedObjectGeometryV3(
+  input: NestedObjectProjectionInput,
+): NestedObjectGeometryResult {
+  if (
+    input.targetId === input.witnessId ||
+    input.witnessId === input.layoutId ||
+    input.targetId === input.layoutId
+  ) {
+    return fail(
+      'GEOMETRY_CHAIN_ID_MISMATCH',
+      'CHAIN_ID_MISMATCH',
+      'Target, witness, and Layout ids must be distinct.',
+    );
+  }
+  const canonical = composeCanonicalChain(input.chain, input.layoutId);
+  if ('failure' in canonical) return { ok: false, failure: canonical.failure };
+  const { segments, witnessToLayout: canonicalWitnessToLayout } = canonical;
+
+  const witnessSegment = segments[0];
+  const targetSegment = segments[segments.length - 1];
+  if (witnessSegment.id !== input.witnessId) {
+    return fail(
+      'GEOMETRY_CHAIN_ID_MISMATCH',
+      'CHAIN_ID_MISMATCH',
+      `Chain witness "${witnessSegment.id}" is not the requested witness "${input.witnessId}".`,
+    );
+  }
+  if (targetSegment.id !== input.targetId || targetSegment.kind !== 'object') {
+    return fail(
+      'GEOMETRY_CHAIN_ID_MISMATCH',
+      'CHAIN_ID_MISMATCH',
+      `Chain target "${targetSegment.id}" is not the requested Object target "${input.targetId}".`,
+    );
+  }
+  if (witnessSegment.kind !== 'text') {
+    return fail(
+      'GEOMETRY_CHAIN_INVALID',
+      'CHAIN_WITNESS_KIND',
+      'The canonical witness frame must be a Text frame.',
+    );
+  }
+  if (segments.length < 3 || segments[1].kind !== 'object') {
+    return fail(
+      'GEOMETRY_CHAIN_INVALID',
+      'CHAIN_SHAPE',
+      'The nested chain must be Text → inner Object → outer Object → Layout.',
+    );
+  }
+
+  const witnessLocalQuad = canonicalWitnessLocalQuad(witnessSegment.renderFrame);
+  const canonicalLayoutQuad = transformQuad(canonicalWitnessToLayout, witnessLocalQuad);
+  const persistedWitnessContentQuad: Quad = [
+    { x: NESTED_TEXT_FRAME_PADDING, y: NESTED_TEXT_FRAME_PADDING },
+    {
+      x: NESTED_TEXT_FRAME_PADDING + witnessSegment.persistedFrame.width,
+      y: NESTED_TEXT_FRAME_PADDING,
+    },
+    {
+      x: NESTED_TEXT_FRAME_PADDING + witnessSegment.persistedFrame.width,
+      y: NESTED_TEXT_FRAME_PADDING + witnessSegment.persistedFrame.height,
+    },
+    {
+      x: NESTED_TEXT_FRAME_PADDING,
+      y: NESTED_TEXT_FRAME_PADDING + witnessSegment.persistedFrame.height,
+    },
+  ];
+
+  const renderedWitnessToLayout = readRelativeAffine(input.witnessNode, input.layoutNode);
+  if (renderedWitnessToLayout === null) {
+    return fail(
+      'GEOMETRY_TRANSFORM_INVALID',
+      'RENDERED_WITNESS_TO_LAYOUT_INVALID',
+      'The live witness-to-Layout Konva transform could not be read as a finite affine map.',
+    );
+  }
+  const layerNode = (() => {
+    try {
+      return input.layoutNode.getLayer();
+    } catch {
+      return null;
+    }
+  })();
+  const layoutToWorldScene =
+    layerNode === null ? null : readRelativeAffine(input.layoutNode, layerNode);
+  if (layoutToWorldScene === null) {
+    return fail(
+      'GEOMETRY_TRANSFORM_INVALID',
+      'LAYOUT_TO_WORLD_INVALID',
+      'The live Layout-to-scene Konva transform could not be read as a finite affine map.',
+    );
+  }
+  const stageMatrix = readStageViewMatrix(input.stage);
+  if (stageMatrix === null) {
+    return fail(
+      'GEOMETRY_TRANSFORM_INVALID',
+      'STAGE_TRANSFORM_INVALID',
+      'The live Stage affine transform could not be read as a finite affine map.',
+    );
+  }
+  const measured = measureStageCssFacts(input.stage);
+  if (!measured.ok) {
+    return {
+      ok: false,
+      failure: {
+        code: 'GEOMETRY_TRANSFORM_INVALID',
+        reason: measured.failure.reason,
+        detail: measured.failure.detail,
+      },
+    };
+  }
+  const { cssRatios, containerRect } = measured.facts;
+
+  const worldSceneToStageViewportCss = multiplyAffine(
+    scaleAffine(1 / cssRatios.x, 1 / cssRatios.y),
+    stageMatrix,
+  );
+  const stageViewportToBrowserClientCss = translationAffine(containerRect.left, containerRect.top);
+
+  const matrices = {
+    canonicalWitnessToLayout,
+    renderedWitnessToLayout,
+    layoutToWorldScene,
+    worldSceneToStageViewportCss,
+    stageViewportToBrowserClientCss,
+  };
+  if (Object.values(matrices).some((matrix) => !isFiniteAffine(matrix))) {
+    return fail(
+      'GEOMETRY_TRANSFORM_INVALID',
+      'MATRIX_INVALID',
+      'At least one composed nested geometry matrix is not a finite affine map.',
+    );
+  }
+
+  const renderedLayoutQuad = transformQuad(renderedWitnessToLayout, witnessLocalQuad);
+  const renderedWorldSceneQuad = transformQuad(layoutToWorldScene, renderedLayoutQuad);
+  const renderedStageViewportCssQuad = transformQuad(
+    worldSceneToStageViewportCss,
+    renderedWorldSceneQuad,
+  );
+  const renderedBrowserClientCssQuad = transformQuad(
+    stageViewportToBrowserClientCss,
+    renderedStageViewportCssQuad,
+  );
+  for (const quad of [
+    canonicalLayoutQuad,
+    renderedLayoutQuad,
+    renderedWorldSceneQuad,
+    renderedStageViewportCssQuad,
+    renderedBrowserClientCssQuad,
+  ]) {
+    if (!quad.every(isFinitePoint)) {
+      return fail(
+        'GEOMETRY_TRANSFORM_INVALID',
+        'QUAD_NON_FINITE',
+        'A nested geometry quad contains a non-finite point.',
+      );
+    }
+  }
+
+  if (input.interaction.phase !== 'pre-action' && input.interaction.phase !== 'post-action') {
+    return fail(
+      'GEOMETRY_REPRESENTATION_UNSUPPORTED',
+      'INTERACTION_PHASE_UNSUPPORTED',
+      'The projection interaction member declares an unsupported phase.',
+    );
+  }
+  if (input.interaction.targetId !== input.targetId) {
+    return fail(
+      'GEOMETRY_TARGET_ID_MISMATCH',
+      'INTERACTION_TARGET',
+      'The projection interaction member does not name the requested target.',
+    );
+  }
+  if (!isFinitePoint(input.interaction.point)) {
+    return fail(
+      'TARGET_QUAD_INTERACTION_POINT_INVALID',
+      'INTERACTION_POINT_NON_FINITE',
+      'The deterministic interaction point is not finite.',
+    );
+  }
+
+  const chainFingerprint = computeChainFingerprint(
+    segments,
+    input.targetId,
+    input.witnessId,
+    input.layoutId,
+  );
+
+  const resolvedWrappers = resolveObjectWrapperChain({
+    targetNode: input.targetNode,
+    layoutNode: input.layoutNode,
+    targetPersistedFrame: targetSegment.persistedFrame,
+  });
+  if (!resolvedWrappers.ok) return { ok: false, failure: resolvedWrappers.failure };
+  const targetWrappers: NestedObjectTargetWrappers = {
+    ...resolvedWrappers.wrappers,
+    wrapperStructureValidated: true,
+  };
+  const representationWithoutFingerprint: Omit<
+    NestedObjectGeometryV3['representation'],
+    'representationFingerprint'
+  > = {
+    kind: NESTED_OBJECT_AFFINE_CHAIN_KIND,
+    representationVersion: NESTED_OBJECT_REPRESENTATION_VERSION,
+    pointOrder: NESTED_OBJECT_POINT_ORDER,
+    units: NESTED_OBJECT_SPACE_UNITS,
+    targetId: input.targetId,
+    witnessId: input.witnessId,
+    layoutId: input.layoutId,
+    canonicalChain: segments,
+    targetCanonicalFrame: targetSegment,
+    witnessCanonicalFrame: witnessSegment,
+    canonicalWitnessLocalQuad: witnessLocalQuad,
+    persistedWitnessContentQuad,
+    targetWrappers,
+    canonicalLayoutQuad,
+    renderedLayoutQuad,
+    renderedWorldSceneQuad,
+    renderedStageViewportCssQuad,
+    renderedBrowserClientCssQuad,
+    matrices,
+  };
+  const camera = {
+    canonical: { x: input.camera.x, y: input.camera.y, zoom: input.camera.zoom },
+    stageMatrix,
+    cssRatios,
+  };
+  const representationFingerprint = computeRepresentationFingerprintV3({
+    representation: representationWithoutFingerprint,
+    camera,
+    bridgeGeneration: input.bridgeGeneration,
+    chainFingerprint,
+  });
+  const interaction = {
+    ...input.interaction,
+    interactionFingerprint: computeInteractionFingerprint({
+      ...input.interaction,
+      interactionFingerprint: '',
+    }),
+  } as NestedObjectGeometryInteraction;
+  const recordFingerprint = computeRecordFingerprint({
+    representationFingerprint,
+    interactionFingerprint: interaction.interactionFingerprint,
+    phase: interaction.phase,
+    purpose: interaction.purpose,
+    chainFingerprint,
+    bridgeGeneration: input.bridgeGeneration,
+  });
+
+  const record: NestedObjectGeometryV3 = {
+    schemaVersion: NESTED_OBJECT_GEOMETRY_SCHEMA_VERSION,
+    discriminant: NESTED_OBJECT_GEOMETRY_DISCRIMINANT,
+    representation: { ...representationWithoutFingerprint, representationFingerprint },
+    camera,
+    typedProvenance: {
+      bridgeGeneration: input.bridgeGeneration,
+      target: {
+        id: input.targetId,
+        konvaId: (() => {
+          try {
+            return input.targetNode.id();
+          } catch {
+            return '';
+          }
+        })(),
+        fingerprint: nodeFingerprint(input.targetNode, null),
+      },
+      witness: {
+        id: input.witnessId,
+        konvaId: (() => {
+          try {
+            return input.witnessNode.id();
+          } catch {
+            return '';
+          }
+        })(),
+        fingerprint: nodeFingerprint(input.witnessNode, renderedWitnessToLayout),
+      },
+      layout: {
+        id: input.layoutId,
+        konvaId: (() => {
+          try {
+            return input.layoutNode.id();
+          } catch {
+            return '';
+          }
+        })(),
+        fingerprint: nodeFingerprint(input.layoutNode, layoutToWorldScene),
+      },
+      chainFingerprint,
+      representationFingerprint,
+      stageFingerprint: canonicalScalar({
+        stage: affinePreimage(stageMatrix),
+        cssRatios: [cssRatios.x, cssRatios.y],
+      }),
+    },
+    interaction,
+    normalization: input.normalization,
+    chainFingerprint,
+    recordFingerprint,
+  };
+  // The representation carries the fingerprint; the top-level field mirrors it
+  // for pair-explicit capture/coherence checks.
+  return { ok: true, record };
+}
+
+/**
+ * Geometry-only representation fingerprint for one explicit nested pair.
+ *
+ * This is the ADR 0014 R4 rule-7 idle correlation path: it projects the
+ * authoritative geometry facts and computes the interaction-independent
+ * `representationFingerprint`. It performs no hit-graph probe, makes no phase
+ * decision, and requires no caller-supplied interaction record. Returns `null`
+ * when the pair or its geometry cannot be projected read-only.
+ */
+export function computeNestedRepresentationFingerprintGeometryOnly(
+  input: Omit<NestedObjectProjectionInput, 'interaction'>,
+): string | null {
+  const projected = projectNestedObjectGeometryV3({
+    ...input,
+    interaction: {
+      phase: 'post-action',
+      purpose: 'observe-authoritative-geometry',
+      authority: 'none',
+      status: 'clear',
+      targetId: input.targetId,
+      space: 'browser-client-css',
+      candidate: 'center',
+      point: { x: 0, y: 0 },
+      safetyInsetCssPx: 4,
+      source: 'live-konva-hit-v1',
+      hitClassification: 'target',
+      obstructionCode: null,
+      safeHitDescriptor: { nodeClass: null, chromeName: null, ownedByTarget: true },
+    },
+  });
+  return projected.ok ? projected.record.representation.representationFingerprint : null;
+}
+
+// ── Validation ──────────────────────────────────────────────────────────────
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function exactKeys(record: Record<string, unknown>, allowed: readonly string[]): string[] | null {
+  const keys = Object.keys(record);
+  const extra = keys.filter((key) => !allowed.includes(key));
+  const missing = allowed.filter((key) => !(key in record));
+  if (extra.length > 0 || missing.length > 0) return [...extra, ...missing];
+  return null;
+}
+
+const TOP_LEVEL_KEYS = [
+  'schemaVersion',
+  'discriminant',
+  'representation',
+  'camera',
+  'typedProvenance',
+  'interaction',
+  'normalization',
+  'chainFingerprint',
+  'recordFingerprint',
+] as const;
+const NORMALIZATION_KEYS = [
+  'certificateVersion',
+  'fixedPoint',
+  'referentiallyUnchanged',
+  'subtreeFingerprint',
+] as const;
+const REPRESENTATION_KEYS = [
+  'kind',
+  'representationVersion',
+  'pointOrder',
+  'units',
+  'targetId',
+  'witnessId',
+  'layoutId',
+  'canonicalChain',
+  'targetCanonicalFrame',
+  'witnessCanonicalFrame',
+  'canonicalWitnessLocalQuad',
+  'persistedWitnessContentQuad',
+  'targetWrappers',
+  'canonicalLayoutQuad',
+  'renderedLayoutQuad',
+  'renderedWorldSceneQuad',
+  'renderedStageViewportCssQuad',
+  'renderedBrowserClientCssQuad',
+  'matrices',
+  'representationFingerprint',
+] as const;
+const SEGMENT_KEYS = [
+  'id',
+  'kind',
+  'parentId',
+  'persistedFrame',
+  'renderFrame',
+  'canonicalRenderMatrix',
+] as const;
+const WRAPPER_KEYS = [
+  'translationWrapperToLayout',
+  'centerRotationSubtreeToTranslationWrapper',
+  'completeObjectToLayout',
+  'flipShellIdentity',
+  'wrapperStructureValidated',
+] as const;
+const PERSISTED_FRAME_KEYS = [
+  'x',
+  'y',
+  'width',
+  'height',
+  'rotationDegrees',
+  'flipX',
+  'flipY',
+] as const;
+const RENDER_FRAME_KEYS = [
+  'x',
+  'y',
+  'width',
+  'height',
+  'rotationDegrees',
+  'derivation',
+  'padding',
+  'frameShift',
+] as const;
+const RENDER_DERIVATIONS: readonly string[] = [
+  'object-wrapper-plus-center-rotation-v1',
+  'plain-text-frame-padding-v1',
+];
+const PADDING_KEYS = ['left', 'right', 'top', 'bottom'] as const;
+const MATRIX_KEYS = [
+  'canonicalWitnessToLayout',
+  'renderedWitnessToLayout',
+  'layoutToWorldScene',
+  'worldSceneToStageViewportCss',
+  'stageViewportToBrowserClientCss',
+] as const;
+const CAMERA_KEYS = ['canonical', 'stageMatrix', 'cssRatios'] as const;
+const PROVENANCE_KEYS = [
+  'bridgeGeneration',
+  'target',
+  'witness',
+  'layout',
+  'chainFingerprint',
+  'representationFingerprint',
+  'stageFingerprint',
+] as const;
+const PRE_INTERACTION_KEYS = [
+  'phase',
+  'purpose',
+  'authority',
+  'status',
+  'targetId',
+  'space',
+  'candidate',
+  'point',
+  'safetyInsetCssPx',
+  'source',
+  'hitClassification',
+  'interactionFingerprint',
+] as const;
+const POST_INTERACTION_KEYS = [
+  'phase',
+  'purpose',
+  'authority',
+  'status',
+  'targetId',
+  'space',
+  'candidate',
+  'point',
+  'safetyInsetCssPx',
+  'source',
+  'hitClassification',
+  'obstructionCode',
+  'safeHitDescriptor',
+  'interactionFingerprint',
+] as const;
+const SAFE_HIT_DESCRIPTOR_KEYS = ['nodeClass', 'chromeName', 'ownedByTarget'] as const;
+const POINT_KEYS = ['x', 'y'] as const;
+const NODE_KEYS = ['id', 'konvaId', 'fingerprint'] as const;
+const FRAME_KEYS = ['x', 'y', 'width', 'height'] as const;
+const FLIP_KEYS = ['x', 'y'] as const;
+
+function validateSegment(segment: unknown, index: number): NestedObjectGeometryFailure | null {
+  if (!isPlainObject(segment)) {
+    return {
+      code: 'GEOMETRY_CHAIN_INVALID',
+      reason: 'SEGMENT_NOT_OBJECT',
+      detail: `canonicalChain[${index}] is not an object.`,
+    };
+  }
+  if (exactKeys(segment, SEGMENT_KEYS)) {
+    return {
+      code: 'GEOMETRY_CHAIN_INVALID',
+      reason: 'SEGMENT_UNKNOWN_FIELD',
+      detail: `canonicalChain[${index}] has missing or unknown fields.`,
+    };
+  }
+  if (typeof segment.id !== 'string' || segment.id.length === 0) {
+    return {
+      code: 'GEOMETRY_CHAIN_ID_MISMATCH',
+      reason: 'SEGMENT_ID_INVALID',
+      detail: `canonicalChain[${index}].id is not a non-empty string.`,
+    };
+  }
+  if (typeof segment.parentId !== 'string' || segment.parentId.length === 0) {
+    return {
+      code: 'GEOMETRY_PARENT_MISMATCH',
+      reason: 'SEGMENT_PARENT_INVALID',
+      detail: `canonicalChain[${index}].parentId is not a non-empty string.`,
+    };
+  }
+  if (segment.kind !== 'object' && segment.kind !== 'text') {
+    return {
+      code: 'GEOMETRY_CHAIN_INVALID',
+      reason: 'SEGMENT_KIND_INVALID',
+      detail: `canonicalChain[${index}].kind is not object|text.`,
+    };
+  }
+  const persistedFrame = segment.persistedFrame;
+  if (!isPlainObject(persistedFrame) || exactKeys(persistedFrame, PERSISTED_FRAME_KEYS)) {
+    return {
+      code: 'GEOMETRY_CHAIN_INVALID',
+      reason: 'SEGMENT_PERSISTED_FRAME_INVALID',
+      detail: `canonicalChain[${index}].persistedFrame is malformed.`,
+    };
+  }
+  if (
+    !Number.isFinite(persistedFrame.x) ||
+    !Number.isFinite(persistedFrame.y) ||
+    !Number.isFinite(persistedFrame.width) ||
+    !Number.isFinite(persistedFrame.height) ||
+    (persistedFrame.width as number) <= 0 ||
+    (persistedFrame.height as number) <= 0 ||
+    !Number.isFinite(persistedFrame.rotationDegrees) ||
+    typeof persistedFrame.flipX !== 'boolean' ||
+    typeof persistedFrame.flipY !== 'boolean'
+  ) {
+    return {
+      code: 'GEOMETRY_CHAIN_INVALID',
+      reason: 'SEGMENT_PERSISTED_FRAME_INVALID',
+      detail: `canonicalChain[${index}].persistedFrame has non-finite or invalid values.`,
+    };
+  }
+  const renderFrame = segment.renderFrame;
+  if (!isPlainObject(renderFrame) || exactKeys(renderFrame, RENDER_FRAME_KEYS)) {
+    return {
+      code: 'GEOMETRY_CHAIN_INVALID',
+      reason: 'SEGMENT_RENDER_FRAME_INVALID',
+      detail: `canonicalChain[${index}].renderFrame is malformed.`,
+    };
+  }
+  if (
+    !Number.isFinite(renderFrame.x) ||
+    !Number.isFinite(renderFrame.y) ||
+    !Number.isFinite(renderFrame.width) ||
+    !Number.isFinite(renderFrame.height) ||
+    (renderFrame.width as number) <= 0 ||
+    (renderFrame.height as number) <= 0 ||
+    !Number.isFinite(renderFrame.rotationDegrees) ||
+    typeof renderFrame.derivation !== 'string' ||
+    !RENDER_DERIVATIONS.includes(renderFrame.derivation)
+  ) {
+    return {
+      code: 'GEOMETRY_CHAIN_INVALID',
+      reason: 'SEGMENT_RENDER_FRAME_INVALID',
+      detail: `canonicalChain[${index}].renderFrame has non-finite or invalid values.`,
+    };
+  }
+  const padding = renderFrame.padding;
+  if (padding !== null) {
+    if (
+      !isPlainObject(padding) ||
+      exactKeys(padding, PADDING_KEYS) ||
+      !Number.isFinite(padding.left) ||
+      !Number.isFinite(padding.right) ||
+      !Number.isFinite(padding.top) ||
+      !Number.isFinite(padding.bottom)
+    ) {
+      return {
+        code: 'GEOMETRY_CHAIN_INVALID',
+        reason: 'SEGMENT_RENDER_PADDING_INVALID',
+        detail: `canonicalChain[${index}].renderFrame.padding is malformed.`,
+      };
+    }
+  }
+  const frameShift = renderFrame.frameShift;
+  if (
+    !isPlainObject(frameShift) ||
+    exactKeys(frameShift, FLIP_KEYS) ||
+    !Number.isFinite(frameShift.x) ||
+    !Number.isFinite(frameShift.y)
+  ) {
+    return {
+      code: 'GEOMETRY_CHAIN_INVALID',
+      reason: 'SEGMENT_RENDER_FRAME_SHIFT_INVALID',
+      detail: `canonicalChain[${index}].renderFrame.frameShift is malformed.`,
+    };
+  }
+  if (
+    !isPlainObject(segment.canonicalRenderMatrix) ||
+    !isFiniteAffine(segment.canonicalRenderMatrix as unknown as Affine2D)
+  ) {
+    return {
+      code: 'GEOMETRY_TRANSFORM_INVALID',
+      reason: 'SEGMENT_RENDER_MATRIX_INVALID',
+      detail: `canonicalChain[${index}].canonicalRenderMatrix is not a finite affine map.`,
+    };
+  }
+  return null;
+}
+
+function validateQuad(quad: unknown): boolean {
+  if (!Array.isArray(quad) || quad.length !== 4) return false;
+  return quad.every(
+    (point) =>
+      isPlainObject(point) &&
+      exactKeys(point, POINT_KEYS) === null &&
+      Number.isFinite(point.x) &&
+      Number.isFinite(point.y),
+  );
+}
+
+function isInteractionCandidate(value: unknown): value is NestedInteractionCandidate {
+  return (
+    typeof value === 'string' &&
+    (NESTED_INTERACTION_CANDIDATES as readonly string[]).includes(value)
+  );
+}
+
+function isSafeHitNodeClass(value: unknown): value is SafeHitNodeClass {
+  return (
+    value === null ||
+    (typeof value === 'string' && (SAFE_HIT_NODE_CLASSES as readonly string[]).includes(value))
+  );
+}
+
+const PRE_HIT_CLASSIFICATIONS: readonly string[] = ['target', 'owned-non-chrome-descendant'];
+const POST_CLEAR_HIT_CLASSIFICATIONS: readonly string[] = ['target', 'owned-non-chrome-descendant'];
+const POST_OBSTRUCTED_HIT_CLASSIFICATIONS: readonly string[] = [
+  'selection-chrome',
+  'transform-chrome',
+  'foreign-listening-node',
+  'no-hit',
+];
+
+/**
+ * Validates one purpose-scoped interaction member against the closed union and
+ * consistency rules (ADR 0014 R6). Fingerprints are recomputed: an inconsistent
+ * interaction/record fingerprint fails closed.
+ */
+function validateInteractionV3(
+  interaction: unknown,
+  representationTargetId: string,
+  fingerprintInput: {
+    representationFingerprint: string;
+    chainFingerprint: string;
+    bridgeGeneration: number;
+  },
+  recordFingerprint: unknown,
+): NestedObjectGeometryFailure | null {
+  if (!isPlainObject(interaction)) {
+    return {
+      code: 'HIT_POINT_UNAVAILABLE',
+      reason: 'INTERACTION_MALFORMED',
+      detail: 'The typed interaction record is missing or malformed.',
+    };
+  }
+  const phase = interaction.phase;
+  const purpose = interaction.purpose;
+  const isPre = phase === 'pre-action' && purpose === 'authorize-native-action';
+  const isPost = phase === 'post-action' && purpose === 'observe-authoritative-geometry';
+  if (!isPre && !isPost) {
+    return {
+      code: 'GEOMETRY_REPRESENTATION_UNSUPPORTED',
+      reason: 'INTERACTION_PHASE_PURPOSE_INVALID',
+      detail: 'The interaction phase/purpose combination is not one of the two closed pairs.',
+    };
+  }
+  if (exactKeys(interaction, isPre ? PRE_INTERACTION_KEYS : POST_INTERACTION_KEYS)) {
+    return {
+      code: 'HIT_POINT_UNAVAILABLE',
+      reason: 'INTERACTION_UNKNOWN_FIELD',
+      detail: 'The typed interaction record has missing or unknown fields.',
+    };
+  }
+  if (
+    typeof interaction.targetId !== 'string' ||
+    interaction.targetId !== representationTargetId ||
+    interaction.space !== 'browser-client-css' ||
+    interaction.source !== 'live-konva-hit-v1' ||
+    interaction.safetyInsetCssPx !== NESTED_OBJECT_SAFETY_INSET_CSS_PX ||
+    !isInteractionCandidate(interaction.candidate)
+  ) {
+    return {
+      code: 'HIT_POINT_UNAVAILABLE',
+      reason: 'INTERACTION_TARGET_MISMATCH',
+      detail: 'The typed interaction record does not identify the target in browser-client CSS.',
+    };
+  }
+  if (
+    !isPlainObject(interaction.point) ||
+    !isFinitePoint(interaction.point as unknown as GeometryPoint)
+  ) {
+    return {
+      code: 'HIT_POINT_UNAVAILABLE',
+      reason: 'INTERACTION_POINT_INVALID',
+      detail: 'The typed interaction point is not finite.',
+    };
+  }
+  if (
+    typeof interaction.interactionFingerprint !== 'string' ||
+    interaction.interactionFingerprint.length === 0
+  ) {
+    return {
+      code: 'HIT_POINT_UNAVAILABLE',
+      reason: 'INTERACTION_FINGERPRINT_MISSING',
+      detail: 'The typed interaction fingerprint is not a non-empty string.',
+    };
+  }
+  const declared = interaction as unknown as NestedObjectGeometryInteraction;
+  if (computeInteractionFingerprint(declared) !== interaction.interactionFingerprint) {
+    return {
+      code: 'HIT_POINT_UNAVAILABLE',
+      reason: 'INTERACTION_FINGERPRINT_MISMATCH',
+      detail: 'The declared interaction fingerprint does not match the interaction member.',
+    };
+  }
+  if (typeof recordFingerprint !== 'string' || recordFingerprint.length === 0) {
+    return {
+      code: 'GEOMETRY_REPRESENTATION_UNSUPPORTED',
+      reason: 'RECORD_FINGERPRINT_MISSING',
+      detail: 'The top-level record fingerprint is not a non-empty string.',
+    };
+  }
+  const expectedRecord = computeRecordFingerprint({
+    representationFingerprint: fingerprintInput.representationFingerprint,
+    interactionFingerprint: interaction.interactionFingerprint,
+    phase: declared.phase,
+    purpose: declared.purpose,
+    chainFingerprint: fingerprintInput.chainFingerprint,
+    bridgeGeneration: fingerprintInput.bridgeGeneration,
+  });
+  if (expectedRecord !== recordFingerprint) {
+    return {
+      code: 'GEOMETRY_REPRESENTATION_UNSUPPORTED',
+      reason: 'RECORD_FINGERPRINT_MISMATCH',
+      detail: 'The declared record fingerprint does not match the interaction and representation.',
+    };
+  }
+  if (isPre) {
+    if (
+      interaction.authority !== 'action' ||
+      interaction.status !== 'authorized' ||
+      typeof interaction.hitClassification !== 'string' ||
+      !PRE_HIT_CLASSIFICATIONS.includes(interaction.hitClassification)
+    ) {
+      return {
+        code: 'HIT_POINT_UNAVAILABLE',
+        reason: 'INTERACTION_PRE_CONSISTENCY',
+        detail:
+          'A pre-action interaction must be authorized action authority with a target-owned classification.',
+      };
+    }
+    return null;
+  }
+  if (interaction.authority !== 'none') {
+    return {
+      code: 'HIT_POINT_UNAVAILABLE',
+      reason: 'INTERACTION_POST_AUTHORITY',
+      detail: 'A post-action interaction must carry authority none.',
+    };
+  }
+  if (interaction.status !== 'clear' && interaction.status !== 'obstructed') {
+    return {
+      code: 'HIT_POINT_UNAVAILABLE',
+      reason: 'INTERACTION_POST_STATUS',
+      detail: 'A post-action interaction status must be clear or obstructed.',
+    };
+  }
+  const descriptor = interaction.safeHitDescriptor;
+  if (
+    !isPlainObject(descriptor) ||
+    exactKeys(descriptor, SAFE_HIT_DESCRIPTOR_KEYS) ||
+    !isSafeHitNodeClass(descriptor.nodeClass) ||
+    (descriptor.chromeName !== null && descriptor.chromeName !== SAFE_CHROME_NAME) ||
+    typeof descriptor.ownedByTarget !== 'boolean'
+  ) {
+    return {
+      code: 'HIT_POINT_UNAVAILABLE',
+      reason: 'INTERACTION_POST_DESCRIPTOR',
+      detail: 'A post-action interaction must carry a closed safe hit descriptor.',
+    };
+  }
+  const classification = interaction.hitClassification;
+  if (typeof classification !== 'string') {
+    return {
+      code: 'HIT_POINT_UNAVAILABLE',
+      reason: 'INTERACTION_POST_CLASSIFICATION',
+      detail: 'A post-action interaction must declare a hit classification.',
+    };
+  }
+  if (interaction.status === 'clear') {
+    if (
+      !POST_CLEAR_HIT_CLASSIFICATIONS.includes(classification) ||
+      interaction.obstructionCode !== null
+    ) {
+      return {
+        code: 'HIT_POINT_UNAVAILABLE',
+        reason: 'INTERACTION_POST_CLEAR_CONSISTENCY',
+        detail: 'A clear post-action interaction must be target-owned with no obstruction code.',
+      };
+    }
+    return null;
+  }
+  if (
+    !POST_OBSTRUCTED_HIT_CLASSIFICATIONS.includes(classification) ||
+    interaction.obstructionCode !== 'POST_ACTION_HIT_OBSTRUCTED'
+  ) {
+    return {
+      code: 'HIT_POINT_UNAVAILABLE',
+      reason: 'INTERACTION_POST_OBSTRUCTED_CONSISTENCY',
+      detail:
+        'An obstructed post-action interaction must declare POST_ACTION_HIT_OBSTRUCTED and a non-owned classification.',
+    };
+  }
+  if (classification === 'selection-chrome' && descriptor.chromeName !== SAFE_CHROME_NAME) {
+    return {
+      code: 'HIT_POINT_UNAVAILABLE',
+      reason: 'INTERACTION_POST_CHROME_NAME',
+      detail: 'A selection-chrome obstruction must name the static artwork-chrome ancestor.',
+    };
+  }
+  if (classification === 'no-hit' && descriptor.nodeClass !== null) {
+    return {
+      code: 'HIT_POINT_UNAVAILABLE',
+      reason: 'INTERACTION_POST_NO_HIT_DESCRIPTOR',
+      detail: 'A no-hit obstruction must carry a null node class.',
+    };
+  }
+  return null;
+}
+
+export interface ValidateNestedObjectGeometryExpectations {
+  targetId?: string;
+  witnessId?: string;
+  layoutId?: string;
+  bridgeGeneration?: number;
+  /**
+   * When supplied, the canonical and rendered witness→Layout matrices and their
+   * corresponding quads must agree point-by-point within this tolerance. A
+   * non-false Object flip is only ever accepted through this agreement (R5).
+   */
+  canonicalLiveTolerance?: number;
+}
+
+/**
+ * Validates a geometry-v3 record against the closed schema. Unknown fields,
+ * wrong versions/kinds/units, missing segments, non-finite matrices/points,
+ * malformed ids, and id/ancestry disagreement all fail closed with a precise
+ * code. When canonical-vs-live expectations are supplied, the two independent
+ * witness→Layout compositions must agree on corresponding points.
+ */
+export function validateNestedObjectGeometryV3(
+  value: unknown,
+  expectations: ValidateNestedObjectGeometryExpectations = {},
+): { ok: true } | { ok: false; failure: NestedObjectGeometryFailure } {
+  const asFailure = (failure: NestedObjectGeometryFailure) => ({ ok: false as const, failure });
+  if (!isPlainObject(value)) {
+    return asFailure({
+      code: 'GEOMETRY_REPRESENTATION_UNSUPPORTED',
+      reason: 'GEOMETRY_NOT_OBJECT',
+      detail: 'The geometry-v3 result is not an object.',
+    });
+  }
+  if (exactKeys(value, TOP_LEVEL_KEYS)) {
+    return asFailure({
+      code: 'GEOMETRY_REPRESENTATION_UNSUPPORTED',
+      reason: 'GEOMETRY_UNKNOWN_FIELD',
+      detail: 'The geometry-v3 result has missing or unknown top-level fields.',
+    });
+  }
+  if (value.schemaVersion !== NESTED_OBJECT_GEOMETRY_SCHEMA_VERSION) {
+    return asFailure({
+      code: 'GEOMETRY_REPRESENTATION_UNSUPPORTED',
+      reason: 'SCHEMA_VERSION_UNSUPPORTED',
+      detail: `Geometry schema ${String(value.schemaVersion)} is not ${NESTED_OBJECT_GEOMETRY_SCHEMA_VERSION}.`,
+    });
+  }
+  if (value.discriminant !== NESTED_OBJECT_GEOMETRY_DISCRIMINANT) {
+    return asFailure({
+      code: 'GEOMETRY_REPRESENTATION_UNSUPPORTED',
+      reason: 'DISCRIMINANT_UNSUPPORTED',
+      detail: 'The geometry-v3 discriminant is not supported.',
+    });
+  }
+  const representation = value.representation;
+  if (!isPlainObject(representation) || exactKeys(representation, REPRESENTATION_KEYS)) {
+    return asFailure({
+      code: 'GEOMETRY_REPRESENTATION_UNSUPPORTED',
+      reason: 'REPRESENTATION_MALFORMED',
+      detail: 'The geometry-v3 representation has missing or unknown fields.',
+    });
+  }
+  if (representation.kind !== NESTED_OBJECT_AFFINE_CHAIN_KIND) {
+    return asFailure({
+      code: 'GEOMETRY_REPRESENTATION_UNSUPPORTED',
+      reason: 'REPRESENTATION_KIND_UNSUPPORTED',
+      detail: 'The representation kind is not nested-object-affine-chain-v2.',
+    });
+  }
+  if (representation.representationVersion !== NESTED_OBJECT_REPRESENTATION_VERSION) {
+    return asFailure({
+      code: 'GEOMETRY_REPRESENTATION_UNSUPPORTED',
+      reason: 'REPRESENTATION_VERSION_UNSUPPORTED',
+      detail: `The representation version is ${String(representation.representationVersion)}, not ${NESTED_OBJECT_REPRESENTATION_VERSION}.`,
+    });
+  }
+  if (
+    !Array.isArray(representation.pointOrder) ||
+    representation.pointOrder.join(',') !== NESTED_OBJECT_POINT_ORDER.join(',')
+  ) {
+    return asFailure({
+      code: 'GEOMETRY_REPRESENTATION_UNSUPPORTED',
+      reason: 'POINT_ORDER_UNSUPPORTED',
+      detail: 'The representation point order is not the permanent semantic order.',
+    });
+  }
+  const units = representation.units;
+  if (!isPlainObject(units)) {
+    return asFailure({
+      code: 'GEOMETRY_REPRESENTATION_UNSUPPORTED',
+      reason: 'SPACE_UNIT_UNSUPPORTED',
+      detail: 'The representation declares no space units.',
+    });
+  }
+  for (const [key, unit] of Object.entries(NESTED_OBJECT_SPACE_UNITS)) {
+    if (units[key] !== unit) {
+      return asFailure({
+        code: 'GEOMETRY_REPRESENTATION_UNSUPPORTED',
+        reason: 'SPACE_UNIT_UNSUPPORTED',
+        detail: `Representation unit for ${key} is not ${unit}.`,
+      });
+    }
+  }
+  for (const key of ['targetId', 'witnessId', 'layoutId'] as const) {
+    const id = representation[key];
+    if (typeof id !== 'string' || id.length === 0) {
+      return asFailure({
+        code: 'GEOMETRY_CHAIN_ID_MISMATCH',
+        reason: 'GEOMETRY_ID_INVALID',
+        detail: `representation.${key} is not a non-empty string.`,
+      });
+    }
+    const expected = expectations[`${key}` as 'targetId' | 'witnessId' | 'layoutId'];
+    if (expected !== undefined && expected !== id) {
+      return asFailure({
+        code: 'GEOMETRY_CHAIN_ID_MISMATCH',
+        reason: 'GEOMETRY_ID_MISMATCH',
+        detail: `representation.${key} "${id}" is not the expected "${expected}".`,
+      });
+    }
+  }
+  const chain = representation.canonicalChain;
+  if (!Array.isArray(chain) || chain.length < 3) {
+    return asFailure({
+      code: 'GEOMETRY_CHAIN_INVALID',
+      reason: 'CHAIN_INVALID',
+      detail: 'The canonical chain is missing or too short.',
+    });
+  }
+  for (let index = 0; index < chain.length; index += 1) {
+    const segmentFailure = validateSegment(chain[index], index);
+    if (segmentFailure) return asFailure(segmentFailure);
+    if (
+      index > 0 &&
+      (chain[index - 1] as { parentId: string }).parentId !== (chain[index] as { id: string }).id
+    ) {
+      return asFailure({
+        code: 'GEOMETRY_PARENT_MISMATCH',
+        reason: 'CHAIN_PARENT_MISMATCH',
+        detail: `canonicalChain[${index - 1}].parentId does not name canonicalChain[${index}].id.`,
+      });
+    }
+  }
+  const first = chain[0] as { id: string; kind: string };
+  const last = chain[chain.length - 1] as { id: string; kind: string; parentId: string };
+  if (first.id !== representation.witnessId || first.kind !== 'text') {
+    return asFailure({
+      code: 'GEOMETRY_CHAIN_ID_MISMATCH',
+      reason: 'CHAIN_WITNESS_MISMATCH',
+      detail: 'The chain does not start at the requested Text witness.',
+    });
+  }
+  if (last.id !== representation.targetId || last.kind !== 'object') {
+    return asFailure({
+      code: 'GEOMETRY_CHAIN_ID_MISMATCH',
+      reason: 'CHAIN_TARGET_MISMATCH',
+      detail: 'The chain does not end at the requested Object target.',
+    });
+  }
+  if (last.parentId !== representation.layoutId) {
+    return asFailure({
+      code: 'GEOMETRY_PARENT_MISMATCH',
+      reason: 'CHAIN_LAYOUT_MISMATCH',
+      detail: 'The chain target parent is not the requested Layout.',
+    });
+  }
+  for (const quadKey of [
+    'canonicalWitnessLocalQuad',
+    'persistedWitnessContentQuad',
+    'canonicalLayoutQuad',
+    'renderedLayoutQuad',
+    'renderedWorldSceneQuad',
+    'renderedStageViewportCssQuad',
+    'renderedBrowserClientCssQuad',
+  ] as const) {
+    if (!validateQuad(representation[quadKey])) {
+      return asFailure({
+        code: 'GEOMETRY_TRANSFORM_INVALID',
+        reason: 'QUAD_INVALID',
+        detail: `representation.${quadKey} is not four finite points.`,
+      });
+    }
+  }
+  const targetWrappers = representation.targetWrappers;
+  if (!isPlainObject(targetWrappers) || exactKeys(targetWrappers, WRAPPER_KEYS)) {
+    return asFailure({
+      code: 'GEOMETRY_TRANSFORM_INVALID',
+      reason: 'TARGET_WRAPPERS_INVALID',
+      detail: 'representation.targetWrappers is missing or malformed.',
+    });
+  }
+  if (
+    !isFiniteAffine(targetWrappers.translationWrapperToLayout as unknown as Affine2D) ||
+    !isFiniteAffine(
+      targetWrappers.centerRotationSubtreeToTranslationWrapper as unknown as Affine2D,
+    ) ||
+    !isFiniteAffine(targetWrappers.completeObjectToLayout as unknown as Affine2D) ||
+    typeof targetWrappers.flipShellIdentity !== 'boolean' ||
+    targetWrappers.wrapperStructureValidated !== true
+  ) {
+    return asFailure({
+      code: 'GEOMETRY_TRANSFORM_INVALID',
+      reason: 'TARGET_WRAPPERS_INVALID',
+      detail: 'representation.targetWrappers carries a non-finite or non-conforming fact.',
+    });
+  }
+  const expectedComplete = multiplyAffine(
+    targetWrappers.translationWrapperToLayout as unknown as Affine2D,
+    targetWrappers.centerRotationSubtreeToTranslationWrapper as unknown as Affine2D,
+  );
+  if (
+    !isFiniteAffine(expectedComplete) ||
+    !affineAgreesWithin(
+      targetWrappers.completeObjectToLayout as unknown as Affine2D,
+      expectedComplete,
+      NESTED_OBJECT_CANONICAL_EPSILON,
+    )
+  ) {
+    return asFailure({
+      code: 'GEOMETRY_TRANSFORM_INVALID',
+      reason: 'TARGET_COMPLETE_WRAPPER_MISMATCH',
+      detail:
+        'representation.targetWrappers.completeObjectToLayout is not the translation-wrapper × center-rotation composition.',
+    });
+  }
+  if (targetWrappers.flipShellIdentity !== true) {
+    return asFailure({
+      code: 'GEOMETRY_TRANSFORM_INVALID',
+      reason: 'TARGET_FLIP_SHELL_NOT_IDENTITY',
+      detail:
+        'The intermediate Object flip/content shell must be identity for the false-flip fixture.',
+    });
+  }
+  const targetSegmentForWrappers = chain[chain.length - 1] as unknown as CanonicalChainSegmentV2;
+  const expectedCenterWrapper = expectedCenterRotationMatrix(
+    targetSegmentForWrappers.persistedFrame,
+  );
+  if (
+    expectedCenterWrapper === null ||
+    !affineAgreesWithin(
+      targetWrappers.centerRotationSubtreeToTranslationWrapper as unknown as Affine2D,
+      expectedCenterWrapper,
+      NESTED_OBJECT_CANONICAL_EPSILON,
+    )
+  ) {
+    return asFailure({
+      code: 'GEOMETRY_TRANSFORM_INVALID',
+      reason: 'TARGET_CENTER_WRAPPER_MISMATCH',
+      detail:
+        'The live target center-rotation wrapper does not match the canonical target frame rotation.',
+    });
+  }
+  const matrices = representation.matrices;
+  if (!isPlainObject(matrices) || exactKeys(matrices, MATRIX_KEYS)) {
+    return asFailure({
+      code: 'GEOMETRY_TRANSFORM_INVALID',
+      reason: 'MATRIX_INVALID',
+      detail: 'The representation matrices are missing or malformed.',
+    });
+  }
+  for (const key of MATRIX_KEYS) {
+    if (!isFiniteAffine(matrices[key] as unknown as Affine2D)) {
+      return asFailure({
+        code: 'GEOMETRY_TRANSFORM_INVALID',
+        reason: 'MATRIX_INVALID',
+        detail: `representation.matrices.${key} is not a finite affine map.`,
+      });
+    }
+  }
+  const camera = value.camera;
+  if (!isPlainObject(camera) || exactKeys(camera, CAMERA_KEYS)) {
+    return asFailure({
+      code: 'GEOMETRY_CAMERA_MISMATCH',
+      reason: 'CAMERA_MALFORMED',
+      detail: 'The camera facts are missing or malformed.',
+    });
+  }
+  const canonicalCamera = camera.canonical;
+  if (
+    !isPlainObject(canonicalCamera) ||
+    !Number.isFinite(canonicalCamera.x) ||
+    !Number.isFinite(canonicalCamera.y) ||
+    !Number.isFinite(canonicalCamera.zoom)
+  ) {
+    return asFailure({
+      code: 'GEOMETRY_CAMERA_MISMATCH',
+      reason: 'CAMERA_INVALID',
+      detail: 'The canonical camera facts are not finite.',
+    });
+  }
+  if (!isFiniteAffine(camera.stageMatrix as unknown as Affine2D)) {
+    return asFailure({
+      code: 'GEOMETRY_CAMERA_MISMATCH',
+      reason: 'CAMERA_STAGE_INVALID',
+      detail: 'The live Stage matrix is not a finite affine map.',
+    });
+  }
+  const ratios = camera.cssRatios;
+  if (
+    !isPlainObject(ratios) ||
+    !Number.isFinite(ratios.x) ||
+    !Number.isFinite(ratios.y) ||
+    (ratios.x as number) <= 0 ||
+    (ratios.y as number) <= 0
+  ) {
+    return asFailure({
+      code: 'GEOMETRY_CAMERA_MISMATCH',
+      reason: 'CSS_RATIO_INVALID',
+      detail: 'The measured CSS ratios are not finite and positive.',
+    });
+  }
+  const provenance = value.typedProvenance;
+  if (!isPlainObject(provenance) || exactKeys(provenance, PROVENANCE_KEYS)) {
+    return asFailure({
+      code: 'GEOMETRY_TRANSFORM_INVALID',
+      reason: 'PROVENANCE_MALFORMED',
+      detail: 'The typed provenance is missing or malformed.',
+    });
+  }
+  if (!Number.isFinite(provenance.bridgeGeneration)) {
+    return asFailure({
+      code: 'GEOMETRY_TRANSFORM_INVALID',
+      reason: 'PROVENANCE_GENERATION_INVALID',
+      detail: 'The typed provenance bridge generation is not finite.',
+    });
+  }
+  if (
+    expectations.bridgeGeneration !== undefined &&
+    provenance.bridgeGeneration !== expectations.bridgeGeneration
+  ) {
+    return asFailure({
+      code: 'GEOMETRY_TRANSFORM_INVALID',
+      reason: 'PROVENANCE_GENERATION_MISMATCH',
+      detail: 'The typed provenance generation is not the expected generation.',
+    });
+  }
+  for (const nodeKey of ['target', 'witness', 'layout'] as const) {
+    const node = provenance[nodeKey];
+    if (
+      !isPlainObject(node) ||
+      exactKeys(node, NODE_KEYS) ||
+      typeof node.id !== 'string' ||
+      typeof node.konvaId !== 'string' ||
+      typeof node.fingerprint !== 'string' ||
+      node.fingerprint.length === 0
+    ) {
+      return asFailure({
+        code: 'GEOMETRY_TRANSFORM_INVALID',
+        reason: 'PROVENANCE_NODE_INVALID',
+        detail: `typedProvenance.${nodeKey} is malformed.`,
+      });
+    }
+  }
+  for (const key of [
+    'chainFingerprint',
+    'representationFingerprint',
+    'stageFingerprint',
+  ] as const) {
+    if (typeof provenance[key] !== 'string' || provenance[key].length === 0) {
+      return asFailure({
+        code: 'GEOMETRY_TRANSFORM_INVALID',
+        reason: 'PROVENANCE_FINGERPRINT_MISSING',
+        detail: `typedProvenance.${key} is not a non-empty fingerprint.`,
+      });
+    }
+  }
+  if (
+    typeof representation.representationFingerprint !== 'string' ||
+    representation.representationFingerprint !== provenance.representationFingerprint
+  ) {
+    return asFailure({
+      code: 'GEOMETRY_TRANSFORM_INVALID',
+      reason: 'REPRESENTATION_FINGERPRINT_MISMATCH',
+      detail: 'The representation and provenance fingerprints disagree.',
+    });
+  }
+  if (
+    typeof value.chainFingerprint !== 'string' ||
+    value.chainFingerprint !== provenance.chainFingerprint
+  ) {
+    return asFailure({
+      code: 'GEOMETRY_CHAIN_INVALID',
+      reason: 'CHAIN_FINGERPRINT_MISMATCH',
+      detail: 'The top-level and provenance chain fingerprints disagree.',
+    });
+  }
+  const normalization = value.normalization;
+  if (
+    !isPlainObject(normalization) ||
+    exactKeys(normalization, NORMALIZATION_KEYS) ||
+    typeof normalization.certificateVersion !== 'string' ||
+    typeof normalization.fixedPoint !== 'boolean' ||
+    typeof normalization.referentiallyUnchanged !== 'boolean' ||
+    typeof normalization.subtreeFingerprint !== 'string' ||
+    normalization.subtreeFingerprint.length === 0
+  ) {
+    return asFailure({
+      code: 'GEOMETRY_TRANSFORM_INVALID',
+      reason: 'NORMALIZATION_FACTS_INVALID',
+      detail: 'The geometry-v3 normalization facts are missing or malformed.',
+    });
+  }
+  const interactionFailure = validateInteractionV3(
+    value.interaction,
+    representation.targetId as string,
+    {
+      representationFingerprint: representation.representationFingerprint as string,
+      chainFingerprint: provenance.chainFingerprint as string,
+      bridgeGeneration: provenance.bridgeGeneration as number,
+    },
+    value.recordFingerprint,
+  );
+  if (interactionFailure) return asFailure(interactionFailure);
+
+  const tolerance = expectations.canonicalLiveTolerance;
+  if (tolerance !== undefined) {
+    const canonicalMatrix = matrices.canonicalWitnessToLayout as unknown as Affine2D;
+    const renderedMatrix = matrices.renderedWitnessToLayout as unknown as Affine2D;
+    if (!affineAgreesWithin(canonicalMatrix, renderedMatrix, tolerance)) {
+      return asFailure({
+        code: 'GEOMETRY_TRANSFORM_INVALID',
+        reason: 'CANONICAL_RENDERED_MATRIX_MISMATCH',
+        detail: 'The canonical and live rendered witness-to-Layout matrices disagree.',
+      });
+    }
+    const witnessQuad = representation.canonicalWitnessLocalQuad as unknown as Quad;
+    const livePoints = transformQuad(renderedMatrix, witnessQuad);
+    const canonicalPoints = transformQuad(canonicalMatrix, witnessQuad);
+    for (let index = 0; index < 4; index += 1) {
+      if (
+        Math.abs(livePoints[index].x - canonicalPoints[index].x) > tolerance ||
+        Math.abs(livePoints[index].y - canonicalPoints[index].y) > tolerance
+      ) {
+        return asFailure({
+          code: 'GEOMETRY_TRANSFORM_INVALID',
+          reason: 'CANONICAL_RENDERED_POINT_MISMATCH',
+          detail: 'Canonical and live corresponding witness points disagree.',
+        });
+      }
+    }
+  }
+  return { ok: true };
+}
+
+/** Validates the pair-explicit typed geometry request (R4); fails closed. */
+export function validateNestedObjectGeometryRequest(
+  request: unknown,
+):
+  | { ok: true; typed: NestedObjectGeometryTypedRequest }
+  | { ok: false; failure: NestedObjectGeometryFailure } {
+  if (!isPlainObject(request)) {
+    return {
+      ok: false,
+      failure: {
+        code: 'GEOMETRY_REPRESENTATION_UNSUPPORTED',
+        reason: 'REQUEST_NOT_OBJECT',
+        detail: 'The typed geometry request must be an object.',
+      },
+    };
+  }
+  if (
+    exactKeys(request, [
+      'schemaVersion',
+      'representation',
+      'targetId',
+      'witnessId',
+      'layoutId',
+      'interaction',
+    ])
+  ) {
+    return {
+      ok: false,
+      failure: {
+        code: 'GEOMETRY_REPRESENTATION_UNSUPPORTED',
+        reason: 'REQUEST_UNKNOWN_FIELD',
+        detail: 'The typed geometry request has missing or unknown fields.',
+      },
+    };
+  }
+  if (request.schemaVersion !== NESTED_OBJECT_REQUEST_SCHEMA_VERSION) {
+    return {
+      ok: false,
+      failure: {
+        code: 'GEOMETRY_REPRESENTATION_UNSUPPORTED',
+        reason: 'REQUEST_VERSION_UNSUPPORTED',
+        detail: 'The typed geometry request schema version is not supported.',
+      },
+    };
+  }
+  if (request.representation !== NESTED_OBJECT_AFFINE_CHAIN_KIND) {
+    return {
+      ok: false,
+      failure: {
+        code: 'GEOMETRY_REPRESENTATION_UNSUPPORTED',
+        reason: 'REQUEST_REPRESENTATION_UNSUPPORTED',
+        detail: 'The typed geometry request representation is not supported.',
+      },
+    };
+  }
+  if (!isPlainObject(request.interaction) || exactKeys(request.interaction, ['phase', 'purpose'])) {
+    return {
+      ok: false,
+      failure: {
+        code: 'GEOMETRY_REPRESENTATION_UNSUPPORTED',
+        reason: 'REQUEST_INTERACTION_MISSING',
+        detail: 'The typed geometry request must carry an exact phase/purpose interaction context.',
+      },
+    };
+  }
+  const phase = request.interaction.phase;
+  const purpose = request.interaction.purpose;
+  const preAction = phase === 'pre-action' && purpose === 'authorize-native-action';
+  const postAction = phase === 'post-action' && purpose === 'observe-authoritative-geometry';
+  if (!preAction && !postAction) {
+    return {
+      ok: false,
+      failure: {
+        code: 'GEOMETRY_REPRESENTATION_UNSUPPORTED',
+        reason: 'REQUEST_INTERACTION_UNSUPPORTED',
+        detail: 'The typed geometry request phase/purpose is not one of the two closed pairs.',
+      },
+    };
+  }
+  if (
+    typeof request.targetId !== 'string' ||
+    request.targetId.trim().length === 0 ||
+    typeof request.witnessId !== 'string' ||
+    request.witnessId.trim().length === 0 ||
+    typeof request.layoutId !== 'string' ||
+    request.layoutId.trim().length === 0
+  ) {
+    return {
+      ok: false,
+      failure: {
+        code: 'GEOMETRY_CHAIN_ID_MISMATCH',
+        reason: 'REQUEST_ID_INVALID',
+        detail: 'request ids must be non-empty strings.',
+      },
+    };
+  }
+  const targetId = request.targetId;
+  const witnessId = request.witnessId;
+  const layoutId = request.layoutId;
+  if (targetId === witnessId || targetId === layoutId || witnessId === layoutId) {
+    return {
+      ok: false,
+      failure: {
+        code: 'GEOMETRY_CHAIN_ID_MISMATCH',
+        reason: 'REQUEST_ID_CONFLICT',
+        detail: 'Request ids must be distinct.',
+      },
+    };
+  }
+  return {
+    ok: true,
+    typed: {
+      schemaVersion: NESTED_OBJECT_REQUEST_SCHEMA_VERSION,
+      representation: NESTED_OBJECT_AFFINE_CHAIN_KIND,
+      targetId,
+      witnessId,
+      layoutId,
+      interaction: preAction
+        ? { phase: 'pre-action', purpose: 'authorize-native-action' }
+        : { phase: 'post-action', purpose: 'observe-authoritative-geometry' },
+    },
+  };
+}
+
+/** Applies a canonical witness-local quad through the canonical chain. */
+export function canonicalWitnessLayoutPoint(
+  chain: readonly NestedObjectFrameFacts[],
+  layoutId: string,
+  point: GeometryPoint,
+): GeometryPoint | null {
+  const composed = composeCanonicalChain(chain, layoutId);
+  if ('failure' in composed) return null;
+  return applyAffine(composed.witnessToLayout, point);
+}
