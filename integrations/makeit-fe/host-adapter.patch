+    expect(getTextLayerFramePadding(topAligned(circleLayer())).left).toBeGreaterThan(baseline);
+  });
+
+  it('keeps the warp fingerprint stable across effects-only padding changes', () => {
+    const shadowLayers = [
+      withShadow('drop', { offset: 18, angle: 45 }),
+      withShadow('block', { outlineWidth: 6 }),
+      withShadow('outline', { outlineWidth: 6 }),
