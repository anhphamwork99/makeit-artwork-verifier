+++ b/scripts/artwork-verifier-package.mjs
@@ -0,0 +1,43 @@
+import { accessSync, constants, readFileSync } from 'node:fs';
+import { createRequire } from 'node:module';
+import { dirname, join } from 'node:path';
+
+const requireFromHost = createRequire(import.meta.url);
+
+export function resolveArtworkVerifierPackage() {
+  let packageJsonPath;
+  try {
+    packageJsonPath = requireFromHost.resolve('makeit-artwork-verifier/package.json');
+  } catch {
+    throw new Error(
+      'the `makeit-artwork-verifier` package is unavailable; run `pnpm install --frozen-lockfile` in this frontend checkout.',
+    );
+  }
+
+  const packageRoot = dirname(packageJsonPath);
+  const manifest = JSON.parse(readFileSync(packageJsonPath, 'utf8'));
+  const entrypoint = join(packageRoot, 'bin', 'verify-artwork.mjs');
+  accessSync(entrypoint, constants.R_OK);
+
+  return {
+    packageJsonPath,
+    packageRoot,
+    entrypoint,
+    name: manifest.name,
+    version: manifest.version,
+    identity: `${manifest.name}@${manifest.version}`,
+  };
+}
+
+export function resolvePlaywrightCli(packageJsonPath) {
+  const requireFromToolkit = createRequire(packageJsonPath);
+  const testPackageJson = requireFromToolkit.resolve('@playwright/test/package.json');
+  const requireFromPlaywrightTest = createRequire(testPackageJson);
+  const playwrightPackageJson = requireFromPlaywrightTest.resolve('playwright/package.json');
+  const manifest = JSON.parse(readFileSync(playwrightPackageJson, 'utf8'));
+  const bin = typeof manifest.bin === 'string' ? manifest.bin : manifest.bin?.playwright;
+  if (typeof bin !== 'string' || bin.length === 0) {
+    throw new Error('the installed Playwright package does not expose its CLI.');
+  }
+  return join(dirname(playwrightPackageJson), bin);
+}
