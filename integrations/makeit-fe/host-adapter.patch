+    expect(relative).toEqual({ a: 1, b: 0, c: 0, d: 1, e: 30, f: 40 });
+    expect(node.getAbsoluteTransform).toHaveBeenCalledWith(ancestor);
+    // Reading a node relative to itself is the identity, never a throw.
+    expect(readRelativeAffine(node, node)).toEqual({ a: 1, b: 0, c: 0, d: 1, e: 0, f: 0 });
+  });
+
