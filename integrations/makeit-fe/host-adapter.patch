+
+export interface ArtworkVerificationSelector {
+  id?: string;
+  kind?: ArtworkVerificationKind;
+  name?: string;
+  parentId?: string | null;
+  mounted?: boolean;
+  selected?: boolean;
+}
+
+export interface ArtworkVerificationPoint {
+  x: number;
+  y: number;
+}
+
+export interface ArtworkVerificationRect extends ArtworkVerificationPoint {
+  width: number;
+  height: number;
+}
+
+/**
+ * Typed, read-only renderer provenance for one resolved target (bridge v4).
+ *
+ * This is the explicit renderer source an Oracle reads for the ordinary
+ * `geometry.delta` decision: the live Konva node identity and its finite live
+ * node-transform position. It replaces semantic parsing of the opaque
+ * `targetFingerprint`, which remains an equality/currentness fact only (R7,
+ * R11). The position is the node transform (decoration-independent), never the
+ * selection-chrome-including bounding rect.
+ */
+export interface ArtworkVerificationRendererTargetProvenance {
+  /** Live Konva node id; equals the semantic element id for non-FRAME nodes. */
+  id: string;
+  nodeClass: string;
+  /** Finite live node-transform position; never the AABB rect. */
+  x: number;
+  y: number;
+}
+
+/**
+ * Deterministic, serializable renderer provenance for one resolved target. The
+ * geometry representation consumed by the Oracle is fingerprinted here, so a
+ * coherent capture can prove its renderer source did not change between anchors
+ * even when authoritative store state is unchanged.
+ */
+export interface ArtworkVerificationRendererProvenance {
+  bridgeGeneration: number;
+  stageFingerprint: string;
+  targetFingerprint: string;
+  /** Typed live target provenance, or `null` when it cannot be read. */
+  target: ArtworkVerificationRendererTargetProvenance | null;
+}
+
+export interface ArtworkVerificationTargetRendererFacts {
+  id: string;
+  fingerprint: string;
+  mounted: boolean;
+  visible: boolean;
+  listening: boolean;
+}
+
+export interface ArtworkVerificationRendererFingerprint {
+  bridgeGeneration: number;
+  stageFingerprint: string;
+  targets: readonly ArtworkVerificationTargetRendererFacts[];
+}
+
+export interface ArtworkVerificationGeometry {
+  observation: ArtworkVerificationObservationCursor;
+  id: string;
+  konvaId: string;
+  mounted: boolean;
+  reason?: 'culled-or-not-rendered';
+  sceneRect?: ArtworkVerificationRect;
+  stageRect?: ArtworkVerificationRect;
+  viewportRect?: ArtworkVerificationRect;
+  hitPoint?: ArtworkVerificationPoint;
+  visible?: boolean;
+  listening?: boolean;
+  renderer: ArtworkVerificationRendererProvenance;
+  /**
+   * Typed geometry schema v2 (bridge v4). Present only for the circle-warped
+   * Text representation this slice authorizes; absent for every other target so
+   * the ordinary-Text 5-A contract is unchanged.
+   */
+  geometryV2?: ArtworkVerificationGeometryV2;
+  /**
+   * Typed geometry schema v3 (bridge v6). Present only for a pair-explicit
+   * nested-object typed request; `geometry(id)` never publishes it, and the
+   * bridge never guesses a witness.
+   */
+  geometryV3?: NestedObjectGeometryV3;
+  /**
+   * Structured, non-throwing failure for a typed geometry-v3 request. Present
+   * only when `geometry(request)` received a typed request that could not be
+   * satisfied; the generic `geometry(id)` path never sets it.
+   */
+  geometryV3Failure?: NestedObjectGeometryFailure;
+}
+
+/**
+ * Pair-explicit typed geometry request (bridge v6, ADR 0013 R4). A bare string
+ * preserves the generic geometry and circle geometry-v2 behaviour; a typed
+ * request is mandatory for geometry schema v3, and the witness/Layout can never
+ * be inferred.
+ */
+export type ArtworkGeometryRequest =
+  | string
+  | {
+      schemaVersion: 1;
+      representation: typeof NESTED_OBJECT_AFFINE_CHAIN_KIND;
+      targetId: string;
+      witnessId: string;
+      layoutId: string;
+      /** Closed phase/purpose pair; never inferred from product state. */
+      interaction: NestedObjectInteractionContext;
+    };
+
+/**
+ * Stable document/currentness identity, scoped to the browser Document and the
+ * product route document it observes — never to a bridge or Stage mount.
+ *
+ * `documentId` addresses the pair (browser Document, product route document):
+ * it is identical for every bridge installation that runs in the same browser
+ * Document at the same route address, and it changes when the route addresses a
+ * different product document (for example `/artwork/editor/<id>` for another id).
+ * Hydrating content into the current route document is not a document change, so
+ * `documentId` does not change on hydrate.
