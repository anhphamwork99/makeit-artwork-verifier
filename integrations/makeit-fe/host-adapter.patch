+
+export interface CanonicalImageAuthorityDecision {
+  status: Extract<
+    ArtworkVerificationRasterV2Status,
+    'not-applicable' | 'pending' | 'failed' | 'ready'
+  >;
+  reason: ArtworkVerificationRasterV2Reason | null;
