+        kind: 'text',
+        parentId: 'layout-1',
+        mounted: true,
+        selected: true,
+      }),
+    ]);
+  });
+
+  it('reports persisted but culled elements as unmounted', () => {
+    const result = filterArtworkVerificationElements(nodes, new Set(['layout-1']), [], [], {
+      id: 'text-1',
